datasource db {
  provider = "postgresql"

}

generator client {
  provider = "prisma-client-js"
}


// 👤 Users and profiles

model Worker {
  id           String         @id @default(uuid())
  tgId         String         @unique
  fullName     String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  specializations WorkerSpecialization[]
  responses    Response[]

  @@map("taisia_demidova_worker")
}

model WorkerSpecialization {
  id                String         @id @default(uuid())
  workerId          String
  role              String         
  yearsOfExperience Float          
  grade             String         @default("JUNIOR") 

  worker            Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skills            WorkerSkill[]  
  portfolio         PortfolioCase[]

  @@unique([workerId, role])       
  @@map("taisia_demidova_worker_specialization")
}

model WorkerSkill {
  id               String               @id @default(uuid())
  specializationId String
  skillName        String               // "NestJS", "React", "Figma"
  
  specialization   WorkerSpecialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@map("taisia_demidova_worker_skill")
}

model PortfolioCase {
  id               String               @id @default(uuid())
  specializationId String
  title            String
  technical_description      String 
  client_description      String 
  skills           String[]   
  isCommercial     Boolean              
  coverUrl         String?
  projectUrl       String?
  createdAt        DateTime             @default(now())
  
  specialization   WorkerSpecialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  responses        Response[] 
  
  @@map("taisia_demidova_portfolio_case")
}


// 🛒 Orders and teams

model Order {
  id            String      @id @default(uuid())
  clientId      String?
  title         String
  specification String      
  stack         String[]   
  gradeRequired String      
  totalPriceRub Int
  role          String[]
  status        String?      @default("DRAFT") // DRAFT, SEARCHING, IN_WORK, COMPLETED, CANCELLED
  createdAt     DateTime?    @default(now())
  updatedAt     DateTime?    @updatedAt
  
  responses     Response[]
  teams         Team[]
  milestones    Milestone[]
  messages      Message[]
  taskChanges   TaskChange[]

  @@map("taisia_demidova_order")
}

model Response {
  id          String   @id @default(uuid())
  orderId     String
  workerId    String
  portfolioCaseId String?
  daysTerm    Int      
  vectorScore Float    
  aiScore     Float?   
  createdAt   DateTime @default(now())
  status      String  @default("INVITED") 
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  portfolioCase   PortfolioCase? @relation(fields: [portfolioCaseId], references: [id], onDelete: SetNull)

  @@map("taisia_demidova_response")
}

model Team {
  id        String   @id @default(uuid())
  orderId   String
  chatLink  String   
  createdAt DateTime @default(now())
  
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}



// 🛠️ Working process and control

model Milestone {
  id          String    @id @default(uuid())
  orderId     String
  title       String    
  status      String    @default("PENDING") // PENDING, IN_WORK, SUBMITTED, COMPLETED
  deadlineAt  DateTime
  completedAt DateTime?
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  sender    String   // CUSTOMER, WORKER, SYSTEM
  text      String
  fileUrl   String?
  createdAt DateTime @default(now())
  
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model TaskChange {
  id          String    @id @default(uuid())
  orderId     String
  description String
  priceRub    Int       @default(0) 
  isPaid      Boolean   @default(false)
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime  @default(now())
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


// Integration with AI

model InterviewSession {
  id        String             @id @default(uuid())
  clientId  String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  InterviewMessage[]
}

model InterviewMessage {
  id           String           @id @default(uuid())
  sessionId    String
  role         String           
  content      String           
  aiJsonFields Json?            
  createdAt    DateTime         @default(now())

  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
