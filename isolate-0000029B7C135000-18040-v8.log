script-source,2456,node:internal/crypto/mac,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayFrom\x2C\x0d\n  SafeSet\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  HmacJob\x2C\x0d\n  KeyObjectHandle\x2C\x0d\n  kCryptoJobAsync\x2C\x0d\n  kSignJobModeSign\x2C\x0d\n  kSignJobModeVerify\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst {\x0d\n  getBlockSize\x2C\x0d\n  hasAnyNotIn\x2C\x0d\n  jobPromise\x2C\x0d\n  normalizeHashName\x2C\x0d\n  validateBitLength\x2C\x0d\n  validateKeyOps\x2C\x0d\n  kHandle\x2C\x0d\n  kKeyObject\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  lazyDOMException\x2C\x0d\n  promisify\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  generateKey: _generateKey\x2C\x0d\n} = require('internal/crypto/keygen');\x0d\n\x0d\nconst {\x0d\n  InternalCryptoKey\x2C\x0d\n  SecretKeyObject\x2C\x0d\n  createSecretKey\x2C\x0d\n} = require('internal/crypto/keys');\x0d\n\x0d\nconst generateKey = promisify(_generateKey);\x0d\n\x0d\nasync function hmacGenerateKey(algorithm\x2C extractable\x2C keyUsages) {\x0d\n  const { hash\x2C name } = algorithm;\x0d\n  let { length } = algorithm;\x0d\n\x0d\n  if (length === undefined)\x0d\n    length = getBlockSize(hash.name);\x0d\n\x0d\n  validateBitLength(length\x2C 'algorithm.length'\x2C true);\x0d\n\x0d\n  const usageSet = new SafeSet(keyUsages);\x0d\n  if (hasAnyNotIn(usageSet\x2C ['sign'\x2C 'verify'])) {\x0d\n    throw lazyDOMException(\x0d\n      'Unsupported key usage for an HMAC key'\x2C\x0d\n      'SyntaxError');\x0d\n  }\x0d\n\x0d\n  const key = await generateKey('hmac'\x2C { length }).catch((err) => {\x0d\n    throw lazyDOMException(\x0d\n      'The operation failed for an operation-specific reason'\x2C\x0d\n      { name: 'OperationError'\x2C cause: err });\x0d\n  });\x0d\n\x0d\n  return new InternalCryptoKey(\x0d\n    key\x2C\x0d\n    { name\x2C length\x2C hash: { name: hash.name } }\x2C\x0d\n    ArrayFrom(usageSet)\x2C\x0d\n    extractable);\x0d\n}\x0d\n\x0d\nfunction getAlgorithmName(hash) {\x0d\n  switch (hash) {\x0d\n    case 'SHA-1': // Fall through\x0d\n    case 'SHA-256': // Fall through\x0d\n    case 'SHA-384': // Fall through\x0d\n    case 'SHA-512': // Fall through\x0d\n      return `HS${hash.slice(4)}`;\x0d\n    default:\x0d\n      throw lazyDOMException('Unsupported digest algorithm'\x2C 'DataError');\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction hmacImportKey(\x0d\n  format\x2C\x0d\n  keyData\x2C\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  const usagesSet = new SafeSet(keyUsages);\x0d\n  if (hasAnyNotIn(usagesSet\x2C ['sign'\x2C 'verify'])) {\x0d\n    throw lazyDOMException(\x0d\n      'Unsupported key usage for an HMAC key'\x2C\x0d\n      'SyntaxError');\x0d\n  }\x0d\n  let keyObject;\x0d\n  switch (format) {\x0d\n    case 'KeyObject': {\x0d\n      const checkLength = keyData.symmetricKeySize * 8;\x0d\n\x0d\n      if (checkLength === 0 || algorithm.length === 0)\x0d\n        throw lazyDOMException('Zero-length key is not supported'\x2C 'DataError');\x0d\n\x0d\n      // The Web Crypto spec allows for key lengths that are not multiples of\x0d\n      // 8. We don't. Our check here is stricter than that defined by the spec\x0d\n      // in that we require that algorithm.length match keyData.length * 8 if\x0d\n      // algorithm.length is specified.\x0d\n      if (algorithm.length !== undefined &&\x0d\n          algorithm.length !== checkLength) {\x0d\n        throw lazyDOMException('Invalid key length'\x2C 'DataError');\x0d\n      }\x0d\n\x0d\n      keyObject = keyData;\x0d\n      break;\x0d\n    }\x0d\n    case 'raw': {\x0d\n      const checkLength = keyData.byteLength * 8;\x0d\n\x0d\n      if (checkLength === 0 || algorithm.length === 0)\x0d\n        throw lazyDOMException('Zero-length key is not supported'\x2C 'DataError');\x0d\n\x0d\n      // The Web Crypto spec allows for key lengths that are not multiples of\x0d\n      // 8. We don't. Our check here is stricter than that defined by the spec\x0d\n      // in that we require that algorithm.length match keyData.length * 8 if\x0d\n      // algorithm.length is specified.\x0d\n      if (algorithm.length !== undefined &&\x0d\n          algorithm.length !== checkLength) {\x0d\n        throw lazyDOMException('Invalid key length'\x2C 'DataError');\x0d\n      }\x0d\n\x0d\n      keyObject = createSecretKey(keyData);\x0d\n      break;\x0d\n    }\x0d\n    case 'jwk': {\x0d\n      if (!keyData.kty)\x0d\n        throw lazyDOMException('Invalid keyData'\x2C 'DataError');\x0d\n\x0d\n      if (keyData.kty !== 'oct')\x0d\n        throw lazyDOMException('Invalid JWK "kty" Parameter'\x2C 'DataError');\x0d\n\x0d\n      if (usagesSet.size > 0 &&\x0d\n          keyData.use !== undefined &&\x0d\n          keyData.use !== 'sig') {\x0d\n        throw lazyDOMException('Invalid JWK "use" Parameter'\x2C 'DataError');\x0d\n      }\x0d\n\x0d\n      validateKeyOps(keyData.key_ops\x2C usagesSet);\x0d\n\x0d\n      if (keyData.ext !== undefined &&\x0d\n          keyData.ext === false &&\x0d\n          extractable === true) {\x0d\n        throw lazyDOMException(\x0d\n          'JWK "ext" Parameter and extractable mismatch'\x2C\x0d\n          'DataError');\x0d\n      }\x0d\n\x0d\n      if (keyData.alg !== undefined) {\x0d\n        if (keyData.alg !== getAlgorithmName(algorithm.hash.name))\x0d\n          throw lazyDOMException(\x0d\n            'JWK "alg" does not match the requested algorithm'\x2C\x0d\n            'DataError');\x0d\n      }\x0d\n\x0d\n      const handle = new KeyObjectHandle();\x0d\n      try {\x0d\n        handle.initJwk(keyData);\x0d\n      } catch (err) {\x0d\n        throw lazyDOMException(\x0d\n          'Invalid keyData'\x2C { name: 'DataError'\x2C cause: err });\x0d\n      }\x0d\n      keyObject = new SecretKeyObject(handle);\x0d\n      break;\x0d\n    }\x0d\n    default:\x0d\n      throw lazyDOMException(`Unable to import HMAC key with format ${format}`);\x0d\n  }\x0d\n\x0d\n  const { length } = keyObject[kHandle].keyDetail({});\x0d\n\x0d\n  return new InternalCryptoKey(\x0d\n    keyObject\x2C {\x0d\n      name: 'HMAC'\x2C\x0d\n      hash: algorithm.hash\x2C\x0d\n      length\x2C\x0d\n    }\x2C\x0d\n    keyUsages\x2C\x0d\n    extractable);\x0d\n}\x0d\n\x0d\nfunction hmacSignVerify(key\x2C data\x2C algorithm\x2C signature) {\x0d\n  const mode = signature === undefined ? kSignJobModeSign : kSignJobModeVerify;\x0d\n  return jobPromise(() => new HmacJob(\x0d\n    kCryptoJobAsync\x2C\x0d\n    mode\x2C\x0d\n    normalizeHashName(key.algorithm.hash.name)\x2C\x0d\n    key[kKeyObject][kHandle]\x2C\x0d\n    data\x2C\x0d\n    signature));\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  hmacImportKey\x2C\x0d\n  hmacGenerateKey\x2C\x0d\n  hmacSignVerify\x2C\x0d\n};\x0d\n
