script-source,774,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/router/router-explorer.js,import { pathToRegexp } from 'path-to-regexp';\nimport { UnknownRequestMappingException } from '../errors/exceptions/unknown-request-mapping.exception.js';\nimport { GuardsConsumer\x2C GuardsContextCreator } from '../guards/index.js';\nimport { ContextIdFactory } from '../helpers/context-id-factory.js';\nimport { ExecutionContextHost } from '../helpers/execution-context-host.js';\nimport { ROUTE_MAPPED_MESSAGE\x2C VERSIONED_ROUTE_MAPPED_MESSAGE\x2C } from '../helpers/messages.js';\nimport { RouterMethodFactory } from '../helpers/router-method-factory.js';\nimport { STATIC_CONTEXT } from '../injector/constants.js';\nimport { InterceptorsConsumer\x2C InterceptorsContextCreator\x2C } from '../interceptors/index.js';\nimport { PipesConsumer\x2C PipesContextCreator } from '../pipes/index.js';\nimport { PathsExplorer } from './paths-explorer.js';\nimport { REQUEST_CONTEXT_ID } from './request/request-constants.js';\nimport { RouteParamsFactory } from './route-params-factory.js';\nimport { RouterExecutionContext } from './router-execution-context.js';\nimport { PATH_METADATA\x2C addLeadingSlash\x2C isUndefined\x2C } from '@nestjs/common/internal';\nimport { RequestMethod\x2C VersioningType\x2C InternalServerErrorException\x2C Logger\x2C } from '@nestjs/common';\nexport class RouterExplorer {\n    container;\n    injector;\n    routerProxy;\n    exceptionsFilter;\n    routePathFactory;\n    graphInspector;\n    executionContextCreator;\n    pathsExplorer;\n    routerMethodFactory = new RouterMethodFactory();\n    logger = new Logger(RouterExplorer.name\x2C {\n        timestamp: true\x2C\n    });\n    exceptionFiltersCache = new WeakMap();\n    constructor(metadataScanner\x2C container\x2C injector\x2C routerProxy\x2C exceptionsFilter\x2C config\x2C routePathFactory\x2C graphInspector) {\n        this.container = container;\n        this.injector = injector;\n        this.routerProxy = routerProxy;\n        this.exceptionsFilter = exceptionsFilter;\n        this.routePathFactory = routePathFactory;\n        this.graphInspector = graphInspector;\n        this.pathsExplorer = new PathsExplorer(metadataScanner);\n        const routeParamsFactory = new RouteParamsFactory();\n        const pipesContextCreator = new PipesContextCreator(container\x2C config);\n        const pipesConsumer = new PipesConsumer();\n        const guardsContextCreator = new GuardsContextCreator(container\x2C config);\n        const guardsConsumer = new GuardsConsumer();\n        const interceptorsContextCreator = new InterceptorsContextCreator(container\x2C config);\n        const interceptorsConsumer = new InterceptorsConsumer();\n        this.executionContextCreator = new RouterExecutionContext(routeParamsFactory\x2C pipesContextCreator\x2C pipesConsumer\x2C guardsContextCreator\x2C guardsConsumer\x2C interceptorsContextCreator\x2C interceptorsConsumer\x2C container.getHttpAdapterRef());\n    }\n    explore(instanceWrapper\x2C moduleKey\x2C httpAdapterRef\x2C host\x2C routePathMetadata\x2C options = {}) {\n        const { instance } = instanceWrapper;\n        const routerPaths = this.pathsExplorer.scanForPaths(instance);\n        this.applyPathsToRouterProxy(httpAdapterRef\x2C routerPaths\x2C instanceWrapper\x2C moduleKey\x2C routePathMetadata\x2C host\x2C options);\n    }\n    extractRouterPath(metatype) {\n        const path = Reflect.getMetadata(PATH_METADATA\x2C metatype);\n        if (isUndefined(path)) {\n            throw new UnknownRequestMappingException(metatype);\n        }\n        if (Array.isArray(path)) {\n            return path.map(p => addLeadingSlash(p));\n        }\n        return [addLeadingSlash(path)];\n    }\n    applyPathsToRouterProxy(router\x2C routeDefinitions\x2C instanceWrapper\x2C moduleKey\x2C routePathMetadata\x2C host\x2C options = {}) {\n        (routeDefinitions || []).forEach(routeDefinition => {\n            const { version: methodVersion } = routeDefinition;\n            routePathMetadata.methodVersion = methodVersion;\n            this.applyCallbackToRouter(router\x2C routeDefinition\x2C instanceWrapper\x2C moduleKey\x2C routePathMetadata\x2C host\x2C options);\n        });\n    }\n    applyCallbackToRouter(router\x2C routeDefinition\x2C instanceWrapper\x2C moduleKey\x2C routePathMetadata\x2C host\x2C options = {}) {\n        const { onRouteResolved\x2C deferRegistration = false } = options;\n        const { path: paths\x2C requestMethod\x2C targetCallback\x2C methodName\x2C } = routeDefinition;\n        const { instance } = instanceWrapper;\n        const routerMethodRef = this.routerMethodFactory\n            .get(router\x2C requestMethod)\n            .bind(router);\n        const isRequestScoped = !instanceWrapper.isDependencyTreeStatic();\n        const proxy = isRequestScoped\n            ? this.createRequestScopedHandler(instanceWrapper\x2C requestMethod\x2C this.container.getModuleByKey(moduleKey)\x2C moduleKey\x2C methodName)\n            : this.createCallbackProxy(instance\x2C targetCallback\x2C methodName\x2C moduleKey\x2C requestMethod);\n        const isVersioned = (routePathMetadata.methodVersion ||\n            routePathMetadata.controllerVersion) &&\n            routePathMetadata.versioningOptions;\n        let routeHandler = this.applyHostFilter(host\x2C proxy);\n        paths.forEach(path => {\n            if (isVersioned &&\n                routePathMetadata.versioningOptions.type !== VersioningType.URI) {\n                // All versioning (except for URI Versioning) is done via the "Version Filter"\n                routeHandler = this.applyVersionFilter(router\x2C routePathMetadata\x2C routeHandler);\n            }\n            routePathMetadata.methodPath = path;\n            const pathsToRegister = this.routePathFactory.create(routePathMetadata\x2C requestMethod);\n            pathsToRegister.forEach(path => {\n                const normalizedPath = router.normalizePath\n                    ? router.normalizePath(path)\n                    : path;\n                const entrypointDefinition = {\n                    type: 'http-endpoint'\x2C\n                    methodName\x2C\n                    className: instanceWrapper.name\x2C\n                    classNodeId: instanceWrapper.id\x2C\n                    metadata: {\n                        key: path\x2C\n                        path\x2C\n                        requestMethod: RequestMethod[requestMethod]\x2C\n                        methodVersion: routePathMetadata.methodVersion\x2C\n                        controllerVersion: routePathMetadata.controllerVersion\x2C\n                    }\x2C\n                };\n                if (!deferRegistration) {\n                    this.copyMetadataToCallback(targetCallback\x2C routeHandler);\n                    const httpAdapter = this.container.getHttpAdapterRef();\n                    const onRouteTriggered = httpAdapter.getOnRouteTriggered?.();\n                    if (onRouteTriggered) {\n                        routerMethodRef(normalizedPath\x2C (...args) => {\n                            onRouteTriggered(requestMethod\x2C path);\n                            return routeHandler(...args);\n                        });\n                    }\n                    else {\n                        routerMethodRef(normalizedPath\x2C routeHandler);\n                    }\n                }\n                onRouteResolved?.({\n                    method: requestMethod\x2C\n                    path: normalizedPath\x2C\n                    rawPath: path\x2C\n                    host\x2C\n                    version: routePathMetadata.methodVersion ??\n                        routePathMetadata.controllerVersion\x2C\n                    methodVersion: routePathMetadata.methodVersion\x2C\n                    controllerVersion: routePathMetadata.controllerVersion\x2C\n                    handler: routeHandler\x2C\n                    targetCallback\x2C\n                    methodName\x2C\n                    instanceWrapper\x2C\n                });\n                this.graphInspector.insertEntrypointDefinition(entrypointDefinition\x2C instanceWrapper.id);\n            });\n            const pathsToLog = this.routePathFactory.create({\n                ...routePathMetadata\x2C\n                versioningOptions: undefined\x2C\n            }\x2C requestMethod);\n            pathsToLog.forEach(path => {\n                if (isVersioned) {\n                    const version = this.routePathFactory.getVersion(routePathMetadata);\n                    this.logger.log(VERSIONED_ROUTE_MAPPED_MESSAGE(path\x2C requestMethod\x2C version));\n                }\n                else {\n                    this.logger.log(ROUTE_MAPPED_MESSAGE(path\x2C requestMethod));\n                }\n            });\n        });\n    }\n    /**\n     * Registers a previously resolved route on the underlying HTTP adapter.\n     * Used when route registration has been deferred (e.g. when sorting\n     * routes by specificity) so the caller can choose the order in which\n     * routes are installed on the adapter.\n     */\n    registerResolvedRoute(router\x2C route) {\n        const routerMethodRef = this.routerMethodFactory\n            .get(router\x2C route.method)\n            .bind(router);\n        this.copyMetadataToCallback(route.targetCallback\x2C route.handler);\n        const normalizedPath = route.path;\n        const rawPath = route.rawPath ?? route.path;\n        const httpAdapter = this.container.getHttpAdapterRef();\n        const onRouteTriggered = httpAdapter.getOnRouteTriggered?.();\n        if (onRouteTriggered) {\n            routerMethodRef(normalizedPath\x2C (...args) => {\n                onRouteTriggered(route.method\x2C rawPath);\n                return route.handler(...args);\n            });\n        }\n        else {\n            routerMethodRef(normalizedPath\x2C route.handler);\n        }\n    }\n    applyHostFilter(host\x2C handler) {\n        if (!host) {\n            return handler;\n        }\n        const httpAdapterRef = this.container.getHttpAdapterRef();\n        const hosts = Array.isArray(host) ? host : [host];\n        const hostRegExps = hosts.map((host) => {\n            if (typeof host === 'string') {\n                try {\n                    return pathToRegexp(host);\n                }\n                catch (e) {\n                    if (e instanceof TypeError) {\n                        this.logger.error(`Unsupported host "${host}" syntax. In past releases\x2C ?\x2C *\x2C and + were used to denote optional or repeating path parameters. The latest version of "path-to-regexp" now requires the use of named parameters. For example\x2C instead of using a route like /users/* to capture all routes starting with "/users"\x2C you should use /users/*path. Please see the migration guide for more information.`);\n                    }\n                    throw e;\n                }\n            }\n            return { regexp: host\x2C keys: [] };\n        });\n        const unsupportedFilteringErrorMessage = Array.isArray(host)\n            ? `HTTP adapter does not support filtering on hosts: ["${host.join('"\x2C "')}"]`\n            : `HTTP adapter does not support filtering on host: "${host}"`;\n        return (req\x2C res\x2C next) => {\n            req.hosts = {};\n            const hostname = httpAdapterRef.getRequestHostname(req) || '';\n            for (const exp of hostRegExps) {\n                const match = hostname.match(exp.regexp);\n                if (match) {\n                    if (exp.keys.length > 0) {\n                        exp.keys.forEach((key\x2C i) => (req.hosts[key.name] = match[i + 1]));\n                    }\n                    else if (exp.regexp && match.groups) {\n                        for (const groupName in match.groups) {\n                            req.hosts[groupName] = match.groups[groupName];\n                        }\n                    }\n                    return handler(req\x2C res\x2C next);\n                }\n            }\n            if (!next) {\n                throw new InternalServerErrorException(unsupportedFilteringErrorMessage);\n            }\n            return next();\n        };\n    }\n    applyVersionFilter(router\x2C routePathMetadata\x2C handler) {\n        const version = this.routePathFactory.getVersion(routePathMetadata);\n        return router.applyVersionFilter(handler\x2C version\x2C routePathMetadata.versioningOptions);\n    }\n    createCallbackProxy(instance\x2C callback\x2C methodName\x2C moduleRef\x2C requestMethod\x2C contextId = STATIC_CONTEXT\x2C inquirerId) {\n        const executionContext = this.executionContextCreator.create(instance\x2C callback\x2C methodName\x2C moduleRef\x2C requestMethod\x2C contextId\x2C inquirerId);\n        const exceptionFilter = this.exceptionsFilter.create(instance\x2C callback\x2C moduleRef\x2C contextId\x2C inquirerId);\n        return this.routerProxy.createProxy(executionContext\x2C exceptionFilter);\n    }\n    createRequestScopedHandler(instanceWrapper\x2C requestMethod\x2C moduleRef\x2C moduleKey\x2C methodName) {\n        const { instance } = instanceWrapper;\n        const collection = moduleRef.controllers;\n        const isTreeDurable = instanceWrapper.isDependencyTreeDurable();\n        return async (req\x2C res\x2C next) => {\n            try {\n                const contextId = this.getContextId(req\x2C isTreeDurable);\n                const contextInstance = await this.injector.loadPerContext(instance\x2C moduleRef\x2C collection\x2C contextId);\n                await this.createCallbackProxy(contextInstance\x2C contextInstance[methodName]\x2C methodName\x2C moduleKey\x2C requestMethod\x2C contextId\x2C instanceWrapper.id)(req\x2C res\x2C next);\n            }\n            catch (err) {\n                let exceptionFilter = this.exceptionFiltersCache.get(instance[methodName]);\n                if (!exceptionFilter) {\n                    exceptionFilter = this.exceptionsFilter.create(instance\x2C instance[methodName]\x2C moduleKey);\n                    this.exceptionFiltersCache.set(instance[methodName]\x2C exceptionFilter);\n                }\n                const host = new ExecutionContextHost([req\x2C res\x2C next]);\n                exceptionFilter.next(err\x2C host);\n            }\n        };\n    }\n    getContextId(request\x2C isTreeDurable) {\n        const contextId = ContextIdFactory.getByRequest(request);\n        if (!request[REQUEST_CONTEXT_ID]) {\n            Object.defineProperty(request\x2C REQUEST_CONTEXT_ID\x2C {\n                value: contextId\x2C\n                enumerable: false\x2C\n                writable: false\x2C\n                configurable: false\x2C\n            });\n            const requestProviderValue = isTreeDurable\n                ? contextId.payload\n                : Object.assign(request\x2C contextId.payload);\n            this.container.registerRequestProvider(requestProviderValue\x2C contextId);\n        }\n        return contextId;\n    }\n    copyMetadataToCallback(originalCallback\x2C targetCallback) {\n        for (const key of Reflect.getMetadataKeys(originalCallback)) {\n            Reflect.defineMetadata(key\x2C Reflect.getMetadata(key\x2C originalCallback)\x2C targetCallback);\n        }\n    }\n}\n
