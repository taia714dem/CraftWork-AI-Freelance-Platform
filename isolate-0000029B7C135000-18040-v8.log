string) !== null !== match) {\x0d\n    if (message instanceof Error) {\x0d\n      throw message;\x0d\n    }\x0d\n\x0d\n    const generatedMessage = !message;\x0d\n\x0d\n    // 'The input was expected to not match the regular expression ' +\x0d\n    message ||= (typeof string !== 'string' ?\x0d\n      'The "string" argument must be of type string. Received type ' +\x0d\n        `${typeof string} (${inspect(string)})` :\x0d\n      (match ?\x0d\n        'The input did not match the regular expression ' :\x0d\n        'The input was expected to not match the regular expression ') +\x0d\n          `${inspect(regexp)}. Input:\\n\\n${inspect(string)}\\n`);\x0d\n    const err = new AssertionError({\x0d\n      actual: string\x2C\x0d\n      expected: regexp\x2C\x0d\n      message\x2C\x0d\n      operator: fn.name\x2C\x0d\n      stackStartFn: fn\x2C\x0d\n    });\x0d\n    err.generatedMessage = generatedMessage;\x0d\n    throw err;\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Expects the `string` input to match the regular expression.\x0d\n * @param {string} string\x0d\n * @param {RegExp} regexp\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nassert.match = function match(string\x2C regexp\x2C message) {\x0d\n  internalMatch(string\x2C regexp\x2C message\x2C match);\x0d\n};\x0d\n\x0d\n/**\x0d\n * Expects the `string` input not to match the regular expression.\x0d\n * @param {string} string\x0d\n * @param {RegExp} regexp\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nassert.doesNotMatch = function doesNotMatch(string\x2C regexp\x2C message) {\x0d\n  internalMatch(string\x2C regexp\x2C message\x2C doesNotMatch);\x0d\n};\x0d\n\x0d\nassert.CallTracker = deprecate(CallTracker\x2C 'assert.CallTracker is deprecated.'\x2C 'DEP0173');\x0d\n\x0d\n/**\x0d\n * Expose a strict only variant of assert.\x0d\n * @param {...any} args\x0d\n * @returns {void}\x0d\n */\x0d\nfunction strict(...args) {\x0d\n  innerOk(strict\x2C args.length\x2C