script-source,1834,node:dns,// Copyright Joyent\x2C Inc. and other Node contributors.\x0d\n//\x0d\n// Permission is hereby granted\x2C free of charge\x2C to any person obtaining a\x0d\n// copy of this software and associated documentation files (the\x0d\n// "Software")\x2C to deal in the Software without restriction\x2C including\x0d\n// without limitation the rights to use\x2C copy\x2C modify\x2C merge\x2C publish\x2C\x0d\n// distribute\x2C sublicense\x2C and/or sell copies of the Software\x2C and to permit\x0d\n// persons to whom the Software is furnished to do so\x2C subject to the\x0d\n// following conditions:\x0d\n//\x0d\n// The above copyright notice and this permission notice shall be included\x0d\n// in all copies or substantial portions of the Software.\x0d\n//\x0d\n// THE SOFTWARE IS PROVIDED "AS IS"\x2C WITHOUT WARRANTY OF ANY KIND\x2C EXPRESS\x0d\n// OR IMPLIED\x2C INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\x0d\n// MERCHANTABILITY\x2C FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\x0d\n// NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM\x2C\x0d\n// DAMAGES OR OTHER LIABILITY\x2C WHETHER IN AN ACTION OF CONTRACT\x2C TORT OR\x0d\n// OTHERWISE\x2C ARISING FROM\x2C OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\x0d\n// USE OR OTHER DEALINGS IN THE SOFTWARE.\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst {\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst cares = internalBinding('cares_wrap');\x0d\nconst { isIP } = require('internal/net');\x0d\nconst { customPromisifyArgs } = require('internal/util');\x0d\nconst {\x0d\n  DNSException\x2C\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_MISSING_ARGS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  bindDefaultResolver\x2C\x0d\n  setDefaultResolver\x2C\x0d\n  validateHints\x2C\x0d\n  emitInvalidHostnameWarning\x2C\x0d\n  getDefaultResultOrder\x2C\x0d\n  setDefaultResultOrder\x2C\x0d\n  errorCodes: dnsErrorCodes\x2C\x0d\n} = require('internal/dns/utils');\x0d\nconst {\x0d\n  Resolver\x2C\x0d\n} = require('internal/dns/callback_resolver');\x0d\nconst {\x0d\n  NODATA\x2C\x0d\n  FORMERR\x2C\x0d\n  SERVFAIL\x2C\x0d\n  NOTFOUND\x2C\x0d\n  NOTIMP\x2C\x0d\n  REFUSED\x2C\x0d\n  BADQUERY\x2C\x0d\n  BADNAME\x2C\x0d\n  BADFAMILY\x2C\x0d\n  BADRESP\x2C\x0d\n  CONNREFUSED\x2C\x0d\n  TIMEOUT\x2C\x0d\n  EOF\x2C\x0d\n  FILE\x2C\x0d\n  NOMEM\x2C\x0d\n  DESTRUCTION\x2C\x0d\n  BADSTR\x2C\x0d\n  BADFLAGS\x2C\x0d\n  NONAME\x2C\x0d\n  BADHINTS\x2C\x0d\n  NOTINITIALIZED\x2C\x0d\n  LOADIPHLPAPI\x2C\x0d\n  ADDRGETNETWORKPARAMS\x2C\x0d\n  CANCELLED\x2C\x0d\n} = dnsErrorCodes;\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateFunction\x2C\x0d\n  validateNumber\x2C\x0d\n  validateOneOf\x2C\x0d\n  validatePort\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  GetAddrInfoReqWrap\x2C\x0d\n  GetNameInfoReqWrap\x2C\x0d\n  DNS_ORDER_VERBATIM\x2C\x0d\n  DNS_ORDER_IPV4_FIRST\x2C\x0d\n  DNS_ORDER_IPV6_FIRST\x2C\x0d\n} = cares;\x0d\n\x0d\nconst kPerfHooksDnsLookupContext = Symbol('kPerfHooksDnsLookupContext');\x0d\nconst kPerfHooksDnsLookupServiceContext = Symbol('kPerfHooksDnsLookupServiceContext');\x0d\n\x0d\nconst {\x0d\n  hasObserver\x2C\x0d\n  startPerf\x2C\x0d\n  stopPerf\x2C\x0d\n} = require('internal/perf/observe');\x0d\n\x0d\nlet promises = null; // Lazy loaded\x0d\n\x0d\nfunction onlookup(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    return this.callback(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n  }\x0d\n  this.callback(null\x2C addresses[0]\x2C this.family || isIP(addresses[0]));\x0d\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction onlookupall(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    return this.callback(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n  }\x0d\n\x0d\n  const family = this.family;\x0d\n  for (let i = 0; i < addresses.length; i++) {\x0d\n    const addr = addresses[i];\x0d\n    addresses[i] = {\x0d\n      address: addr\x2C\x0d\n      family: family || isIP(addr)\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  this.callback(null\x2C addresses);\x0d\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Easy DNS A/AAAA look up\x0d\n// lookup(hostname\x2C [options\x2C] callback)\x0d\nconst validFamilies = [0\x2C 4\x2C 6];\x0d\nfunction lookup(hostname\x2C options\x2C callback) {\x0d\n  let hints = 0;\x0d\n  let family = 0;\x0d\n  let all = false;\x0d\n  let dnsOrder = getDefaultResultOrder();\x0d\n\x0d\n  // Parse arguments\x0d\n  if (hostname) {\x0d\n    validateString(hostname\x2C 'hostname');\x0d\n  }\x0d\n\x0d\n  if (typeof options === 'function') {\x0d\n    callback = options;\x0d\n    family = 0;\x0d\n  } else if (typeof options === 'number') {\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n\x0d\n    validateOneOf(options\x2C 'family'\x2C validFamilies);\x0d\n    family = options;\x0d\n  } else if (options !== undefined && typeof options !== 'object') {\x0d\n    validateFunction(arguments.length === 2 ? options : callback\x2C 'callback');\x0d\n    throw new ERR_INVALID_ARG_TYPE('options'\x2C ['integer'\x2C 'object']\x2C options);\x0d\n  } else {\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n\x0d\n    if (options?.hints != null) {\x0d\n      validateNumber(options.hints\x2C 'options.hints');\x0d\n      hints = options.hints >>> 0;\x0d\n      validateHints(hints);\x0d\n    }\x0d\n    if (options?.family != null) {\x0d\n      switch (options.family) {\x0d\n        case 'IPv4':\x0d\n          family = 4;\x0d\n          break;\x0d\n        case 'IPv6':\x0d\n          family = 6;\x0d\n          break;\x0d\n        default:\x0d\n          validateOneOf(options.family\x2C 'options.family'\x2C validFamilies);\x0d\n          family = options.family;\x0d\n          break;\x0d\n      }\x0d\n    }\x0d\n    if (options?.all != null) {\x0d\n      validateBoolean(options.all\x2C 'options.all');\x0d\n      all = options.all;\x0d\n    }\x0d\n    if (options?.verbatim != null) {\x0d\n      validateBoolean(options.verbatim\x2C 'options.verbatim');\x0d\n      dnsOrder = options.verbatim ? 'verbatim' : 'ipv4first';\x0d\n    }\x0d\n    if (options?.order != null) {\x0d\n      validateOneOf(options.order\x2C 'options.order'\x2C ['ipv4first'\x2C 'ipv6first'\x2C 'verbatim']);\x0d\n      dnsOrder = options.order;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (!hostname) {\x0d\n    emitInvalidHostnameWarning(hostname);\x0d\n    if (all) {\x0d\n      process.nextTick(callback\x2C null\x2C []);\x0d\n    } else {\x0d\n      process.nextTick(callback\x2C null\x2C null\x2C family === 6 ? 6 : 4);\x0d\n    }\x0d\n    return {};\x0d\n  }\x0d\n\x0d\n  const matchedFamily = isIP(hostname);\x0d\n  if (matchedFamily) {\x0d\n    if (all) {\x0d\n      process.nextTick(\x0d\n        callback\x2C null\x2C [{ address: hostname\x2C family: matchedFamily }]);\x0d\n    } else {\x0d\n      process.nextTick(callback\x2C null\x2C hostname\x2C matchedFamily);\x0d\n    }\x0d\n    return {};\x0d\n  }\x0d\n\x0d\n  const req = new GetAddrInfoReqWrap();\x0d\n  req.callback = callback;\x0d\n  req.family = family;\x0d\n  req.hostname = hostname;\x0d\n  req.oncomplete = all ? onlookupall : onlookup;\x0d\n\x0d\n  let order = DNS_ORDER_VERBATIM;\x0d\n\x0d\n  if (dnsOrder === 'ipv4first') {\x0d\n    order = DNS_ORDER_IPV4_FIRST;\x0d\n  } else if (dnsOrder === 'ipv6first') {\x0d\n    order = DNS_ORDER_IPV6_FIRST;\x0d\n  }\x0d\n\x0d\n  const err = cares.getaddrinfo(\x0d\n    req\x2C hostname\x2C family\x2C hints\x2C order\x2C\x0d\n  );\x0d\n  if (err) {\x0d\n    process.nextTick(callback\x2C new DNSException(err\x2C 'getaddrinfo'\x2C hostname));\x0d\n    return {};\x0d\n  }\x0d\n  if (hasObserver('dns')) {\x0d\n    const detail = {\x0d\n      hostname\x2C\x0d\n      family\x2C\x0d\n      hints\x2C\x0d\n      verbatim: order === DNS_ORDER_VERBATIM\x2C\x0d\n      order: dnsOrder\x2C\x0d\n    };\x0d\n\x0d\n    startPerf(req\x2C kPerfHooksDnsLookupContext\x2C { type: 'dns'\x2C name: 'lookup'\x2C detail });\x0d\n  }\x0d\n  return req;\x0d\n}\x0d\n\x0d\nObjectDefineProperty(lookup\x2C customPromisifyArgs\x2C\x0d\n                     { __proto__: null\x2C value: ['address'\x2C 'family']\x2C enumerable: false });\x0d\n\x0d\n\x0d\nfunction onlookupservice(err\x2C hostname\x2C service) {\x0d\n  if (err)\x0d\n    return this.callback(new DNSException(err\x2C 'getnameinfo'\x2C this.hostname));\x0d\n\x0d\n  this.callback(null\x2C hostname\x2C service);\x0d\n  if (this[kPerfHooksDnsLookupServiceContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupServiceContext\x2C { detail: { hostname\x2C service } });\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction lookupService(address\x2C port\x2C callback) {\x0d\n  if (arguments.length !== 3)\x0d\n    throw new ERR_MISSING_ARGS('address'\x2C 'port'\x2C 'callback');\x0d\n\x0d\n  if (isIP(address) === 0)\x0d\n    throw new ERR_INVALID_ARG_VALUE('address'\x2C address);\x0d\n\x0d\n  validatePort(port);\x0d\n\x0d\n  validateFunction(callback\x2C 'callback');\x0d\n\x0d\n  port = +port;\x0d\n\x0d\n  const req = new GetNameInfoReqWrap();\x0d\n  req.callback = callback;\x0d\n  req.hostname = address;\x0d\n  req.port = port;\x0d\n  req.oncomplete = onlookupservice;\x0d\n\x0d\n  const err = cares.getnameinfo(req\x2C address\x2C port);\x0d\n  if (err) throw new DNSException(err\x2C 'getnameinfo'\x2C address);\x0d\n  if (hasObserver('dns')) {\x0d\n    startPerf(req\x2C kPerfHooksDnsLookupServiceContext\x2C {\x0d\n      type: 'dns'\x2C\x0d\n      name: 'lookupService'\x2C\x0d\n      detail: {\x0d\n        host: address\x2C\x0d\n        port\x2C\x0d\n