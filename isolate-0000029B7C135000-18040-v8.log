script-source,1839,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\pg\\lib\\connection.js,'use strict'\n\nconst EventEmitter = require('events').EventEmitter\n\nconst { parse\x2C serialize } = require('pg-protocol')\nconst stream = require('./stream')\nconst { getStream } = stream\n\nconst flushBuffer = serialize.flush()\nconst syncBuffer = serialize.sync()\nconst endBuffer = serialize.end()\n\n// TODO(bmc) support binary mode at some point\nclass Connection extends EventEmitter {\n  constructor(config) {\n    super()\n    config = config || {}\n\n    this.stream = config.stream || getStream(config.ssl)\n    if (typeof this.stream === 'function') {\n      this.stream = this.stream(config)\n    }\n\n    this._keepAlive = config.keepAlive\n    this._keepAliveInitialDelayMillis = config.keepAliveInitialDelayMillis\n    this.parsedStatements = {}\n    this.submittedNamedStatements = {}\n    this.ssl = config.ssl || false\n    this.sslNegotiation = config.sslNegotiation || 'postgres'\n    this._ending = false\n    this._emitMessage = false\n    const self = this\n    this.on('newListener'\x2C function (eventName) {\n      if (eventName === 'message') {\n        self._emitMessage = true\n      }\n    })\n  }\n\n  connect(port\x2C host) {\n    const self = this\n\n    this._connecting = true\n    this.stream.setNoDelay(true)\n    this.stream.connect(port\x2C host)\n\n    this.stream.once('connect'\x2C function () {\n      if (self._keepAlive) {\n        self.stream.setKeepAlive(true\x2C self._keepAliveInitialDelayMillis)\n      }\n      self.emit('connect')\n    })\n\n    const reportStreamError = function (error) {\n      // errors about disconnections should be ignored during disconnect\n      if (self._ending && (error.code === 'ECONNRESET' || error.code === 'EPIPE')) {\n        return\n      }\n      self.emit('error'\x2C error)\n    }\n    this.stream.on('error'\x2C reportStreamError)\n\n    this.stream.on('close'\x2C function () {\n      self.emit('end')\n    })\n\n    if (!this.ssl) {\n      return this.attachListeners(this.stream)\n    }\n\n    // With direct SSL negotiation the TLS handshake starts immediately on the\n    // raw socket\x2C skipping the SSLRequest packet and the server's 'S'/'N' reply.\n    if (this.sslNegotiation === 'direct') {\n      return this.stream.once('connect'\x2C function () {\n        self.upgradeToSSL(host\x2C reportStreamError)\n      })\n    }\n\n    this.stream.once('data'\x2C function (buffer) {\n      const responseCode = buffer.toString('utf8')\n      switch (responseCode) {\n        case 'S': // Server supports SSL connections\x2C continue with a secure connection\n          break\n        case 'N': // Server does not support SSL connections\n          self.stream.end()\n          return self.emit('error'\x2C new Error('The server does not support SSL connections'))\n        default:\n          // Any other response byte\x2C including 'E' (ErrorResponse) indicating a server error\n          self.stream.end()\n          return self.emit('error'\x2C new Error('There was an error establishing an SSL connection'))\n      }\n      self.upgradeToSSL(host\x2C reportStreamError)\n    })\n  }\n\n  upgradeToSSL(host\x2C reportStreamError) {\n    const self = this\n    const options = {\n      socket: self.stream\x2C\n      // tls.connect checks the server identity against `servername`\x2C falling\n      // back to `host` and then to 'localhost'. `servername` must stay unset\n      // for IP addresses (see below)\x2C so `host` is needed to keep certificate\n      // validation working when connecting to an IP address.\n      host\x2C\n    }\n\n    if (self.ssl !== true) {\n      Object.assign(options\x2C self.ssl)\n\n      if ('key' in self.ssl) {\n        options.key = self.ssl.key\n      }\n    }\n\n    // Direct SSL negotiation requires ALPN so the server can confirm it is\n    // speaking the PostgreSQL protocol over the TL