his._isGlobal = global;\n    }\n    get initOnPreview() {\n        return this._initOnPreview;\n    }\n    set initOnPreview(initOnPreview) {\n        this._initOnPreview = initOnPreview;\n    }\n    get providers() {\n        return this._providers;\n    }\n    get middlewares() {\n        return this._middlewares;\n    }\n    get imports() {\n        return this._imports;\n    }\n    get injectables() {\n        return this._injectables;\n    }\n    get controllers() {\n        return this._controllers;\n    }\n    get entryProviders() {\n        return Array.from(this._entryProviderKeys).map(token => this.providers.get(token));\n    }\n    get exports() {\n        return this._exports;\n    }\n    get instance() {\n        if (!this._providers.has(this._metatype)) {\n            throw new RuntimeException();\n        }\n        const moduleRef = this._providers.get(this._metatype);\n        return moduleRef.instance;\n    }\n    /**\n     * Modules are registered in the container before they are scanned (dynamic\n     * `imports` are pre-registered by `NestContainer#addDynamicMetadata`)\x2C so\n     * registration alone does not imply the module was ever instantiated.\n     */\n    get isInstantiated() {\n        return !isNil(this._providers.get(this._metatype)?.instance);\n    }\n    get metatype() {\n        return this._metatype;\n    }\n    get distance() {\n        return this._distance;\n    }\n    set distance(value) {\n        this._distance = value;\n    }\n    addCoreProviders() {\n        this.addModuleAsProvider();\n        this.addModuleRef();\n        this.addApplicationConfig();\n    }\n    addModuleRef() {\n        const moduleRef = this.createModuleReferenceType();\n        this._providers.set(ModuleRef\x2C new InstanceWrapper({\n            token: ModuleRef\x2C\n            name: ModuleRef.name\x2C\n            metatype: ModuleRef\x2C\n            isResolved: true\x2C\n            instance: new moduleRef()\x2C\n            host: this\x2C\n        }));\n    }\n    addModuleAsProvider() {\n        this._providers.set(this._metatype\x2C new InstanceWrapper({\n            token: this._metatype\x2C\n            name: this._metatype.name\x2C\n            metatype: this._metatype\x2C\n            isResolved: false\x2C\n            instance: null\x2C\n            host: this\x2C\n        }));\n    }\n    addApplicationConfig() {\n        this._providers.set(ApplicationConfig\x2C new InstanceWrapper({\n            token: ApplicationConfig\x2C\n            name: ApplicationConfig.name\x2C\n            isResolved: true\x2C\n            instance: this.container.applicationConfig\x2C\n            host: this\x2C\n        }));\n    }\n    addInjectable(injectable\x2C enhancerSubtype\x2C host) {\n        if (this.isCustomProvider(injectable)) {\n            return this.addCustomProvider(injectable\x2C this._injectables\x2C enhancerSubtype);\n        }\n        let instanceWrapper = this.injectables.get(injectable);\n        if (!instanceWrapper) {\n            instanceWrapper = new InstanceWrapper({\n                token: injectable\x2C\n                name: injectable.name\x2C\n                metatype: injectable\x2C\n                instance: null\x2C\n                isResolved: false\x2C\n                scope: getClassScope(injectable)\x2C\n                durable: isDurable(injectable)\x2C\n                subtype: enhancerSubtype\x2C\n                host: this\x2C\n            });\n            this._injectables.set(injectable\x2C instanceWrapper);\n        }\n        if (host) {\n            const hostWrapper = this._controllers.get(host) || this._providers.get(host);\n            hostWrapper && hostWrapper.addEnhancerMetadata(instanceWrapper);\n        }\n        return instanceWrapper;\n    }\n    addProvider(provider\x2C enhancerSubtype) {\n        if (this.isCustomProvider(provider)) {\n            if (this.isEntryProvider(provider.provide)) {\n                this._entryProviderKeys.add(provider.provide);\n            }\n            return this.addCustomProvider(provider\x2C this._providers\x2C enhancerSubtype);\n        }\n        const isAlreadyDeclared = this._providers.has(provider);\n        if ((this.isTransientProvider(provider) ||\n            this.isRequestScopeProvider(provider)) &&\n            isAlreadyDeclared) {\n            return provider;\n        }\n        this._providers.set(provider\x2C new InstanceWrapper({\n            token: provider\x2C\n            name: provider.name\x2C\n            metatype: provider\x2C\n            instance: null\x2C\n            isResolved: false\x2C\n            scope: getClassScope(provider)\x2C\n            durable: isDurable(provider)\x2C\n            host: this\x2C\n        }));\n        if (this.isEntryProvider(provider)) {\n            this._entryProviderKeys.add(provider);\n        }\n        return provider;\n    }\n    isCustomProvider(provider) {\n        return !isNil(provider.provide);\n    }\n    addCustomProvider(provider\x2C collection\x2C enhancerSubtype) {\n        if (this.isCustomClass(provider)) {\n            this.addCustomClass(provider\x2C collection\x2C enhancerSubtype);\n        }\n        else if (this.isCustomValue(provider)) {\n            this.addCustomValue(provider\x2C collection\x2C enhancerSubtype);\n        }\n        else if (this.isCustomFactory(provider)) {\n            this.addCustomFactory(provider\x2C collection\x2C enhancerSubtype);\n        }\n        else if (this.isCustomUseExisting(provider)) {\n            this.addCustomUseExisting(provider\x2C collection\x2C enhancerSubtype);\n        }\n        return provider.provide;\n    }\n    isCustomClass(provider) {\n        return !isUndefined(provider.useClass);\n    }\n    isCustomValue(provider) {\n        return (isObject(provider) &&\n            Object.prototype.hasOwnProperty.call(provider\x2C 'useValue'));\n    }\n    isCustomFactory(provider) {\n        return !isUndefined(provider.useFactory);\n    }\n    isCustomUseExi