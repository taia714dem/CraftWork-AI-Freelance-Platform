script-source,1873,node:internal/tls/secure-pair,'use strict';\x0d\n\x0d\nconst {\x0d\n  ReflectConstruct\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst EventEmitter = require('events');\x0d\nconst { kEmptyObject } = require('internal/util');\x0d\nconst { Duplex } = require('stream');\x0d\nconst _tls_wrap = require('_tls_wrap');\x0d\nconst _tls_common = require('_tls_common');\x0d\n\x0d\nconst kCallback = Symbol('Callback');\x0d\nconst kOtherSide = Symbol('Other');\x0d\n\x0d\nclass DuplexSocket extends Duplex {\x0d\n  constructor() {\x0d\n    super();\x0d\n    this[kCallback] = null;\x0d\n    this[kOtherSide] = null;\x0d\n  }\x0d\n\x0d\n  _read() {\x0d\n    const callback = this[kCallback];\x0d\n    if (callback) {\x0d\n      this[kCallback] = null;\x0d\n      callback();\x0d\n    }\x0d\n  }\x0d\n\x0d\n  _write(chunk\x2C encoding\x2C callback) {\x0d\n    if (chunk.length === 0) {\x0d\n      process.nextTick(callback);\x0d\n    } else {\x0d\n      this[kOtherSide].push(chunk);\x0d\n      this[kOtherSide][kCallback] = callback;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  _final(callback) {\x0d\n    this[kOtherSide].on('end'\x2C callback);\x0d\n    this[kOtherSide].push(null);\x0d\n  }\x0d\n}\x0d\n\x0d\nclass DuplexPair {\x0d\n  constructor() {\x0d\n    this.socket1 = new DuplexSocket();\x0d\n    this.socket2 = new DuplexSocket();\x0d\n    this.socket1[kOtherSide] = this.socket2;\x0d\n    this.socket2[kOtherSide] = this.socket1;\x0d\n  }\x0d\n}\x0d\n\x0d\nclass SecurePair extends EventEmitter {\x0d\n  constructor(secureContext = _tls_common.createSecureContext()\x2C\x0d\n              isServer = false\x2C\x0d\n              requestCert = !isServer\x2C\x0d\n              rejectUnauthorized = false\x2C\x0d\n              options = kEmptyObject) {\x0d\n    super();\x0d\n    const { socket1\x2C socket2 } = new DuplexPair();\x0d\n\x0d\n    this.server = options.server;\x0d\n    this.credentials = secureContext;\x0d\n\x0d\n    this.encrypted = socket1;\x0d\n    this.clear