script-source,753,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/inspector/deterministic-uuid-registry.js,export class DeterministicUuidRegistry {\n    static registry = new Map();\n    static get(str\x2C inc = 0) {\n        const id = inc ? this.hashCode(`${str}_${inc}`) : this.hashCode(str);\n        if (this.registry.has(id)) {\n            return this.get(str\x2C inc + 1);\n        }\n        this.registry.set(id\x2C true);\n        return id;\n    }\n    static clear() {\n        this.registry.clear();\n    }\n    static hashCode(s) {\n        let h = 0;\n        for (let i = 0; i < s.length; i++)\n            h = (Math.imul(31\x2C h) + s.charCodeAt(i)) | 0;\n        return h.toString();\n    }\n}\n
