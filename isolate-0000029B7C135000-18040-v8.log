;\n};\n\nvar parseBool = function(value) {\n  if(value === null) return null;\n  return (parseBits(value\x2C 8) > 0);\n};\n\nvar init = function(register) {\n  register(20\x2C parseInt64);\n  register(21\x2C parseInt16);\n  register(23\x2C parseInt32);\n  register(26\x2C parseInt32);\n  register(1700\x2C parseNumeric);\n  register(700\x2C parseFloat32);\n  register(701\x2C parseFloat64);\n  register(16\x2C parseBool);\n  register(1114\x2C parseDate.bind(null\x2C false));\n  register(1184\x2C parseDate.bind(null\x2C true));\n  register(1000\x2C parseArray);\n  register(1007\x2C parseArray);\n  register(1016\x2C parseArray);\n  register(1008\x2C parseArray);\n  register(1009\x2C parseArray);\n  register(25\x2C parseText);\n};\n\nmodule.exports = {\n  init: init\n};\n
