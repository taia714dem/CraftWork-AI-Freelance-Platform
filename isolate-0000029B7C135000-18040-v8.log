script-source,2240,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/platform-express/adapters/express-adapter.js,import { BadRequestException\x2C HttpStatus\x2C InternalServerErrorException\x2C Logger\x2C StreamableFile\x2C VERSION_NEUTRAL\x2C VersioningType\x2C } from '@nestjs/common';\nimport cors from 'cors';\nimport express from 'express';\nimport * as http from 'http';\nimport * as https from 'https';\nimport { pathToRegexp } from 'path-to-regexp';\nimport { getBodyParserOptions } from './utils/get-body-parser-options.util.js';\nimport { isFunction\x2C isNil\x2C isObject\x2C isString\x2C isUndefined\x2C } from '@nestjs/common/internal';\nimport { AbstractHttpAdapter } from '@nestjs/core';\nimport { RouterMethodFactory\x2C LegacyRouteConverter\x2C } from '@nestjs/core/internal';\n/**\n * @publicApi\n */\nexport class ExpressAdapter extends AbstractHttpAdapter {\n    routerMethodFactory = new RouterMethodFactory();\n    logger = new Logger(ExpressAdapter.name);\n    openConnections = new Set();\n    registeredPrefixes = new Set();\n    isShuttingDown = false;\n    onRequestHook;\n    onResponseHook;\n    constructor(instance) {\n        super(instance || express());\n        this.instance.use((req\x2C res\x2C next) => {\n            if (this.onResponseHook) {\n                res.on('finish'\x2C () => {\n                    void this.onResponseHook.apply(this\x2C [req\x2C res]);\n                });\n            }\n            if (this.onRequestHook) {\n                void this.onRequestHook.apply(this\x2C [req\x2C res\x2C next]);\n            }\n            else {\n                next();\n            }\n        });\n    }\n    setOnRequestHook(onRequestHook) {\n        this.onRequestHook = onRequestHook;\n    }\n    setOnResponseHook(onResponseHook) {\n        this.onResponseHook = onResponseHook;\n    }\n    reply(response\x2C body\x2C statusCode) {\n        if (!isNil(statusCode)) {\n            response.status(statusCode);\n        }\n        if (isNil(body)) {\n            return response.send();\n        }\n        if (body instanceof StreamableFile) {\n            this.applyStreamHeaders(response\x2C body);\n            const stream = body.getStream();\n            stream.once('error'\x2C err => {\n                body.errorHandler(err\x2C response);\n            });\n            return stream\n                .pipe(response)\n                .on('error'\x2C (err) => body.errorLogger(err));\n        }\n        const responseContentType = response.getHeader('Content-Type');\n        if (typeof responseContentType === 'string' &&\n            !responseContentType.startsWith('application/json') &&\n            body?.statusCode >= HttpStatus.BAD_REQUEST) {\n            this.logger.warn("Content-Type doesn't match Reply body\x2C you might need a custom ExceptionFilter for non-JSON responses");\n            response.setHeader('Content-Type'\x2C 'application/json');\n        }\n        return isObject(body) ? response.json(body) : response.send(String(body));\n    }\n    status(response\x2C statusCode) {\n        return response.status(statusCode);\n    }\n    end(response\x2C message) {\n        return response.end(message);\n    }\n    render(response\x2C view\x2C options) {\n        return response.render(view\x2C options);\n    }\n    redirect(response\x2C statusCode\x2C url) {\n        return response.redirect(statusCode\x2C url);\n    }\n    setErrorHandler(handler\x2C prefix) {\n        if (prefix) {\n            const router = express.Router();\n            router.use(handler);\n            this.use(prefix\x2C router);\n        }\n        // Always mount the error handler at the root as well\x2C so routes living\n        // outside the global prefix (e.g. "setGlobalPrefix" exclusions or\n        // root-mounted routes) still pass through the exception layer.\n        return this.use(handler);\n    }\n    setNotFoundHandler(handler\x2C prefix) {\n        if (prefix) {\n            this.registeredPrefixes.add(prefix);\n            const router = express.Router();\n            router.all('*path'\x2C handler);\n            return this.use(prefix\x2C router);\n        }\n        return this.use((req\x2C res\x2C next) => {\n            // When multiple apps share this adapter\x2C a non-prefixed app's 404\n            // handler may be registered before a prefixed app's routes. Skip\n            // requests whose path belongs to another app's prefix so they can\n            // reach the correct route handlers further in the stack.\n            const path = req.originalUrl.split(/[?#]/)[0];\n            for (const registeredPrefix of this.registeredPrefixes) {\n                // Match on full path segments only\x2C so a prefix of "/api" does not\n                // swallow unrelated paths such as "/apiary".\n                if (path === registeredPrefix ||\n                    path.startsWith(`${registeredPrefix}/`)) {\n                    return next();\n                }\n            }\n            return handler(req\x2C res\x2C next);\n        });\n    }\n    isHeadersSent(response) {\n        return response.headersSent;\n    }\n    getHeader(response\x2C name) {\n        return response.get(name);\n    }\n    setHeader(response\x2C name\x2C value) {\n        return response.set(name\x2C value);\n    }\n    appendHeader(response\x2C name\x2C value) {\n        return response.append(name\x2C value);\n    }\n    normalizePath(path) {\n        try {\n            const convertedPath = LegacyRouteConverter.tryConvert(path);\n            // Call "pathToRegexp" to trigger a TypeError if the path is invalid\n            pathToRegexp(convertedPath);\n            return convertedPath;\n        }\n        catch (e) {\n            if (e instanceof TypeError) {\n                LegacyRouteConverter.printError(path);\n            }\n            throw e;\n        }\n    }\n    listen(port\x2C ...args) {\n        return this.httpServer.listen(port\x2C ...args);\n    }\n    beforeClose() {\n        this.isShuttingDown = true;\n    }\n    close() {\n        this.isShuttingDown = true;\n        this.closeOpenConnections();\n        if (!this.httpServer) {\n            return undefined;\n        }\n        return new Promise(resolve => this.httpServer.close(resolve));\n    }\n    set(...args) {\n        return this.instance.set(...args);\n    }\n    enable(...args) {\n        return this.instance.enable(...args);\n    }\n    disable(...args) {\n        return this.instance.disable(...args);\n    }\n    engine(...args) {\n        return this.instance.engine(...args);\n    }\n    useStaticAssets(path\x2C options) {\n        if (options && options.prefix) {\n            return this.use(options.prefix\x2C express.static(path\x2C options));\n        }\n        return this.use(express.static(path\x2C options));\n    }\n    setBaseViewsDir(path) {\n        return this.set('views'\x2C path);\n    }\n    setViewEngine(engine) {\n        return this.set('view engine'\x2C engine);\n    }\n    getRequestHostname(request) {\n        return request.hostname;\n    }\n    getRequestMethod(request) {\n        return request.method;\n    }\n    getRequestUrl(request) {\n        return request.originalUrl;\n    }\n    enableCors(options) {\n        return this.use(cors(options));\n    }\n    createMiddlewareFactory(requestMethod) {\n        return (path\x2C callback) => {\n            try {\n                const convertedPath = LegacyRouteConverter.tryConvert(path);\n                return this.routerMethodFactory\n                    .get(this.instance\x2C requestMethod)\n                    .call(this.instance\x2C convertedPath\x2C callback);\n            }\n            catch (e) {\n                if (e instanceof TypeError) {\n                    LegacyRouteConverter.printError(path);\n                }\n                throw e;\n            }\n        };\n    }\n    initHttpServer(options) {\n        const isHttpsEnabled = options && options.httpsOptions;\n        if (isHttpsEnabled) {\n            this.httpServer = https.createServer(options.httpsOptions\x2C this.getInstance());\n        }\n        else {\n            this.httpServer = http.createServer(this.getInstance());\n        }\n        if (options?.return503OnClosing) {\n            this.instance.use((req\x2C res\x2C next) => {\n                if (this.isShuttingDown) {\n                    res.set('Connection'\x2C 'close');\n                    res.status(503).send('Service Unavailable');\n                }\n                else {\n                    next();\n                }\n            });\n        }\n        if (options?.forceCloseConnections) {\n            this.trackOpenConnections();\n        }\n    }\n    registerParserMiddleware(prefix\x2C rawBody) {\n        const bodyParserJsonOptions = getBodyParserOptions('json'\x2C rawBody);\n        const bodyParserUrlencodedOptions = getBodyParserOptions('urlencoded'\x2C rawBody\x2C { extended: true });\n        const parserMiddleware = {\n            jsonParser: express.json(bodyParserJsonOptions)\x2C\n            urlencodedParser: express.urlencoded(bodyParserUrlencodedOptions)\x2C\n        };\n        Object.keys(parserMiddleware)\n            .filter(parser => !this.isMiddlewareApplied(parser))\n            .forEach(parserKey => this.use(parserMiddleware[parserKey]));\n    }\n    useBodyParser(type\x2C rawBody\x2C options) {\n        const parserOptions = getBodyParserOptions(type\x2C rawBody\x2C options);\n        const parser = express[type](parserOptions);\n        this.use(parser);\n        return this;\n    }\n    setLocal(key\x2C value) {\n        this.instance.locals[key] = value;\n        return this;\n    }\n    getType() {\n        return 'express';\n    }\n    isRouteOrderSensitive() {\n        return true;\n    }\n    applyVersionFilter(handler\x2C version\x2C versioningOptions) {\n        const callNextHandler = (req\x2C res\x2C next) => {\n            if (!next) {\n                throw new InternalServerErrorException('HTTP adapter does not support filtering on version');\n            }\n            return next();\n        };\n        if (version === VERSION_NEUTRAL ||\n            // URL Versioning is done via the path\x2C so the filter continues forward\n            versioningOptions.type === VersioningType.URI) {\n            const handlerForNoVersioning = (req\x2C res\x2C next) => handler(req\x2C res\x2C next);\n            return handlerForNoVersioning;\n        }\n        // Custom Extractor Versioning Handler\n        if (versioningOptions.type === VersioningType.CUSTOM) {\n            const handlerForCustomVersioning = (req\x2C res\x2C next) => {\n                const extractedVersion = versioningOptions.extractor(req);\n                if (Array.isArray(version)) {\n                    if (Array.isArray(extractedVersion) &&\n                        version.filter(v => extractedVersion.includes(v)).length) {\n                        return handler(req\x2C res\x2C next);\n                    }\n                    if (isString(extractedVersion) &&\n                        version.includes(extractedVersion)) {\n                        return handler(req\x2C res\x2C next);\n                    }\n                }\n                else if (isString(version)) {\n                    // Known bug here - if there are multiple versions supported across separate\n                    // handlers/controllers\x2C we can't select the highest matching handler.\n                    // Since this code is evaluated per-handler\x2C then we can't see if the highest\n                    // specified version exists in a different handler.\n                    if (Array.isArray(extractedVersion) &&\n                        extractedVersion.includes(version)) {\n                        return handler(req\x2C res\x2C next);\n                    }\n                    if (isString(extractedVersion) && version === extractedVersion) {\n                        return handler(req\x2C res\x2C next);\n                    }\n                }\n                return callNextHandler(req\x2C res\x2C next);\n            };\n            return handlerForCustomVersioning;\n        }\n        // Media Type (Accept Header) Versioning Handler\n        if (versioningOptions.type === VersioningType.MEDIA_TYPE) {\n            const handlerForMediaTypeVersioning = (req\x2C res\x2C next) => {\n                const MEDIA_TYPE_HEADER = 'Accept';\n                const acceptHeaderValue = req.headers?.[MEDIA_TYPE_HEADER] ||\n                    req.headers?.[MEDIA_TYPE_HEADER.toLowerCase()];\n                const acceptHeaderVersionParameter = acceptHeaderValue\n                    ? acceptHeaderValue.split(';')[1]\n                    : undefined;\n                // No version was supplied\n                if (isUndefined(acceptHeaderVersionParameter)) {\n                    if (Array.isArray(version)) {\n                        if (version.includes(VERSION_NEUTRAL)) {\n                            return handler(req\x2C res\x2C next);\n                        }\n                    }\n                }\n                else {\n                    const headerVersion = acceptHeaderVersionParameter.split(versioningOptions.key)[1];\n                    if (Array.isArray(version)) {\n                        if (version.includes(headerVersion)) {\n                            return handler(req\x2C res\x2C next);\n                        }\n                    }\n                    else if (isString(version)) {\n                        if (version === headerVersion) {\n                            return handler(req\x2C res\x2C next);\n                        }\n                    }\n                }\n                return callNextHandler(req\x2C res\x2C next);\n            };\n            return handlerForMediaTypeVersioning;\n        }\n        // Header Versioning Handler\n        if (versioningOptions.type === VersioningType.HEADER) {\n            const handlerForHeaderVersioning = (req\x2C res\x2C next) => {\n                const customHeaderVersionParameter = req.headers?.[versioningOptions.header] ||\n                    req.headers?.[versioningOptions.header.toLowerCase()];\n                // No version was supplied\n                if (isUndefined(customHeaderVersionParameter)) {\n                    if (Array.isArray(version)) {\n                        if (version.includes(VERSION_NEUTRAL)) {\n                            return handler(req\x2C res\x2C next);\n                        }\n                    }\n                }\n                else {\n                    if (Array.isArray(version)) {\n                        if (version.includes(customHeaderVersionParameter)) {\n                            return handler(req\x2C res\x2C next);\n                        }\n                    }\n                    else if (isString(version)) {\n                        if (version === customHeaderVersionParameter) {\n                            return handler(req\x2C res\x2C next);\n                        }\n                    }\n                }\n                return callNextHandler(req\x2C res\x2C next);\n            };\n            return handlerForHeaderVersioning;\n        }\n        throw new Error('Unsupported versioning options');\n    }\n    mapException(error) {\n        switch (true) {\n            // SyntaxError is thrown by Express body-parser when given invalid JSON (#422\x2C #430)\n            // URIError is thrown by Express when given a path parameter with an invalid percentage\n            // encoding\x2C e.g. '%FF' (#8915)\n            case error instanceof SyntaxError || error instanceof URIError:\n                return new BadRequestException(error.message);\n            default:\n                return error;\n        }\n    }\n    trackOpenConnections() {\n        this.httpServer.on('connection'\x2C (socket) => {\n            this.openConnections.add(socket);\n            socket.on('close'\x2C () => this.openConnections.delete(socket));\n        });\n    }\n    closeOpenConnections() {\n        for (const socket of this.openConnections) {\n            socket.destroy();\n            this.openConnections.delete(socket);\n        }\n    }\n    isMiddlewareApplied(name) {\n        const app = this.getInstance();\n        return (!!app.router &&\n            !!app.router.stack &&\n            isFunction(app.router.stack.filter) &&\n            app.router.stack.some((layer) => layer && layer.handle && layer.handle.name === name));\n    }\n    setHeaderIfNotExists(response\x2C name\x2C value) {\n        if (value !== undefined && response.getHeader(name) === undefined) {\n            const headerValue = Array.isArray(value) ? value.join('\x2C') : value;\n            response.setHeader(name\x2C headerValue);\n        }\n    }\n    applyStreamHeaders(response\x2C streamable) {\n        const headers = streamable.getHeaders();\n        this.setHeaderIfNotExists(response\x2C 'Content-Type'\x2C headers.type);\n        this.setHeaderIfNotExists(response\x2C 'Content-Disposition'\x2C headers.disposition);\n        this.setHeaderIfNotExists(response\x2C 'Content-Length'\x2C headers.length);\n    }\n}\n
