script-source,1875,node:internal/http2/util,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  Error\x2C\x0d\n  MathMax\x2C\x0d\n  Number\x2C\x0d\n  NumberIsNaN\x2C\x0d\n  ObjectKeys\x2C\x0d\n  SafeSet\x2C\x0d\n  String\x2C\x0d\n  StringFromCharCode\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst binding = internalBinding('http2');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_HTTP2_HEADER_SINGLE_VALUE\x2C\x0d\n    ERR_HTTP2_INVALID_CONNECTION_HEADERS\x2C\x0d\n    ERR_HTTP2_INVALID_PSEUDOHEADER: { HideStackFramesError: ERR_HTTP2_INVALID_PSEUDOHEADER }\x2C\x0d\n    ERR_HTTP2_INVALID_SETTING_VALUE\x2C\x0d\n    ERR_HTTP2_TOO_MANY_CUSTOM_SETTINGS\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_HTTP_TOKEN\x2C\x0d\n  }\x2C\x0d\n  getMessage\x2C\x0d\n  hideStackFrames\x2C\x0d\n  kIsNodeError\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst kSensitiveHeaders = Symbol('sensitiveHeaders');\x0d\nconst kSocket = Symbol('socket');\x0d\nconst kProxySocket = Symbol('proxySocket');\x0d\nconst kRequest = Symbol('request');\x0d\n\x0d\nconst {\x0d\n  NGHTTP2_NV_FLAG_NONE\x2C\x0d\n  NGHTTP2_NV_FLAG_NO_INDEX\x2C\x0d\n  NGHTTP2_SESSION_CLIENT\x2C\x0d\n  NGHTTP2_SESSION_SERVER\x2C\x0d\n\x0d\n  HTTP2_HEADER_STATUS\x2C\x0d\n  HTTP2_HEADER_METHOD\x2C\x0d\n  HTTP2_HEADER_AUTHORITY\x2C\x0d\n  HTTP2_HEADER_SCHEME\x2C\x0d\n  HTTP2_HEADER_PATH\x2C\x0d\n  HTTP2_HEADER_PROTOCOL\x2C\x0d\n  HTTP2_HEADER_ACCESS_CONTROL_ALLOW_CREDENTIALS\x2C\x0d\n  HTTP2_HEADER_ACCESS_CONTROL_MAX_AGE\x2C\x0d\n  HTTP2_HEADER_ACCESS_CONTROL_REQUEST_METHOD\x2C\x0d\n  HTTP2_HEADER_AGE\x2C\x0d\n  HTTP2_HEADER_AUTHORIZATION\x2C\x0d\n  HTTP2_HEADER_CONTENT_ENCODING\x2C\x0d\n  HTTP2_HEADER_CONTENT_LANGUAGE\x2C\x0d\n  HTTP2_HEADER_CONTENT_LENGTH\x2C\x0d\n  HTTP2_HEADER_CONTENT_LOCATION\x2C\x0d\n  HTTP2_HEADER_CONTENT_MD5\x2C\x0d\n  HTTP2_HEADER_CONTENT_RANGE\x2C\x0d\n  HTTP2_HEADER_CONTENT_TYPE\x2C\x0d\n  HTTP2_HEADER_COOKIE\x2C\x0d\n  HTTP2_HEADER_DATE\x2C\x0d\n  HTTP2_HEADER_DNT\x2C\x0d\n  HTTP2_HEADER_ETAG\x2C\x0d\n  HTTP2_HEADER_EXPIRES\x2C\x0d\n  HTTP2_HEADER_FROM\x2C\x0d\n  HTTP2_HEADER_HOST\x2C\x0d\n  HTTP2_HEADER_IF_MATCH\x2C\x0d\n  HTTP2_HEADER_IF_NONE_MATCH\x2C\x0d\n  HTTP2_HEADER_IF_MODIFIED_SINCE\x2C\x0d\n  HTTP2_HEADER_IF_RANGE\x2C\x0d\n  HTTP2_HEADER_IF_UNMODIFIED_SINCE\x2C\x0d\n  HTTP2_HEADER_LAST_MODIFIED\x2C\x0d\n  HTTP2_HEADER_LOCATION\x2C\x0d\n  HTTP2_HEADER_MAX_FORWARDS\x2C\x0d\n  HTTP2_HEADER_PROXY_AUTHORIZATION\x2C\x0d\n  HTTP2_HEADER_RANGE\x2C\x0d\n  HTTP2_HEADER_REFERER\x2C\x0d\n  HTTP2_HEADER_RETRY_AFTER\x2C\x0d\n  HTTP2_HEADER_SET_COOKIE\x2C\x0d\n  HTTP2_HEADER_TK\x2C\x0d\n  HTTP2_HEADER_UPGRADE_INSECURE_REQUESTS\x2C\x0d\n  HTTP2_HEADER_USER_AGENT\x2C\x0d\n  HTTP2_HEADER_X_CONTENT_TYPE_OPTIONS\x2C\x0d\n\x0d\n  HTTP2_HEADER_CONNECTION\x2C\x0d\n  HTTP2_HEADER_UPGRADE\x2C\x0d\n  HTTP2_HEADER_HTTP2_SETTINGS\x2C\x0d\n  HTTP2_HEADER_TE\x2C\x0d\n  HTTP2_HEADER_TRANSFER_ENCODING\x2C\x0d\n  HTTP2_HEADER_KEEP_ALIVE\x2C\x0d\n  HTTP2_HEADER_PROXY_CONNECTION\x2C\x0d\n\x0d\n  HTTP2_METHOD_DELETE\x2C\x0d\n  HTTP2_METHOD_GET\x2C\x0d\n  HTTP2_METHOD_HEAD\x2C\x0d\n} = binding.constants;\x0d\n\x0d\n// This set is defined strictly by the HTTP/2 specification. Only\x0d\n// :-prefixed headers defined by that specification may be added to\x0d\n// this set.\x0d\nconst kValidPseudoHeaders = new SafeSet([\x0d\n  HTTP2_HEADER_STATUS\x2C\x0d\n  HTTP2_HEADER_METHOD\x2C\x0d\n  HTTP2_HEADER_AUTHORITY\x2C\x0d\n  HTTP2_HEADER_SCHEME\x2C\x0d\n  HTTP2_HEADER_PATH\x2C\x0d\n  HTTP2_HEADER_PROTOCOL\x2C\x0d\n]);\x0d\n\x0d\n// This set contains headers that are permitted to have only a single\x0d\n// value. Multiple instances must not be specified.\x0d\nconst kSingleValueHeaders = new SafeSet([\x0d\n  HTTP2_HEADER_STATUS\x2C\x0d\n  HTTP2_HEADER_METHOD\x2C\x0d\n  HTTP2_HEADER_AUTHORITY\x2C\x0d\n  HTTP2_HEADER_SCHEME\x2C\x0d\n  HTTP2_HEADER_PATH\x2C\x0d\n  HTTP2_HEADER_PROTOCOL\x2C\x0d\n  HTTP2_HEADER_ACCESS_CONTROL_ALLOW_CREDENTIALS\x2C\x0d\n  HTTP2_HEADER_ACCESS_CONTROL_MAX_AGE\x2C\x0d\n  HTTP2_HEADER_ACCESS_CONTROL_REQUEST_METHOD\x2C\x0d\n  HTTP2_HEADER_AGE\x2C\x0d\n  HTTP2_HEADER_AUTHORIZATION\x2C\x0d\n  HTTP2_HEADER_CONTENT_ENCODING\x2C\x0d\n  HTTP2_HEADER_CONTENT_LANGUAGE\x2C\x0d\n  HTTP2_HEADER_CONTENT_LENGTH\x2C\x0d\n  HTTP2_HEADER_CONTENT_LOCATION\x2C\x0d\n  HTTP2_HEADER_CONTENT_MD5\x2C\x0d\n  HTTP2_HEADER_CONTENT_RANGE\x2C\x0d\n  HTTP2_HEADER_CONTENT_TYPE\x2C\x0d\n  HTTP2_HEADER_DATE\x2C\x0d\n  HTTP2_HEADER_DNT\x2C\x0d\n  HTTP2_HEADER_ETAG\x2C\x0d\n  HTTP2_HEADER_EXPIRES\x2C\x0d\n  HTTP2_HEADER_FROM\x2C\x0d\n  HTTP2_HEADER_HOST\x2C\x0d\n  HTTP2_HEADER_IF_MATCH\x2C\x0d\n  HTTP2_HEADER_IF_MODIFIED_SINCE\x2C\x0d\n  HTTP2_HEADER_IF_NONE_MATCH\x2C\x0d\n  HTTP2_HEADER_IF_RANGE\x2C\x0d\n  HTTP2_HEADER_IF_UNMODIFIED_SINCE\x2C\x0d\n  HTTP2_HEADER_LAST_MODIFIED\x2C\x0d\n  HTTP2_HEADER_LOCATION\x2C\x0d\n  HTTP2_HEADER_MAX_FORWARDS\x2C\x0d\n  HTTP2_HEADER_PROXY_AUTHORIZATION\x2C\x0d\n  HTTP2_HEADER_RANGE\x2C\x0d\n  HTTP2_HEADER_REFERER\x2C\x0d\n  HTTP2_HEADER_RETRY_AFTER\x2C\x0d\n  HTTP2_HEADER_TK\x2C\x0d\n  HTTP2_HEADER_UPGRADE_INSECURE_REQUESTS\x2C\x0d\n  HTTP2_HEADER_USER_AGENT\x2C\x0d\n  HTTP2_HEADER_X_CONTENT_TYPE_OPTIONS\x2C\x0d\n]);\x0d\n\x0d\n// The HTTP methods in this set are specifically defined as assigning no\x0d\n// meaning to the request payload. By default\x2C unless the user explicitly\x0d\n// overrides the endStream option on the request method\x2C the endStream\x0d\n// option will be defaulted to true when these methods are used.\x0d\nconst kNoPayloadMethods = new SafeSet([\x0d\n  HTTP2_METHOD_DELETE\x2C\x0d\n  HTTP2_METHOD_GET\x2C\x0d\n  HTTP2_METHOD_HEAD\x2C\x0d\n]);\x0d\n\x0d\n// The following ArrayBuffer instances are used to share memory more efficiently\x0d\n// with the native binding side for a number of methods. These are not intended\x0d\n// to be used directly by users in any way. The ArrayBuffers are created on\x0d\n// the native side with values that are filled in on demand\x2C the js code then\x0d\n// reads those values out. The set of IDX constants that follow identify the\x0d\n// relevant data positions within these buffers.\x0d\nconst { settingsBuffer\x2C optionsBuffer } = binding;\x0d\n\x0d\n// Note that Float64Array is used here because there is no Int64Array available\x0d\n// and these deal with numbers that can be beyond the range of Uint32 and Int32.\x0d\n// The values set on the native side will always be integers. This is not a\x0d\n// unique example of this\x2C this pattern can be found in use in other parts of\x0d\n// Node.js core as a performance optimization.\x0d\nconst { sessionState\x2C streamState } = binding;\x0d\n\x0d\nconst IDX_SETTINGS_HEADER_TABLE_SIZE = 0;\x0d\nconst IDX_SETTINGS_ENABLE_PUSH = 1;\x0d\nconst IDX_SETTINGS_INITIAL_WINDOW_SIZE = 2;\x0d\nconst IDX_SETTINGS_MAX_FRAME_SIZE = 3;\x0d\nconst IDX_SETTINGS_MAX_CONCURRENT_STREAMS = 4;\x0d\nconst IDX_SETTINGS_MAX_HEADER_LIST_SIZE = 5;\x0d\nconst IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL = 6;\x0d\nconst IDX_SETTINGS_FLAGS = 7;\x0d\n\x0d\n// Maximum number of allowed additional settings\x0d\nconst MAX_ADDITIONAL_SETTINGS = 10;\x0d\n\x0d\nconst IDX_SESSION_STATE_EFFECTIVE_LOCAL_WINDOW_SIZE = 0;\x0d\nconst IDX_SESSION_STATE_EFFECTIVE_RECV_DATA_LENGTH = 1;\x0d\nconst IDX_SESSION_STATE_NEXT_STREAM_ID = 2;\x0d\nconst IDX_SESSION_STATE_LOCAL_WINDOW_SIZE = 3;\x0d\nconst IDX_SESSION_STATE_LAST_PROC_STREAM_ID = 4;\x0d\nconst IDX_SESSION_STATE_REMOTE_WINDOW_SIZE = 5;\x0d\nconst IDX_SESSION_STATE_OUTBOUND_QUEUE_SIZE = 6;\x0d\nconst IDX_SESSION_STATE_HD_DEFLATE_DYNAMIC_TABLE_SIZE = 7;\x0d\nconst IDX_SESSION_STATE_HD_INFLATE_DYNAMIC_TABLE_SIZE = 8;\x0d\nconst IDX_STREAM_STATE = 0;\x0d\nconst IDX_STREAM_STATE_WEIGHT = 1;\x0d\nconst IDX_STREAM_STATE_SUM_DEPENDENCY_WEIGHT = 2;\x0d\nconst IDX_STREAM_STATE_LOCAL_CLOSE = 3;\x0d\nconst IDX_STREAM_STATE_REMOTE_CLOSE = 4;\x0d\nconst IDX_STREAM_STATE_LOCAL_WINDOW_SIZE = 5;\x0d\n\x0d\nconst IDX_OPTIONS_MAX_DEFLATE_DYNAMIC_TABLE_SIZE = 0;\x0d\nconst IDX_OPTIONS_MAX_RESERVED_REMOTE_STREAMS = 1;\x0d\nconst IDX_OPTIONS_MAX_SEND_HEADER_BLOCK_LENGTH = 2;\x0d\nconst IDX_OPTIONS_PEER_MAX_CONCURRENT_STREAMS = 3;\x0d\nconst IDX_OPTIONS_PADDING_STRATEGY = 4;\x0d\nconst IDX_OPTIONS_MAX_HEADER_LIST_PAIRS = 5;\x0d\nconst IDX_OPTIONS_MAX_OUTSTANDING_PINGS = 6;\x0d\nconst IDX_OPTIONS_MAX_OUTSTANDING_SETTINGS = 7;\x0d\nconst IDX_OPTIONS_MAX_SESSION_MEMORY = 8;\x0d\nconst IDX_OPTIONS_MAX_SETTINGS = 9;\x0d\nconst IDX_OPTIONS_STREAM_RESET_RATE = 10;\x0d\nconst IDX_OPTIONS_STREAM_RESET_BURST = 11;\x0d\nconst IDX_OPTIONS_FLAGS = 12;\x0d\n\x0d\nfunction updateOptionsBuffer(options) {\x0d\n  let flags = 0;\x0d\n  if (typeof options.maxDeflateDynamicTableSize === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_DEFLATE_DYNAMIC_TABLE_SIZE);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_DEFLATE_DYNAMIC_TABLE_SIZE] =\x0d\n      options.maxDeflateDynamicTableSize;\x0d\n  }\x0d\n  if (typeof options.maxReservedRemoteStreams === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_RESERVED_REMOTE_STREAMS);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_RESERVED_REMOTE_STREAMS] =\x0d\n      options.maxReservedRemoteStreams;\x0d\n  }\x0d\n  if (typeof options.maxSendHeaderBlockLength === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_SEND_HEADER_BLOCK_LENGTH);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_SEND_HEADER_BLOCK_LENGTH] =\x0d\n      options.maxSendHeaderBlockLength;\x0d\n  }\x0d\n  if (typeof options.peerMaxConcurrentStreams === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_PEER_MAX_CONCURRENT_STREAMS);\x0d\n    optionsBuffer[IDX_OPTIONS_PEER_MAX_CONCURRENT_STREAMS] =\x0d\n      options.peerMaxConcurrentStreams;\x0d\n  }\x0d\n  if (typeof options.paddingStrategy === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_PADDING_STRATEGY);\x0d\n    optionsBuffer[IDX_OPTIONS_PADDING_STRATEGY] =\x0d\n      options.paddingStrategy;\x0d\n  }\x0d\n  if (typeof options.maxHeaderListPairs === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_HEADER_LIST_PAIRS);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_HEADER_LIST_PAIRS] =\x0d\n      options.maxHeaderListPairs;\x0d\n  }\x0d\n  if (typeof options.maxOutstandingPings === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_OUTSTANDING_PINGS);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_OUTSTANDING_PINGS] =\x0d\n      options.maxOutstandingPings;\x0d\n  }\x0d\n  if (typeof options.maxOutstandingSettings === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_OUTSTANDING_SETTINGS);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_OUTSTANDING_SETTINGS] =\x0d\n      MathMax(1\x2C options.maxOutstandingSettings);\x0d\n  }\x0d\n  if (typeof options.maxSessionMemory === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_SESSION_MEMORY);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_SESSION_MEMORY] =\x0d\n      MathMax(1\x2C options.maxSessionMemory);\x0d\n  }\x0d\n  if (typeof options.maxSettings === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_MAX_SETTINGS);\x0d\n    optionsBuffer[IDX_OPTIONS_MAX_SETTINGS] =\x0d\n      MathMax(1\x2C options.maxSettings);\x0d\n  }\x0d\n  if (typeof options.streamResetRate === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_STREAM_RESET_RATE);\x0d\n    optionsBuffer[IDX_OPTIONS_STREAM_RESET_RATE] =\x0d\n      MathMax(1\x2C options.streamResetRate);\x0d\n  }\x0d\n  if (typeof options.streamResetBurst === 'number') {\x0d\n    flags |= (1 << IDX_OPTIONS_STREAM_RESET_BURST);\x0d\n    optionsBuffer[IDX_OPTIONS_STREAM_RESET_BURST] =\x0d\n      MathMax(1\x2C options.streamResetBurst);\x0d\n  }\x0d\n  optionsBuffer[IDX_OPTIONS_FLAGS] = flags;\x0d\n}\x0d\n\x0d\nfunction addCustomSettingsToObj() {\x0d\n  const toRet = {};\x0d\n  const num = settingsBuffer[IDX_SETTINGS_FLAGS + 1];\x0d\n  for (let i = 0; i < num; i++) {\x0d\n    toRet[settingsBuffer[IDX_SETTINGS_FLAGS + 1 + 2 * i + 1].toString()] =\x0d\n       Number(settingsBuffer[IDX_SETTINGS_FLAGS + 1 + 2 * i + 2]);\x0d\n  }\x0d\n  return toRet;\x0d\n}\x0d\n\x0d\nfunction getDefaultSettings() {\x0d\n  settingsBuffer[IDX_SETTINGS_FLAGS] = 0;\x0d\n  settingsBuffer[IDX_SETTINGS_FLAGS + 1] = 0; // Length of custom settings\x0d\n  binding.refreshDefaultSettings();\x0d\n  const holder = { __proto__: null };\x0d\n\x0d\n  const flags = settingsBuffer[IDX_SETTINGS_FLAGS];\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_HEADER_TABLE_SIZE)) ===\x0d\n      (1 << IDX_SETTINGS_HEADER_TABLE_SIZE)) {\x0d\n    holder.headerTableSize =\x0d\n      settingsBuffer[IDX_SETTINGS_HEADER_TABLE_SIZE];\x0d\n  }\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_ENABLE_PUSH)) ===\x0d\n      (1 << IDX_SETTINGS_ENABLE_PUSH)) {\x0d\n    holder.enablePush =\x0d\n      settingsBuffer[IDX_SETTINGS_ENABLE_PUSH] === 1;\x0d\n  }\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_INITIAL_WINDOW_SIZE)) ===\x0d\n      (1 << IDX_SETTINGS_INITIAL_WINDOW_SIZE)) {\x0d\n    holder.initialWindowSize =\x0d\n      settingsBuffer[IDX_SETTINGS_INITIAL_WINDOW_SIZE];\x0d\n  }\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_MAX_FRAME_SIZE)) ===\x0d\n      (1 << IDX_SETTINGS_MAX_FRAME_SIZE)) {\x0d\n    holder.maxFrameSize =\x0d\n      settingsBuffer[IDX_SETTINGS_MAX_FRAME_SIZE];\x0d\n  }\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_MAX_CONCURRENT_STREAMS)) ===\x0d\n      (1 << IDX_SETTINGS_MAX_CONCURRENT_STREAMS)) {\x0d\n    holder.maxConcurrentStreams =\x0d\n      settingsBuffer[IDX_SETTINGS_MAX_CONCURRENT_STREAMS];\x0d\n  }\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_MAX_HEADER_LIST_SIZE)) ===\x0d\n      (1 << IDX_SETTINGS_MAX_HEADER_LIST_SIZE)) {\x0d\n    holder.maxHeaderListSize = holder.maxHeaderSize =\x0d\n      settingsBuffer[IDX_SETTINGS_MAX_HEADER_LIST_SIZE];\x0d\n  }\x0d\n\x0d\n  if ((flags & (1 << IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL)) ===\x0d\n      (1 << IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL)) {\x0d\n    holder.enableConnectProtocol =\x0d\n      settingsBuffer[IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL] === 1;\x0d\n  }\x0d\n\x0d\n  if (settingsBuffer[IDX_SETTINGS_FLAGS + 1]) holder.customSettings = addCustomSettingsToObj();\x0d\n\x0d\n  return holder;\x0d\n}\x0d\n\x0d\n// Remote is a boolean. true to fetch remote settings\x2C false to fetch local.\x0d\n// this is only called internally\x0d\nfunction getSettings(session\x2C remote) {\x0d\n  if (remote)\x0d\n    session.remoteSettings();\x0d\n  else\x0d\n    session.localSettings();\x0d\n\x0d\n  const toRet = {\x0d\n    headerTableSize: settingsBuffer[IDX_SETTINGS_HEADER_TABLE_SIZE]\x2C\x0d\n    enablePush: !!settingsBuffer[IDX_SETTINGS_ENABLE_PUSH]\x2C\x0d\n    initialWindowSize: settingsBuffer[IDX_SETTINGS_INITIAL_WINDOW_SIZE]\x2C\x0d\n    maxFrameSize: settingsBuffer[IDX_SETTINGS_MAX_FRAME_SIZE]\x2C\x0d\n    maxConcurrentStreams: settingsBuffer[IDX_SETTINGS_MAX_CONCURRENT_STREAMS]\x2C\x0d\n    maxHeaderListSize: settingsBuffer[IDX_SETTINGS_MAX_HEADER_LIST_SIZE]\x2C\x0d\n    maxHeaderSize: settingsBuffer[IDX_SETTINGS_MAX_HEADER_LIST_SIZE]\x2C\x0d\n    enableConnectProtocol:\x0d\n      !!settingsBuffer[IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL]\x2C\x0d\n  };\x0d\n  if (settingsBuffer[IDX_SETTINGS_FLAGS + 1]) toRet.customSettings = addCustomSettingsToObj();\x0d\n  return toRet;\x0d\n}\x0d\n\x0d\nfunction updateSettingsBuffer(settings) {\x0d\n  let flags = 0;\x0d\n  let numCustomSettings = 0;\x0d\n\x0d\n  if (typeof settings.customSettings === 'object') {\x0d\n    const customSettings = settings.customSettings;\x0d\n    for (const setting in customSettings) {\x0d\n      const val = customSettings[setting];\x0d\n      if (typeof val === 'number') {\x0d\n        let set = false;\x0d\n        const nsetting = Number(setting);\x0d\n        if (NumberIsNaN(nsetting) ||\x0d\n          typeof nsetting !== 'number' ||\x0d\n          0 >= nsetting ||\x0d\n          nsetting > 0xffff)\x0d\n          throw new ERR_HTTP2_INVALID_SETTING_VALUE.RangeError(\x0d\n            'Range Error'\x2C nsetting\x2C 0\x2C 0xffff);\x0d\n        if (NumberIsNaN(val) ||\x0d\n            typeof val !== 'number' ||\x0d\n            0 >= val ||\x0d\n            val > 0xffffffff)\x0d\n          throw new ERR_HTTP2_INVALID_SETTING_VALUE.RangeError(\x0d\n            'Range Error'\x2C val\x2C 0\x2C 0xffffffff);\x0d\n        if (nsetting < IDX_SETTINGS_FLAGS) {\x0d\n          set = true;\x0d\n          switch (nsetting) {\x0d\n            case IDX_SETTINGS_HEADER_TABLE_SIZE:\x0d\n              flags |= (1 << IDX_SETTINGS_HEADER_TABLE_SIZE);\x0d\n              settingsBuffer[IDX_SETTINGS_HEADER_TABLE_SIZE] =\x0d\n                val;\x0d\n              break;\x0d\n            case IDX_SETTINGS_ENABLE_PUSH:\x0d\n              flags |= (1 << IDX_SETTINGS_ENABLE_PUSH);\x0d\n              settingsBuffer[IDX_SETTINGS_ENABLE_PUSH] = val;\x0d\n              break;\x0d\n            case IDX_SETTINGS_INITIAL_WINDOW_SIZE:\x0d\n              flags |= (1 << IDX_SETTINGS_INITIAL_WINDOW_SIZE);\x0d\n              settingsBuffer[IDX_SETTINGS_INITIAL_WINDOW_SIZE] =\x0d\n                val;\x0d\n              break;\x0d\n            case IDX_SETTINGS_MAX_FRAME_SIZE:\x0d\n              flags |= (1 << IDX_SETTINGS_MAX_FRAME_SIZE);\x0d\n              settingsBuffer[IDX_SETTINGS_MAX_FRAME_SIZE] =\x0d\n                val;\x0d\n              break;\x0d\n            case IDX_SETTINGS_MAX_CONCURRENT_STREAMS:\x0d\n              flags |= (1 << IDX_SETTINGS_MAX_CONCURRENT_STREAMS);\x0d\n              settingsBuffer[IDX_SETTINGS_MAX_CONCURRENT_STREAMS] = val;\x0d\n              break;\x0d\n            case IDX_SETTINGS_MAX_HEADER_LIST_SIZE:\x0d\n              flags |= (1 << IDX_SETTINGS_MAX_HEADER_LIST_SIZE);\x0d\n              settingsBuffer[IDX_SETTINGS_MAX_HEADER_LIST_SIZE] =\x0d\n                val;\x0d\n              break;\x0d\n            case IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL:\x0d\n              flags |= (1 << IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL);\x0d\n              settingsBuffer[IDX_SETTINGS_ENABLE_CONNECT_PROTOCOL] = val;\x0d\n              break;\x0d\n            default:\x0d\n              set = false;\x0d\n              break;\x0d\n          }\x0d\n        }\x0d\n        if (!set) { // not supported\x0d\n          let i = 0;\x0d\n          while (i < numCustomSettings) {\x0d\n            if (settingsBuffer[IDX_SETTINGS_FLAGS + 1 + 2 * i + 1] === nsetting) {\x0d\n              settingsBuffer[IDX_SETTINGS_FLAGS + 1 + 2 * i + 2] = val;\x0d\n              break;\x0d\n            }\x0d\n            i++;\x0d\n          }\x0d\n          if (i === numCustomSettings) {\x0d\n            if (numCustomSettings === MAX_ADDITIONAL_SETTINGS)\x0d\n              throw new ERR_HTTP2_TOO_MANY_CUSTOM_SETTINGS();\x0d\n\x0d\n            settingsBuffer[IDX_SETTINGS_FLAGS + 1 + 2 * numCustomSettings + 1] = nsetting;\x0d\n            settingsBuffer[IDX_SETTINGS_FLAGS + 1 + 2 * numCustomSettings + 2] = val;\x0d\n            numCustomSettings++;\x0d\n          }\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  settingsBuffer[IDX_SETTINGS_FLAGS + 1] = numCustomSettings;\x0d\n\x0d\n  if (typeof settings.headerTableSize === 'number') {\x0d\n    flags |= (1 << IDX_SETTINGS_HEADER_TABLE_SIZE);\x0d\n    settingsBuffer[IDX_SETTINGS_HEADER_TABLE_SIZE] =\x0d\n      settings.headerTableSize;\x0d\n  }\x0d\n  if (typeof settings.maxConcurrentStreams === 'number') {\x0d\n    flags |= (1 << IDX_SETTINGS_MAX_CONCURRENT_STREAMS);\x0d\n    settingsBuffer[IDX_SETTINGS_MAX_CONCURRENT_STREAMS] =\x0d\n      settings.maxConcurrentStreams;\x0d\n  }\x0d\n  if (typeof settings.initialWindowSize === 'number') {\x0d\n    flags |= (1 << IDX_SETTINGS_INITIAL_WINDOW_SIZE);\x0d\n    settingsBuffer[IDX_SETTINGS_INITIAL_WINDOW_SIZE] =\x0d\n      settings.initialWindowSize;\x0d\n  }\x0d\n  if (typeof settings.maxFrameSize === 'number') {\x0d\n    flags |= (1 << IDX_SETTINGS_MAX_FRAME_SIZE);\x0d\n    settingsBuffer[IDX_SETTINGS_MAX_FRAME_SIZE] =\x0d\n      settings.maxFrameSize;\x0d\n  }\x0d\n  if (typeof settings.maxHeaderListSize === 'number' ||\x0d\n      typeof settings.maxHeaderSize === 'number') {\x0d\n    flags |= (1 << IDX_SETTINGS_MAX_HEADER_LIST_SIZE);\x0d\n    if (settings.maxHeaderSize !== 