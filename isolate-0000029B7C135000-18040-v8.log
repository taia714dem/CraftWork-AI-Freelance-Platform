eStart = index;\n    index = skipValue(header\x2C index\x2C len\x2C stopChar);\n    const valueEnd = trailingOWS(header\x2C valueStart\x2C index);\n    const type = header.slice(valueStart\x2C valueEnd).toLowerCase();\n    if (options?.parameters === false) {\n        return { type\x2C index\x2C parameters: new NullObject() };\n    }\n    return parseParameters(header\x2C type\x2C index\x2C len\x2C stopChar);\n}\nconst SP = 32; // " "\nconst HTAB = 9; // "\\t"\nconst SEMI = 59; // ";"\nconst EQ = 61; // "="\nconst DQUOTE = 34; // '"'\nconst BSLASH = 92; // "\\\\"\nconst COMMA = 44; // "\x2C"\n/**\n * Parses the parameters of a `Content-Type` header starting at the given index.\n */\nfunction parseParameters(header\x2C type\x2C index\x2C len\x2C stopChar) {\n    const parameters = new NullObject();\n    parameter: while (index < len) {\n        if (header.charCodeAt(index) === stopChar)\n            break;\n        index = skipOWS(header\x2C index + 1 /* Skip over ; */\x2C len);\n        const keyStart = index;\n        while (index < len) {\n            const code = header.charCodeAt(index);\n            if (code === stopChar)\n                break parameter;\n            if (code === SEMI)\n                continue parameter;\n            if (code === EQ) {\n                const keyEnd = trailingOWS(header\x2C keyStart\x2C index);\n                const key = header.slice(keyStart\x2C keyEnd).toLowerCase();\n                index = skipOWS(header\x2C index + 1\x2C len);\n                if (index < len && header.charCodeAt(index) === DQUOTE) {\n                    index++;\n                    let value = "";\n                    while (index < len) {\n                        const code = header.charCodeAt(index++);\n                        if (code === DQUOTE) {\n                            index = skipValue(header\x2C index\x2C len\x2C stopChar);\n                            if (parameters[key] === undefined)\n                                parameters[key] = value;\n                            break;\n                        }\n                        if (code === BSLASH && index < len) {\n                            value += header[index++];\n                            continue;\n                        }\n                        value += String.fromCharCode(code);\n                    }\n                    continue parameter;\n                }\n                const valueStart = index;\n                index = skipValue(header\x2C index\x2C len\x2C stopChar);\n                if (parameters[key] === undefined) {\n                    const valueEnd = trailingOWS(header\x2C valueStart\x2C index);\n                    parameters[key] = header.slice(valueStart\x2C valueEnd);\n                }\n                continue parameter;\n            }\n            index++;\n        }\n    }\n    return { type\x2C index\x2C parameters };\n}\n/**\n * Skip over characters until a semicolon or other exit character.\n */\nfunction skipValue(str\x2C index\x2C len\x2C stopChar) {\n    while (index < len) {\n        const code = str.charCodeAt(index);\n        if (code === SEMI || code === stopChar)\n            break;\n        index++;\n    }\n    return index;\n}\n/**\n * Skip optional whitespace (OWS) in an HTTP header value.\n *\n * OWS is defined in RFC 9110 sec 5.6.3 as SP (" ") or HTAB ("\\t").\n */\nfunction skipOWS(header\x2C index\x2C len) {\n    while (index < len) {\n        const char = header.charCodeAt(index);\n        if (char !== SP && char !== HTAB)\n            break;\n        index++;\n    }\n    return index;\n}\n/**\n * Trim optional whitespace (OWS) from the end of a substring.\n *\n * OWS is defined in RFC 9110 sec 5.6.3 as SP (" ") or HTAB ("\\t").\n */\nfunction trailingOWS(header\x2C start\x2C end) {\n    while (end > start) {\n        const char = header.charCodeAt(end - 1);\n        if (char !== SP && char !== HTAB)\n            break;\n        end--;\n    }\n    return end;\n}\n/**\n * Serialize a paramet