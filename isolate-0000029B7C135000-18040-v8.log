x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  configSecureContext\x2C\x0d\n} = require('internal/tls/secure-context');\x0d\n\x0d\nfunction toV(which\x2C v\x2C def) {\x0d\n  v ??= def;\x0d\n  if (v === 'TLSv1') return TLS1_VERSION;\x0d\n  if (v === 'TLSv1.1') return TLS1_1_VERSION;\x0d\n  if (v === 'TLSv1.2') return TLS1_2_VERSION;\x0d\n  if (v === 'TLSv1.3') return TLS1_3_VERSION;\x0d\n  throw new ERR_TLS_INVALID_PROTOCOL_VERSION(v\x2C which);\x0d\n}\x0d\n\x0d\nconst {\x0d\n  SecureContext: NativeSecureContext\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nfunction SecureContext(secureProtocol\x2C secureOptions\x2C minVersion\x2C maxVersion) {\x0d\n  if (!(this instanceof SecureContext)) {\x0d\n    return new SecureContext(secureProtocol\x2C secureOptions\x2C minVersion\x2C\x0d\n                             maxVersion);\x0d\n  }\x0d\n\x0d\n  if (secureProtocol) {\x0d\n    if (minVersion != null)\x0d\n      throw new ERR_TLS_PROTOCOL_VERSION_CONFLICT(minVersion\x2C secureProtocol);\x0d\n    if (maxVersion != null)\x0d\n      throw new ERR_TLS_PROTOCOL_VERSION_CONFLICT(maxVersion\x2C secureProtocol);\x0d\n  }\x0d\n\x0d\n  this.context = new NativeSecureContext();\x0d\n  this.context.init(secureProtocol\x2C\x0d\n                    toV('minimum'\x2C minVersion\x2C tls.DEFAULT_MIN_VERSION)\x2C\x0d\n                    toV('maximum'\x2C maxVersion\x2C tls.DEFAULT_MAX_VERSION));\x0d\n\x0d\n  if (secureOptions) {\x0d\n    validateInteger(secureOptions\x2C 'secureOptions');\x0d\n    this.context.setOptions(secureOptions);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction createSecureContext(options) {\x0d\n  options ||= kEmptyObject;\x0d\n  const {\x0d\n    honorCipherOrder\x2C\x0d\n    minVersion\x2C\x0d\n    maxVersion\x2C\x0d\n    secureProtocol\x2C\x0d\n  } = options;\x0d\n\x0d\n  let { secureOptions } = options;\x0d\n\x0d\n  if (honorCipherOrder)\x0d\n    secureOptions |= SSL_OP_CIPHER_SERVER_PREFERENCE;\x0d\n\x0d\n  const c = new SecureContext(secureProtocol\x2C secureOptions\x2C\x0d\n                              minVersion\x2C maxVersion);\x0d\n\x0d\n  configSecureContext(c.context\x2C options);\x0d\n\x0d\n  return c;\x0d\n}\x0d\n\x0d\n// Translate some fields from the handle's C-friendly format into more idiomatic\x0d\n// javascript object representations before passing them back to the user.  Can\x0d\n// be used on any cert object\x2C but changing the name would be semver-major.\x0d\nfunction translatePeerCertificate(c) {\x0d\n  if (!c)\x0d\n    return null;\x0d\n\x0d\n  if (c.issuerCertificate != null && c.issuerCertificate !== c) {\x0d\n    c.issuerCertificate = translatePeerCertificate(c.issuerCertificate);\x0d\n  }\x0d\n  if (c.infoAccess != null) {\x0d\n    const info = c.infoAccess;\x0d\n    c.infoAccess = { __proto__: null };\x0d\n\x0d\n    // XXX: More key validation?\x0d\n    info.replace(/([^\\n:]*):([^\\n]*)(?:\\n|$)/g\x2C\x0d\n                 (all\x2C key\x2C val) => {\x0d\n                   if (val.charCodeAt(0) === 0x22) {\x0d\n                     // The translatePeerCertificate function is only\x0d\n                     // used on internally created legacy certificate\x0d\n                     // objects\x2C and any value that contains a quote\x0d\n                     // will always be a valid JSON string literal\x2C\x0d\n                     // so this should never throw.\x0d\n                     val = JSONParse(val);\x0d\n                   }\x0d\n                   if (key in c.infoAccess)\x0d\n                     c.infoAccess[key].push(val);\x0d\n                   else\x0d\n                     c.infoAccess[key] = [val];\x0d\n                 });\x0d\n  }\x0d\n  return c;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  SecureContext\x2C\x0d\n  createSecureContext\x2C\x0d\n  translatePeerCertificate\x2C\x0d\n};\x0d\n
