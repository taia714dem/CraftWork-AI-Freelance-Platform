script-source,1303,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/pipes/pipes-consumer.js,import { ParamsTokenFactory } from './params-token-factory.js';\nexport class PipesConsumer {\n    paramsTokenFactory = new ParamsTokenFactory();\n    async apply(value\x2C metadata\x2C pipes) {\n        const token = this.paramsTokenFactory.exchangeEnumForString(metadata.type);\n        return this.applyPipes(value\x2C {\n            metatype: metadata.metatype\x2C\n            type: token\x2C\n            data: metadata.data\x2C\n            schema: metadata.schema\x2C\n        }\x2C pipes);\n    }\n    async applyPipes(value\x2C { metatype\x2C type\x2C data\x2C schema }\x2C transforms) {\n        let result = value;\n        for (const pipe of transforms) {\n            result = await pipe.transform(result\x2C { metatype\x2C type\x2C data\x2C schema });\n        }\n        return result;\n    }\n}\n
