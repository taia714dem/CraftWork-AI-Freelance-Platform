oreModule(options?.overrides);\n        await this.scanForModules({\n            moduleDefinition: module\x2C\n            overrides: options?.overrides\x2C\n        });\n        await this.scanModulesForDependencies();\n        this.addScopedEnhancersMetadata();\n        // Modules distance calculation should be done after all modules are scanned\n        // but before global modules are registered (linked to all modules).\n        // Global modules have their distance set to MAX anyway.\n        this.calculateModulesDistance();\n        this.container.bindGlobalScope();\n    }\n    async scanForModules({ moduleDefinition\x2C lazy\x2C scope = []\x2C ctxRegistry = []\x2C overrides = []\x2C }) {\n        const { moduleRef: moduleInstance\x2C inserted: moduleInserted } = (await this.insertOrOverrideModule(moduleDefinition\x2C overrides\x2C scope)) ??\n            {};\n        if (lazy && !moduleInserted && moduleInstance?.isInstantiated) {\n            return [];\n        }\n        moduleDefinition =\n            this.getOverrideModuleByModule(moduleDefinition\x2C overrides)?.newModule ??\n                moduleDefinition;\n        moduleDefinition =\n            moduleDefinition instanceof Promise\n                ? await moduleDefinition\n                : moduleDefinition;\n        ctxRegistry.push(moduleDefinition);\n        if (this.isForwardReference(moduleDefinition)) {\n            moduleDefinition = moduleDefinition.forwardRef();\n        }\n        const modules = !this.isDynamicModule(moduleDefinition)\n            ? this.reflectMetadata(MODULE_METADATA.IMPORTS\x2C moduleDefinition)\n            : [\n                ...this.reflectMetadata(MODULE_METADATA.IMPORTS\x2C moduleDefinition.module)\x2C\n                ...(moduleDefinition.imports || [])\x2C\n            ];\n        let registeredModuleRefs = [];\n        for (const [index\x2C innerModule] of modules.entries()) {\n            // In case of a circular dependency (ES module system)\x2C JavaScript will resolve the type to `undefined`.\n            if (innerModule === undefined) {\n                throw new UndefinedModuleException(moduleDefinition\x2C index\x2C scope);\n            }\n            if (!innerModule) {\n                throw new InvalidModuleException(moduleDefinition\x2C index\x2C scope\x2C innerModule);\n            }\n            if (ctxRegistry.includes(innerModule)) {\n                continue;\n            }\n            const moduleRefs = await this.scanForModules({\n                moduleDefinition: innerModule\x2C\n                scope: [].concat(scope\x2C moduleDefinition)\x2C\n                ctxRegistry\x2C\n                overrides\x2C\n                lazy\x2C\n            });\n            registeredModuleRefs = registeredModuleRefs.concat(moduleRefs);\n        }\n        if (!moduleInstance) {\n            return registeredModuleRefs;\n        }\n        if (lazy) {\n            this.container.bindGlobalsToImports(moduleInstance);\n        }\n        return [moduleInstance].concat(registeredModuleRefs);\n    }\n    async insertModule(moduleDefinition\x2C scope) {\n        const moduleToAdd = this.isForwardReference(moduleDefinition)\n            ? moduleDefinition.forwardRef()\n            : moduleDefinition;\n        if (this.isInjectable(moduleToAdd)) {\n            throw new InvalidClassModuleException(moduleDefinition\x2C scope\x2C 'provider');\n        }\n        if (this.isController(moduleToAdd)) {\n            throw new InvalidClassModuleException(moduleDefinition\x2C scope\x2C 'controller');\n        }\n        if (this.isExceptionFilter(moduleToAdd)) {\n            throw new InvalidClassModuleException(moduleDefinition\x2C scope\x2C 'filter');\n        }\n        return this.container.addModule(moduleToAdd\x2C scope);\n    }\n    async scanModulesForDependencies(modules = this.container.getModules()) {\n        for (const [token\x2C { metatype }] of modules) {\n            await this.reflectImports(metatype\x2C token\x2