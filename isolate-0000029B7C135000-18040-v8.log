script-source,2434,node:internal/heap_utils,'use strict';\x0d\nconst {\x0d\n  ArrayPrototypeMap\x2C\x0d\n  Symbol\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\nconst {\x0d\n  kUpdateTimer\x2C\x0d\n  onStreamRead\x2C\x0d\n} = require('internal/stream_base_commons');\x0d\nconst { owner_symbol } = require('internal/async_hooks').symbols;\x0d\nconst { Readable } = require('stream');\x0d\nconst {\x0d\n  validateObject\x2C\x0d\n  validateBoolean\x2C\x0d\n  validateFunction\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst { kEmptyObject\x2C emitExperimentalWarning } = require('internal/util');\x0d\nconst {\x0d\n  queryObjects: _queryObjects\x2C\x0d\n} = internalBinding('internal_only_v8');\x0d\nconst {\x0d\n  inspect\x2C\x0d\n} = require('internal/util/inspect');\x0d\nconst kHandle = Symbol('kHandle');\x0d\n\x0d\nfunction getHeapSnapshotOptions(options = kEmptyObject) {\x0d\n  validateObject(options\x2C 'options');\x0d\n  const {\x0d\n    exposeInternals = false\x2C\x0d\n    exposeNumericValues = false\x2C\x0d\n  } = options;\x0d\n  validateBoolean(exposeInternals\x2C 'options.exposeInternals');\x0d\n  validateBoolean(exposeNumericValues\x2C 'options.exposeNumericValues');\x0d\n  return new Uint8Array([+exposeInternals\x2C +exposeNumericValues]);\x0d\n}\x0d\n\x0d\nclass HeapSnapshotStream extends Readable {\x0d\n  constructor(handle) {\x0d\n    super({ autoDestroy: true });\x0d\n    this[kHandle] = handle;\x0d\n    handle[owner_symbol] = this;\x0d\n    handle.onread = onStreamRead;\x0d\n  }\x0d\n\x0d\n  _read() {\x0d\n    if (this[kHandle])\x0d\n      this[kHandle].readStart();\x0d\n  }\x0d\n\x0d\n  _destroy() {\x0d\n    // Release the references on the handle so that\x0d\n    // it can be garbage collected.\x0d\n    this[kHandle][owner_symbol] = undefined;\x0d\n    this[kHandle] = undefined;\x0d\n  }\x0d\n\x0d\n  [kUpdateTimer]() {\x0d\n    // Does nothing\x0d\n  }\x0d\n}\x0d\n\x0d\nconst inspectOptions = {\x0d\n  __proto__: null\x2C\x0d\n  depth: 0\x2C\x0d\n};\x0d\nfunction queryObjects(ctor\x2C options = kEmptyObject) {\x0d\n  validateFunction(ctor\x2C 'constructor');\x0d\n  if (options !== kEmptyObject) {\x0d\n    validateObject(options\x2C 'options');\x0d\n  }\x0d\n  const format = options.format || 'count';\x0d\n  if (format !== 'count' && format !== 'summary') {\x0d\n    throw new ERR_INVALID_ARG_VALUE('options.format'\x2C format);\x0d\n  }\x0d\n  emitExperimentalWarning('v8.queryObjects()');\x0d\n  // Matching the console API behavior - just access the .prototype.\x0d\n  const objects = _queryObjects(ctor.prototype);\x0d\n  if (format === 'count') {\x0d\n    return objects.length;\x0d\n  }\x0d\n  // options.format is 'summary'.\x0d\n  return ArrayPrototypeMap(objects\x2C (object) => inspect(object\x2C inspectOptions));\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  getHeapSnapshotOptions\x2C\x0d\n  HeapSnapshotStream\x2C\x0d\n  queryObjects\x2C\x0d\n};\x0d\n
