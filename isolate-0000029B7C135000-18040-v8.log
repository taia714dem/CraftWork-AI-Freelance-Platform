script-source,1870,node:internal/tls/secure-context,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  ArrayPrototypeFilter\x2C\x0d\n  ArrayPrototypeForEach\x2C\x0d\n  ArrayPrototypeJoin\x2C\x0d\n  StringPrototypeSplit\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_CRYPTO_CUSTOM_ENGINE_NOT_SUPPORTED\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  kEmptyObject\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  isArrayBufferView\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nconst {\x0d\n  validateBuffer\x2C\x0d\n  validateInt32\x2C\x0d\n  validateObject\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  toBuf\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  crypto: {\x0d\n    TLS1_2_VERSION\x2C\x0d\n    TLS1_3_VERSION\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('constants');\x0d\n\x0d\nfunction getDefaultEcdhCurve() {\x0d\n  // We do it this way because DEFAULT_ECDH_CURVE can be\x0d\n  // changed by users\x2C so we need to grab the current\x0d\n  // value\x2C but we want the evaluation to be lazy.\x0d\n  return require('tls').DEFAULT_ECDH_CURVE || 'auto';\x0d\n}\x0d\n\x0d\nfunction getDefaultCiphers() {\x0d\n  // We do it this way because DEFAULT_CIPHERS can be\x0d\n  // changed by users\x2C so we need to grab the current\x0d\n  // value\x2C but we want the evaluation to be lazy.\x0d\n  return require('tls').DEFAULT_CIPHERS;\x0d\n}\x0d\n\x0d\nfunction addCACerts(context\x2C certs\x2C name) {\x0d\n  ArrayPrototypeForEach(certs\x2C (cert) => {\x0d\n    validateKeyOrCertOption(name\x2C cert);\x0d\n    context.addCACert(cert);\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction setCerts(context\x2C certs\x2C name) {\x0d\n  ArrayPrototypeForEach(certs\x2C (cert) => {\x0d\n    validateKeyOrCertOption(name\x2C cert);\x0d\n    context.setCert(cert);\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction validateKeyOrCertOption(name\x2C value) {\x0d\n  if (typeof value !== 'string' && !isArrayBufferView(value)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE(\x0d\n      name\x2C\x0d\n      [\x0d\n        'string'\x2C\x0d\n        'Buffer'\x2C\x0d\n        'TypedArray'\x2C\x0d\n        'DataView'\x2C\x0d\n      ]\x2C\x0d\n      value\x2C\x0d\n    );\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction setKey(context\x2C key\x2C passphrase\x2C name) {\x0d\n  validateKeyOrCertOption(`${name}.key`\x2C key);\x0d\n  if (passphrase !== undefined && passphrase !== null)\x0d\n    validateString(passphrase\x2C `${name}.passphrase`);\x0d\n  context.setKey(key\x2C passphrase);\x0d\n}\x0d\n\x0d\nfunction processCiphers(ciphers\x2C name) {\x0d\n  ciphers = StringPrototypeSplit(ciphers || getDefaultCiphers()\x2C ':');\x0d\n\x0d\n  const cipherList =\x0d\n    ArrayPrototypeJoin(\x0d\n      ArrayPrototypeFilter(\x0d\n        ciphers\x2C\x0d\n        (cipher) => {\x0d\n          if (cipher.length === 0) return false;\x0d\n          if (StringPrototypeStartsWith(cipher\x2C 'TLS_')) return false;\x0d\n          if (StringPrototypeStartsWith(cipher\x2C '!TLS_')) return false;\x0d\n          return true;\x0d\n        })\x2C ':');\x0d\n\x0d\n  const cipherSuites =\x0d\n    ArrayPrototypeJoin(\x0d\n      ArrayPrototypeFilter(\x0d\n        ciphers\x2C\x0d\n        (cipher) => {\x0d\n          if (cipher.length === 0) return false;\x0d\n          if (StringPrototypeStartsWith(cipher\x2C 'TLS_')) return true;\x0d\n          if (StringPrototypeStartsWith(cipher\x2C '!TLS_')) return true;\x0d\n          return false;\x0d\n        })\x2C ':');\x0d\n\x0d\n  // Specifying empty cipher suites for both TLS1.2 and TLS1.3 is invalid\x2C its\x0d\n  // not possible to handshake with no suites.\x0d\n  if (cipherSuites === '' && cipherList === '')\x0d\n    throw new ERR_INVALID_ARG_VALUE(name\x2C ciphers);\x0d\n\x0d\n  return { cipherList\x2C cipherSuites };\x0d\n}\x0d\n\x0d\nfunction configSecureContext(context\x2C options = kEmptyObject\x2C name = 'options') {\x0d\n  validateObject(options\x2C name);\x0d\n\x0d\n  const {\x0d\n    allowPartialTrustChain\x2C\x0d\n    ca\x2C\x0d\n    cert\x2C\x0d\n    ciphers = getDefaultCiphers()\x2C\x0d\n    clientCertEngine\x2C\x0d\n    crl\x2C\x0d\n    dhparam\x2C\x0d\n    ecdhCurve = getDefaultEcdhCurve()\x2C\x0d\n    key\x2C\x0d\n    passphrase\x2C\x0d\n    pfx\x2C\x0d\n    privateKeyIdentifier\x2C\x0d\n    privateKeyEngine\x2C\x0d\n    sessionIdContext\x2C\x0d\n    sessionTimeout\x2C\x0d\n    sigalgs\x2C\x0d\n    ticketKeys\x2C\x0d\n  } = options;\x0d\n\x0d\n  // Set the cipher list and cipher suite before anything else because\x0d\n  // @SECLEVEL=<n> changes the security level and that affects subsequent\x0d\n  // operations.\x0d\n  if (ciphers !== undefined && ciphers !== null)\x0d\n    validateString(ciphers\x2C `${name}.ciphers`);\x0d\n\x0d\n  // Work around an OpenSSL API quirk. cipherList is for TLSv1.2 and below\x2C\x0d\n  // cipherSuites is for TLSv1.3 (and presumably any later versions). TLSv1.3\x0d\n  // cipher suites all have a standard name format beginning with TLS_\x2C so split\x0d\n  // the ciphers and pass them to the appropriate API.\x0d\n  const {\x0d\n    cipherList\x2C\x0d\n    cipherSuites\x2C\x0d\n  } = processCiphers(ciphers\x2C `${name}.ciphers`);\x0d\n\x0d\n  if (cipherSuites !== '')\x0d\n    context.setCipherSuites(cipherSuites);\x0d\n  context.setCiphers(cipherList);\x0d\n\x0d\n  if (cipherList === '' &&\x0d\n      context.getMinProto() < TLS1_3_VERSION &&\x0d\n      context.getMaxProto() > TLS1_2_VERSION) {\x0d\n    context.setMinProto(TLS1_3_VERSION);\x0d\n  }\x0d\n\x0d\n  // Add CA before the cert to be able to load cert's issuer in C++ code.\x0d\n  // NOTE(@jasnell): ca\x2C cert\x2C and key are permitted to be falsy\x2C so do not\x0d\n  // change the checks to !== undefined checks.\x0d\n  if (ca) {\x0d\n    addCACerts(context\x2C ArrayIsArray(ca) ? ca : [ca]\x2C `${name}.ca`);\x0d\n  } else {\x0d\n    context.addRootCerts();\x0d\n  }\x0d\n\x0d\n  if (allowPartialTrustChain) {\x0d\n    context.setAllowPartialTrustChain();\x0d\n  }\x0d\n\x0d\n  if (cert) {\x0d\n    setCerts(context\x2C ArrayIsArray(cert) ? cert : [cert]\x2C `${name}.cert`);\x0d\n  }\x0d\n\x0d\n  // Set the key after the cert.\x0d\n  // `ssl_set_pkey` returns `0` when the key does not match the cert\x2C but\x0d\n  // `ssl_set_cert` returns `1` and nullifies the key in the SSL structure\x0d\n  // which leads to the crash later on.\x0d\n  if (key) {\x0d\n    if (ArrayIsArray(key)) {\x0d\n      for (let i = 0; i < key.length; ++i) {\x0d\n        const val = key[i];\x0d\n        const pem = (\x0d\n          val?.pem !== undefined ? val.pem : val);\x0d\n        const pass = (\x0d\n          val?.passphrase !== undefined ? val.passphrase : passphrase);\x0d\n        setKey(context\x2C pem\x2C pass\x2C name);\x0d\n      }\x0d\n    } else {\x0d\n      setKey(context\x2C key\x2C passphrase\x2C name);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (sigalgs !== undefined && sigalgs !== null) {\x0d\n    validateString(sigalgs\x2C `${name}.sigalgs`);\x0d\n\x0d\n    if (sigalgs === '')\x0d\n      throw new ERR_INVALID_ARG_VALUE(`${name}.sigalgs`\x2C sigalgs);\x0d\n\x0d\n    context.setSigalgs(sigalgs);\x0d\n  }\x0d\n\x0d\n  if (privateKeyIdentifier !== undefined && privateKeyIdentifier !== null) {\x0d\n    if (privateKeyEngine === undefined || privateKeyEngine === null) {\x0d\n      // Engine is required when privateKeyIdentifier is present\x0d\n      throw new ERR_INVALID_ARG_VALUE(`${name}.privateKeyEngine`\x2C\x0d\n                                      privateKeyEngine);\x0d\n    }\x0d\n    if (key) {\x0d\n      // Both data key and engine key can't be set at the same time\x0d\n      throw new ERR_INVALID_ARG_VALUE(`${name}.privateKeyIdentifier`\x2C\x0d\n                                      privateKeyIdentifier);\x0d\n    }\x0d\n\x0d\n    if (typeof privateKeyIdentifier === 'string' &&\x0d\n        typeof privateKeyEngine === 'string') {\x0d\n      if (context.setEngineKey)\x0d\n        context.setEngineKey(privateKeyIdentifier\x2C privateKeyEngine);\x0d\n      else\x0d\n        throw new ERR_CRYPTO_CUSTOM_ENGINE_NOT_SUPPORTED();\x0d\n    } else if (typeof privateKeyIdentifier !== 'string') {\x0d\n      throw new ERR_INVALID_ARG_TYPE(`${name}.privateKeyIdentifier`\x2C\x0d\n                                     ['string'\x2C 'null'\x2C 'undefined']\x2C\x0d\n                                     privateKeyIdentifier);\x0d\n    } else {\x0d\n      throw new ERR_INVALID_ARG_TYPE(`${name}.privateKeyEngine`\x2C\x0d\n                                     ['string'\x2C 'null'\x2C 'undefined']\x2C\x0d\n                                     privateKeyEngine);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  validateString(ecdhCurve\x2C `${name}.ecdhCurve`);\x0d\n  context.setECDHCurve(ecdhCurve);\x0d\n\x0d\n  if (dhparam !== undefined && dhparam !== null) {\x0d\n    validateKeyOrCertOption(`${name}.dhparam`\x2C dhparam);\x0d\n    const warning = context.setDHParam(dhparam === 'auto' || dhparam);\x0d\n    if (warning)\x0d\n      process.emitWarning(warning\x2C 'SecurityWarning');\x0d\n  }\x0d\n\x0d\n  if (crl !== undefined && crl !== null) {\x0d\n    if (ArrayIsArray(crl)) {\x0d\n      for (const val of crl) {\x0d\n        validateKeyOrCertOption(`${name}.crl`\x2C val);\x0d\n        context.addCRL(val);\x0d\n      }\x0d\n    } else {\x0d\n      validateKeyOrCertOption(`${name}.crl`\x2C crl);\x0d\n      context.addCRL(crl);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (sessionIdContext !== undefined && sessionIdContext !== null) {\x0d\n    validateString(sessionIdContext\x2C `${name}.sessionIdContext`);\x0d\n    context.setSessionIdContext(sessionIdContext);\x0d\n  }\x0d\n\x0d\n  if (pfx !== undefined && pfx !== null) {\x0d\n    if (ArrayIsArray(pfx)) {\x0d\n      ArrayPrototypeForEach(pfx\x2C (val) => {\x0d\n        const raw = val.buf || val;\x0d\n        const pass = val.passphrase || passphrase;\x0d\n        if (pass !== undefined && pass !== null) {\x0d\n          context.loadPKCS12(toBuf(raw)\x2C toBuf(pass));\x0d\n        } else {\x0d\n          context.loadPKCS12(toBuf(raw));\x0d\n        }\x0d\n      });\x0d\n    } else if (passphrase) {\x0d\n      context.loadPKCS12(toBuf(pfx)\x2C toBuf(passphrase));\x0d\n    } else {\x0d\n      context.loadPKCS12(toBuf(pfx));\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (typeof clientCertEngine === 'string') {\x0d\n    if (typeof context.setClientCertEngine !== 'function')\x0d\n      throw new ERR_CRYPTO_CUSTOM_ENGINE_NOT_SUPPORTED();\x0d\n    else\x0d\n      context.setClientCertEngine(clientCertEngine);\x0d\n  } else if (clientCertEngine !== undefined && clientCertEngine !== null) {\x0d\n    throw new ERR_INVALID_ARG_TYPE(`${name}.clientCertEngine`\x2C\x0d\n                                   ['string'\x2C 'null'\x2C 'undefined']\x2C\x0d\n                                   clientCertEngine);\x0d\n  }\x0d\n\x0d\n  if (ticketKeys !== undefined && ticketKeys !== null) {\x0d\n    validateBuffer(ticketKeys\x2C `${name}.ticketKeys`);\x0d\n    if (ticketKeys.byteLength !== 48) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        `${name}.ticketKeys`\x2C\x0d\n        ticketKeys.byteLength\x2C\x0d\n        'must be exactly 48 bytes');\x0d\n    }\x0d\n    context.setTicketKeys(ticketKeys);\x0d\n  }\x0d\n\x0d\n  if (sessionTimeout !== undefined && sessionTimeout !== null) {\x0d\n    validateInt32(sessionTimeout\x2C `${name}.sessionTimeout`\x2C 0);\x0d\n    context.setSessionTimeout(sessionTimeout);\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  configSecureContext\x2C\x0d\n};\x0d\n
