\x0d\nconst { getRootCertificates\x2C getSSLCiphers } = internalBinding('crypto');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst { canonicalizeIP } = internalBinding('cares_wrap');\x0d\nconst _tls_common = require('_tls_common');\x0d\nconst _tls_wrap = require('_tls_wrap');\x0d\nconst { createSecurePair } = require('internal/tls/secure-pair');\x0d\n\x0d\n// Allow {CLIENT_RENEG_LIMIT} client-initiated session renegotiations\x0d\n// every {CLIENT_RENEG_WINDOW} seconds. An error event is emitted if more\x0d\n// renegotiations are seen. The settings are applied to all remote client\x0d\n// connections.\x0d\nexports.CLIENT_RENEG_LIMIT = 3;\x0d\nexports.CLIENT_RENEG_WINDOW = 600;\x0d\n\x0d\nexports.DEFAULT_CIPHERS = getOptionValue('--tls-cipher-list');\x0d\n\x0d\nexports.DEFAULT_ECDH_CURVE = 'auto';\x0d\n\x0d\nif (getOptionValue('--tls-min-v1.0'))\x0d\n  exports.DEFAULT_MIN_VERSION = 'TLSv1';\x0d\nelse if (getOptionValue('--tls-min-v1.1'))\x0d\n  exports.DEFAULT_MIN_VERSION = 'TLSv1.1';\x0d\nelse if (getOptionValue('--tls-min-v1.2'))\x0d\n  exports.DEFAULT_MIN_VERSION = 'TLSv1.2';\x0d\nelse if (getOptionValue('--tls-min-v1.3'))\x0d\n  exports.DEFAULT_MIN_VERSION = 'TLSv1.3';\x0d\nelse\x0d\n  exports.DEFAULT_MIN_VERSION = 'TLSv1.2';\x0d\n\x0d\nif (getOptionValue('--tls-max-v1.3'))\x0d\n  exports.DEFAULT_MAX_VERSION = 'TLSv1.3';\x0d\nelse if (getOptionValue('--tls-max-v1.2'))\x0d\n  exports.DEFAULT_MAX_VERSION = 'TLSv1.2';\x0d\nelse\x0d\n  exports.DEFAULT_MAX_VERSION = 'TLSv1.3'; // Will depend on node version.\x0d\n\x0d\n\x0d\nexports.getCiphers = internalUtil.cachedResult(\x0d\n  () => internalUtil.filterDuplicateStrings(getSSLCiphers()\x2C true)\x2C\x0d\n);\x0d\n\x0d\nlet rootCertificates;\x0d\n\x0d\nfunction cacheRootCertificates() {\x0d\n  rootCertificates = ObjectFreeze(getRootCertificates());\x0d\n}\x0d\n\x0d\nObjectDefineProperty(exports\x2C 'rootCertificates'\x2C {\x0d\n  __proto__: null\x2C\x0d\n  configurable: false\x2C\x0d\n  enumerable: true\x2C\x0d\n  get: () => {\x0d\n    // Out-of-line caching to promote inlining the getter.\x0d\n    if (!rootCertificates) cacheRootCertificates();\x0d\n    return rootCertificates;\x0d\n  }\x2C\x0d\n});\x0d\n\x0d\n// Convert protocols array into valid OpenSSL protocols list\x0d\n// ("\\x06spdy/2\\x08http/1.1\\x08http/1.0")\x0d\nfunction convertProtocols(protocols) {\x0d\n  const lens = new Array(protocols.length);\x0d\n  const buff = Buffer.allocUnsafe(protocols.reduce((p\x2C c\x2C i) => {\x0d\n    const len = Buffer.byteLength(c);\x0d\n    if (len > 255) {\x0d\n      throw new ERR_OUT_OF_RANGE('The byte length of the protocol at index ' +\x0d\n        `${i} exceeds the maximum length.`\x2C '<= 255'\x2C len\x2C true);\x0d\n    }\x0d\n    lens[i] = len;\x0d\n    return p + 1 + len;\x0d\n  }\x2C 0));\x0d\n\x0d\n  let offset = 0;\x0d\n  for (let i = 0\x2C c = protocols.length; i < c; i++) {\x0d\n    buff[offset++] = lens[i];\x0d\n    buff.write(protocols[i]\x2C offset);\x0d\n    offset += lens[i];\x0d\n  }\x0d\n\x0d\n  return buff;\x0d\n}\x0d\n\x0d\nexports.convertALPNProtocols = function convertALPNProtocols(protocols\x2C out) {\x0d\n  // If protocols is Array - translate it into buffer\x0d\n  if (ArrayIsArray(protocols)) {\x0d\n    out.ALPNProtocols = convertProtocols(protocols);\x0d\n  } else if (isUint8Array(protocols)) {\x0d\n    // Copy new buffer not to be modified by user.\x0d\n    out.ALPNProtocols = Buffer.from(protocols);\x0d\n  } else if (isArrayBufferView(protocols)) {\x0d\n    out.ALPNProtocols = Buffer.from(protocols.buffer.slice(\x0d\n      protocols.byteOffset\x2C\x0d\n      protocols.byteOffset + protocols.byteLength\x2C\x0d\n    ));\x0d\n  }\x0d\n};\x0d\n\x0d\nfunction unfqdn(host) {\x0d\n  return host.replace(/[.]$/\x2C '');\x0d\n}\x0d\n\x0d\n// String#toLowerCase() is locale-sensitive so we use\x0d\n// a conservative version that only lowercases A-Z.\x0d\nfunction toLowerCase(c) {\x0d\n  return StringFromCharCode(32 + c.charCodeAt(0));\x0d\n}\x0d\n\x0d\nfunction splitHost(host) {\x0d\n  return unfqdn(host).replace(/[A-Z]/g\x2C toLowerCase).split('.');\x0d\n}\x0d\n\x0d\nfunction check(hostParts\x2C pattern\x2C wildcards) {\x0d\n  // Empty strings\x2C null\x2C undefined\x2C etc. never match.\x0d\n  if (!pattern)\x0d\n    return false;\x0d\n\x0d\n  const patternParts = splitHost(pattern);\x0d\n\x0d\n  if (hostParts.length !== patternParts.length)\x0d\n    return false;\x0d\n\x0d\n  // Pattern has empty components\x2C e.g. "bad..example.com".\x0d\n  if (patternParts.includes(''))\x0d\n    return false;\x0d\n\x0d\n  // RFC 6125 allows IDNA U-labels (Unicode) in names but we have no\x0d\n  // good way to detect their encoding or normalize them so we simply\x0d\n  // reject them.  Control characters and blanks are rejected as well\x0d\n  // because nothing good can come from accepting them.\x0d\n  const isBad = (s) => /[^\\u0021-\\u007F]/u.test(s);\x0d\n  if (patternParts.some(isBad))\x0d\n    return false;\x0d\n\x0d\n  // Check host parts from right to left first.\x0d\n  for (let i = hostParts.length - 1; i > 0; i -= 1) {\x0d\n    if (hostParts[i] !== patternParts[i])\x0d\n      return false;\x0d\n  }\x0d\n\x0d\n  const hostSubdomain = hostParts[0];\x0d\n  const patternSubdomain = patternParts[0];\x0d\n  const patternSubdomainParts = patternSubdomain.split('*');\x0d\n\x0d\n  // Short-circuit when the subdomain does not contain a wildcard.\x0d\n  // RFC 6125 does not allow wildcard substitution for components\x0d\n  // containing IDNA A-labels (Punycode) so match those verbatim.\x0d\n  if (patternSubdomainParts.length === 1 ||\x0d\n      patternSubdomain.includes('xn--'))\x0d\n    return hostSubdomain === patternSubdomain;\x0d\n\x0d\n  if (!wildcards)\x0d\n    return false;\x0d\n\x0d\n  // More than one wildcard is always wrong.\x0d\n  if (patternSubdomainParts.length > 2)\x0d\n    return false;\x0d\n\x0d\n  // *.tld wildcards are not allowed.\x0d\n  if (patternParts.length <= 2)\x0d\n    return false;\x0d\n\x0d\n  const { 0: prefix\x2C 1: suffix } = patternSubdomainParts;\x0d\n\x0d\n  if (prefix.length + suffix.length > hostSubdomain.length)\x0d\n    return false;\x0d\n\x0d\n  if (!hostSubdomain.startsWith(prefix))\x0d\n    return false;\x0d\n\x0d\n  if (!hostSubdomain.endsWith(suffix))\x0d\n    return false;\x0d\n\x0d\n  return true;\x0d\n}\x0d\n\x0d\n// This pattern is used to determine the length of escaped sequences within\x0d\n// the subject alt names string. It allows any valid JSON string literal.\x0d\n// This MUST match the JSON specification (ECMA-404 / RFC8259) exactly.\x0d\nconst jsonStringPattern =\x0d\n  // eslint-disable-next-line no-control-regex\x0d\n  /^"(?:[^"\\\\\\u0000-\\u001f]|\\\\(?:["\\\\/bfnrt]|u[0-9a-fA-F]{4}))*"/;\x0d\n\x0d\nfunction splitEscapedAltNames(altNames) {\x0d\n  const result = [];\x0d\n  let currentToken = '';\x0d\n  let offset = 0;\x0d\n  while (offset !== altNames.length) {\x0d\n    const nextSep = altNames.indexOf('\x2C'\x2C offset);\x0d\n    const nextQuote = altNames.indexOf('"'\x2C offset);\x0d\n    if (nextQuote !== -1 && (nextSep === -1 || nextQuote < nextSep)) {\x0d\n      // There is a quote character and there is no separator before the quote.\x0d\n      currentToken += altNames.substring(offset\x2C nextQuote);\x0d\n      const match = jsonStringPattern.exec(altNames.substring(nextQuote));\x0d\n      if (!match) {\x0d\n        throw new ERR_TLS_CERT_ALTNAME_FORMAT();\x0d\n      }\x0d\n      currentToken += JSONParse(match[0]);\x0d\n      offset = nextQuote + match[0].length;\x0d\n    } else if (nextSep !== -1) {\x0d\n      // There is a separator and no quote before it.\x0d\n      currentToken += altNames.substring(offset\x2C nextSep);\x0d\n      result.push(currentToken);\x0d\n      currentToken = '';\x0d\n      offset = nextSep + 2;\x0d\n    } else {\x0d\n      currentToken += altNames.substring(offset);\x0d\n      offset = altNames.length;\x0d\n    }\x0d\n  }\x0d\n  result.push(currentToken);\x0d\n  return result;\x0d\n}\x0d\n\x0d\nexports.checkServerIdentity = function checkServerIdentity(hostname\x2C cert) {\x0d\n  const subject = cert.subject;\x0d\n  const altNames = cert.subjectaltname;\x0d\n  const dnsNames = [];\x0d\n  const ips = [];\x0d\n\x0d\n  hostname = '' + hostname;\x0d\n\x0d\n  if (altNames) {\x0d\n    const splitAltNames = altNames.includes('"') ?\x0d\n      splitEscapedAltNames(altNames) :\x0d\n      altNames.split('\x2C ');\x0d\n    splitAltNames.forEach((name) => {\x0d\n      if (name.startsWith('DNS:')) {\x0d\n        dnsNames.push(name.slice(4));\x0d\n      } else if (name.startsWith('IP Address:')) {\x0d\n        ips.push(canonicalizeIP(name.slice(11)));\x0d\n      }\x0d\n    });\x0d\n  }\x0d\n\x0d\n  let valid = false;\x0d\n  let reason = 'Unknown reason';\x0d\n\x0d\n  hostname = unfqdn(hostname);  // Remove trailing dot for error messages.\x0d\n\x0d\n  if (net.isIP(hostname)) {\x0d\n    valid = ips.includes(canonicalizeIP(hostname));\x0d\n    if (!valid)\x0d\n      reason = `IP: ${hostname} is not in the cert's list: ` + ips.join('\x2C ');\x0d\n  } else if (dnsNames.length > 0 || subject?.CN) {\x0d\n    const hostParts = splitHost(hostname);\x0d\n    const wildcard = (pattern) => check(hostParts\x2C pattern\x2C true);\x0d\n\x0d\n    if (dnsNames.length > 0) {\x0d\n      valid = dnsNames.some(wildcard);\x0d\n      if (!valid)\x0d\n        reason =\x0d\n          `Host: ${hostname}. is not in the cert's altnames: ${altNames}`;\x0d\n    } else {\x0d\n      // Match against Common Name only if no supported identifiers exist.\x0d\n      const cn = subject.CN;\x0d\n\x0d\n      if (ArrayIsArray(cn))\x0d\n        valid = cn.some(wildcard);\x0d\n      else if (cn)\x0d\n        valid = wildcard(cn);\x0d\n\x0d\n      if (!valid)\x0d\n        reason = `Host: ${hostname}. is not cert's CN: ${cn}`;\x0d\n    }\x0d\n  } else {\x0d\n    reason = 'Cert does not contain a DNS name';\x0d\n  }\x0d\n\x0d\n  if (!valid) {\x0d\n    return new ERR_TLS_CERT_ALTNAME_INVALID(reason\x2C hostname\x2C cert);\x0d\n  }\x0d\n};\x0d\n\x0d\nexports.createSecureContext = _tls_common.createSecureContext;\x0d\nexports.SecureContext = _tls_common.SecureContext;\x0d\nexports.TLSSocket = _tls_wrap.TLSSocket;\x0d\nexports.Server = _tls_wrap.Server;\x0d\nexports.createServer = _tls_wrap.createServer;\x0d\nexports.connect = _tls_wrap.connect;\x0d\n\x0d\nexports.createSecurePair = internalUtil.deprecate(\x0d\n  createSecurePair\x2C\x0d\n  'tls.createSecurePair() is deprecated. Please use ' +\x0d\n  'tls.TLSSocket instead.'\x2C 'DEP0064');\x0d\n
