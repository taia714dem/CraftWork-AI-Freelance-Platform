script-source,805,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/repl/assign-to-object.util.js,/**\n * Similar to `Object.assign` but copying properties descriptors from `source`\n * as well.\n */\nexport function assignToObject(target\x2C source) {\n    Object.defineProperties(target\x2C Object.keys(source).reduce((descriptors\x2C key) => {\n        descriptors[key] = Object.getOwnPropertyDescriptor(source\x2C key);\n        return descriptors;\n    }\x2C Object.create(null)));\n    return target;\n}\n
