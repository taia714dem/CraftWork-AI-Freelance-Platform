onst config = {\n  "previewFeatures": []\x2C\n  "clientVersion": "7.10.1"\x2C\n  "engineVersion": "d1b3f377ca835d73fd50954a5e22128b9ebdd6b8"\x2C\n  "activeProvider": "postgresql"\x2C\n  "inlineSchema": "datasource db {\\n  provider = \\"postgresql\\"\\n}\\n\\ngenerator client {\\n  provider = \\"prisma-client-js\\"\\n}\\n\\n// \ud83d\udc64 \u0411\u041b\u041e\u041a \u041f\u041e\u041b\u042c\u0417\u041e\u0412\u0410\u0422\u0415\u041b\u0415\u0419 \u0418 \u041f\u0420\u041e\u0424\u0418\u041b\u0415\u0419\\n\\nmodel Worker {\\n  id        String   @id @default(uuid())\\n  tgId      String   @unique\\n  fullName  String\\n  avatarUrl String?\\n  bio       String?\\n  createdAt DateTime @default(now())\\n  updatedAt DateTime @updatedAt\\n\\n  specializations WorkerSpecialization[]\\n  responses       Response[]\\n\\n  @@map(\\"taisia_demidova_worker\\")\\n}\\n\\nmodel WorkerSpecialization {\\n  id                String @id @default(uuid())\\n  workerId          String\\n  role              String\\n  yearsOfExperience Float\\n  grade             String @default(\\"JUNIOR\\")\\n\\n  // \u0421\u0432\u044f\u0437\u0438\\n  worker    Worker          @relation(fields: [workerId]\x2C references: [id]\x2C onDelete: Cascade)\\n  skills    WorkerSkill[]\\n  portfolio PortfolioCase[]\\n\\n  @@unique([workerId\x2C role])\\n  @@map(\\"taisia_demidova_worker_specialization\\")\\n}\\n\\nmodel WorkerSkill {\\n  id               String @id @default(uuid())\\n  specializationId String\\n  skillName        String // \\"NestJS\\"\x2C \\"React\\"\x2C \\"Figma\\"\\n\\n  specialization WorkerSpecialization @relation(fields: [specializationId]\x2C references: [id]\x2C onDelete: Cascade)\\n\\n  @@map(\\"taisia_demidova_worker_skill\\")\\n}\\n\\nmodel PortfolioCase {\\n  id                    String   @id @default(uuid())\\n  specializationId      String\\n  title                 String\\n  technical_description String\\n  client_description    String\\n  skills                String[]\\n  isCommercial