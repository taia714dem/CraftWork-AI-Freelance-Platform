script-source,239,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/helpers/external-context-creator.js,import { ForbiddenException\x2C } from '@nestjs/common';\nimport { CUSTOM_ROUTE_ARGS_METADATA\x2C isEmptyArray\x2C } from '@nestjs/common/internal';\nimport { isObservable\x2C lastValueFrom } from 'rxjs';\nimport { ExternalExceptionFilterContext } from '../exceptions/external-exception-filter-context.js';\nimport { FORBIDDEN_MESSAGE } from '../guards/constants.js';\nimport { GuardsConsumer\x2C GuardsContextCreator } from '../guards/index.js';\nimport { STATIC_CONTEXT } from '../injector/constants.js';\nimport { InterceptorsConsumer\x2C InterceptorsContextCreator\x2C } from '../interceptors/index.js';\nimport { PipesConsumer\x2C PipesContextCreator } from '../pipes/index.js';\nimport { ContextUtils } from './context-utils.js';\nimport { ExternalErrorProxy } from './external-proxy.js';\nimport { HandlerMetadataStorage } from './handler-metadata-storage.js';\nexport class ExternalContextCreator {\n    guardsContextCreator;\n    guardsConsumer;\n    interceptorsContextCreator;\n    interceptorsConsumer;\n    modulesContainer;\n    pipesContextCreator;\n    pipesConsumer;\n    filtersContextCreator;\n    contextUtils = new ContextUtils();\n    externalErrorProxy = new ExternalErrorProxy();\n    handlerMetadataStorage = new HandlerMetadataStorage();\n    container;\n    constructor(guardsContextCreator\x2C guardsConsumer\x2C interceptorsContextCreator\x2C interceptorsConsumer\x2C modulesContainer\x2C pipesContextCreator\x2C pipesConsumer\x2C filtersContextCreator) {\n        this.guardsContextCreator = guardsContextCreator;\n        this.guardsConsumer = guardsConsumer;\n        this.interceptorsContextCreator = interceptorsContextCreator;\n        this.interceptorsConsumer = interceptorsConsumer;\n        this.modulesContainer = modulesContainer;\n        this.pipesContextCreator = pipesContextCreator;\n        this.pipesConsumer = pipesConsumer;\n        this.filtersContextCreator = filtersContextCreator;\n    }\n    static fromContainer(container) {\n        const guardsContextCreator = new GuardsContextCreator(container\x2C container.applicationConfig);\n        const guardsConsumer = new GuardsConsumer();\n        const interceptorsContextCreator = new InterceptorsContextCreator(container\x2C container.applicationConfig);\n        const interceptorsConsumer = new InterceptorsConsumer();\n        const pipesContextCreator = new PipesContextCreator(container\x2C container.applicationConfig);\n        const pipesConsumer = new PipesConsumer();\n        const filtersContextCreator = new ExternalExceptionFilterContext(container\x2C container.applicationConfig);\n        const externalContextCreator = new ExternalContextCreator(guardsContextCreator\x2C guardsConsumer\x2C interceptorsContextCreator\x2C interceptorsConsumer\x2C container.getModules()\x2C pipesContextCreator\x2C pipesConsumer\x2C filtersContextCreator);\n        externalContextCreator.container = container;\n        return externalContextCreator;\n    }\n    create(instance\x2C callback\x2C methodName\x2C metadataKey\x2C paramsFactory\x2C contextId = STATIC_CONTEXT\x2C inquirerId\x2C options = {\n        interceptors: true\x2C\n        guards: true\x2C\n        filters: true\x2C\n    }\x2C contextType = 'http') {\n        const moduleKey = this.getContextModuleKey(instance.constructor);\n        const { argsLength\x2C paramtypes\x2C getParamsMetadata } = this.getMetadata(instance\x2C methodName\x2C metadataKey\x2C paramsFactory\x2C contextType);\n        const pipes = this.pipesContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId);\n        const guards = this.guardsContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId);\n        const exceptionFilter = this.filtersContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId);\n        const interceptors = options.interceptors\n            ? this.interceptorsContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId)\n            : [];\n        const paramsMetadata = getParamsMetadata(moduleKey\x2C contextId\x2C inquirerId);\n        const paramsOptions = paramsMetadata\n            ? this.contextUtils.mergeParamsMetatypes(paramsMetadata\x2C paramtypes)\n            : [];\n        const fnCanActivate = options.guards\n            ? this.createGuardsFn(guards\x2C instance\x2C callback\x2C contextType)\n            : null;\n        const fnApplyPipes = this.createPipesFn(pipes\x2C paramsOptions);\n        const handler = (initialArgs\x2C ...args) => async () => {\n            if (fnApplyPipes) {\n                await fnApplyPipes(initialArgs\x2C ...args);\n                return callback.apply(instance\x2C initialArgs);\n            }\n            return callback.apply(instance\x2C args);\n        };\n        const target = async (...args) => {\n            const initialArgs = this.contextUtils.createNullArray(argsLength);\n            fnCanActivate && (await fnCanActivate(args));\n            const result = await this.interceptorsConsumer.intercept(interceptors\x2C args\x2C instance\x2C callback\x2C handler(initialArgs\x2C ...args)\x2C contextType);\n            return this.transformToResult(result);\n        };\n        return options.filters\n            ? this.externalErrorProxy.createProxy(target\x2C exceptionFilter\x2C contextType)\n            : target;\n    }\n    getMetadata(instance\x2C methodName\x2C metadataKey\x2C paramsFactory\x2C contextType) {\n        const cacheMetadata = this.handlerMetadataStorage.get(instance\x2C methodName);\n        if (cacheMetadata) {\n            return cacheMetadata;\n        }\n        const metadata = this.contextUtils.reflectCallbackMetadata(instance\x2C methodName\x2C metadataKey || '') || {};\n        const keys = Object.keys(metadata);\n        const argsLength = this.contextUtils.getArgumentsLength(keys\x2C metadata);\n        const paramtypes = this.contextUtils.reflectCallbackParamtypes(instance\x2C methodName);\n        const contextFactory = this.contextUtils.getContextFactory(contextType\x2C instance\x2C instance[methodName]);\n        const getParamsMetadata = (moduleKey\x2C contextId = STATIC_CONTEXT\x2C inquirerId) => paramsFactory\n            ? this.exchangeKeysForValues(keys\x2C metadata\x2C moduleKey\x2C paramsFactory\x2C contextId\x2C inquirerId\x2C contextFactory)\n            : null;\n        const handlerMetadata = {\n            argsLength\x2C\n            paramtypes\x2C\n            getParamsMetadata: getParamsMetadata\x2C\n        };\n        this.handlerMetadataStorage.set(instance\x2C methodName\x2C handlerMetadata);\n        return handlerMetadata;\n    }\n    getContextModuleKey(moduleCtor) {\n        const emptyModuleKey = '';\n        if (!moduleCtor) {\n            return emptyModuleKey;\n        }\n        const moduleContainerEntries = this.modulesContainer.entries();\n        for (const [key\x2C moduleRef] of moduleContainerEntries) {\n            if (moduleRef.hasProvider(moduleCtor)) {\n                return key;\n            }\n        }\n        return emptyModuleKey;\n    }\n    exchangeKeysForValues(keys\x2C metadata\x2C moduleContext\x2C paramsFactory\x2C contextId = STATIC_CONTEXT\x2C inquirerId\x2C contextFactory = this.contextUtils.getContextFactory('http')) {\n        this.pipesContextCreator.setModuleContext(moduleContext);\n        return keys.map(key => {\n            const { index\x2C data\x2C pipes: pipesCollection\x2C schema } = metadata[key];\n            const pipes = this.pipesContextCreator.createConcreteContext(pipesCollection\x2C contextId\x2C inquirerId);\n            const type = this.contextUtils.mapParamType(key);\n            if (key.includes(CUSTOM_ROUTE_ARGS_METADATA)) {\n                const { factory } = metadata[key];\n                const customExtractValue = this.contextUtils.getCustomFactory(factory\x2C data\x2C contextFactory);\n                return {\n                    index\x2C\n                    extractValue: customExtractValue\x2C\n                    type\x2C\n                    data\x2C\n                    pipes\x2C\n                    schema\x2C\n                };\n            }\n            const numericType = Number(type);\n            const extractValue = (...args) => paramsFactory.exchangeKeyForValue(numericType\x2C data\x2C args);\n            return { index\x2C extractValue\x2C type: numericType\x2C data\x2C pipes\x2C schema };\n        });\n    }\n    createPipesFn(pipes\x2C paramsOptions) {\n        const pipesFn = async (args\x2C ...params) => {\n            const resolveParamValue = async (param) => {\n                const { index\x2C extractValue\x2C type\x2C data\x2C metatype\x2C pipes: paramPipes\x2C schema\x2C } = param;\n                const value = extractValue(...params);\n                args[index] = await this.getParamValue(value\x2C { metatype\x2C type\x2C data\x2C schema }\x2C pipes.concat(paramPipes));\n            };\n            await Promise.all(paramsOptions.map(resolveParamValue));\n        };\n        return paramsOptions.length ? pipesFn : null;\n    }\n    async getParamValue(value\x2C metadata\x2C pipes) {\n        return isEmptyArray(pipes)\n            ? value\n            : this.pipesConsumer.apply(value\x2C metadata\x2C pipes);\n    }\n    async transformToResult(resultOrDeferred) {\n        if (isObservable(resultOrDeferred)) {\n            return lastValueFrom(resultOrDeferred);\n        }\n        return resultOrDeferred;\n    }\n    createGuardsFn(guards\x2C instance\x2C callback\x2C contextType) {\n        const canActivateFn = async (args) => {\n            const canActivate = await this.guardsConsumer.tryActivate(guards\x2C args\x2C instance\x2C callback\x2C contextType);\n            if (!canActivate) {\n                throw new ForbiddenException(FORBIDDEN_MESSAGE);\n            }\n        };\n        return guards.length ? canActivateFn : null;\n    }\n    registerRequestProvider(request\x2C contextId) {\n        this.container.registerRequestProvider(request\x2C contextId);\n    }\n}\n
