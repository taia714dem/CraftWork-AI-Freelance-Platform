script-source,1871,node:_tls_wrap,// Copyright Joyent\x2C Inc. and other Node contributors.\x0d\n//\x0d\n// Permission is hereby granted\x2C free of charge\x2C to any person obtaining a\x0d\n// copy of this software and associated documentation files (the\x0d\n// "Software")\x2C to deal in the Software without restriction\x2C including\x0d\n// without limitation the rights to use\x2C copy\x2C modify\x2C merge\x2C publish\x2C\x0d\n// distribute\x2C sublicense\x2C and/or sell copies of the Software\x2C and to permit\x0d\n// persons to whom the Software is furnished to do so\x2C subject to the\x0d\n// following conditions:\x0d\n//\x0d\n// The above copyright notice and this permission notice shall be included\x0d\n// in all copies or substantial portions of the Software.\x0d\n//\x0d\n// THE SOFTWARE IS PROVIDED "AS IS"\x2C WITHOUT WARRANTY OF ANY KIND\x2C EXPRESS\x0d\n// OR IMPLIED\x2C INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\x0d\n// MERCHANTABILITY\x2C FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\x0d\n// NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM\x2C\x0d\n// DAMAGES OR OTHER LIABILITY\x2C WHETHER IN AN ACTION OF CONTRACT\x2C TORT OR\x0d\n// OTHERWISE\x2C ARISING FROM\x2C OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\x0d\n// USE OR OTHER DEALINGS IN THE SOFTWARE.\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst {\x0d\n  ObjectAssign\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  ReflectApply\x2C\x0d\n  RegExp\x2C\x0d\n  Symbol\x2C\x0d\n  SymbolFor\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  assertCrypto\x2C\x0d\n  deprecate\x2C\x0d\n  kEmptyObject\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nassertCrypto();\x0d\n\x0d\nconst { setImmediate } = require('timers');\x0d\nconst assert = require('internal/assert');\x0d\nconst crypto = require('crypto');\x0d\nconst EE = require('events');\x0d\nconst net = require('net');\x0d\nconst tls = require('tls');\x0d\nconst common = require('_tls_common');\x0d\nconst { kReinitializeHandle } = require('internal/net');\x0d\nconst JSStreamSocket = require('internal/js_stream_socket');\x0d\nconst { Buffer } = require('buffer');\x0d\nlet debug = require('internal/util/debuglog').debuglog('tls'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { TCP\x2C constants: TCPConstants } = internalBinding('tcp_wrap');\x0d\nconst tls_wrap = internalBinding('tls_wrap');\x0d\nconst { Pipe\x2C constants: PipeConstants } = internalBinding('pipe_wrap');\x0d\nconst { owner_symbol } = require('internal/async_hooks').symbols;\x0d\nconst { isArrayBufferView } = require('internal/util/types');\x0d\nconst { SecureContext: NativeSecureContext } = internalBinding('crypto');\x0d\nconst {\x0d\n  ConnResetException\x2C\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_MULTIPLE_CALLBACK\x2C\x0d\n    ERR_SOCKET_CLOSED\x2C\x0d\n    ERR_TLS_ALPN_CALLBACK_INVALID_RESULT\x2C\x0d\n    ERR_TLS_ALPN_CALLBACK_WITH_PROTOCOLS\x2C\x0d\n    ERR_TLS_DH_PARAM_SIZE\x2C\x0d\n    ERR_TLS_HANDSHAKE_TIMEOUT\x2C\x0d\n    ERR_TLS_INVALID_CONTEXT\x2C\x0d\n    ERR_TLS_INVALID_STATE\x2C\x0d\n    ERR_TLS_RENEGOTIATION_DISABLED\x2C\x0d\n    ERR_TLS_REQUIRED_SERVER_NAME\x2C\x0d\n    ERR_TLS_SESSION_ATTACK\x2C\x0d\n    ERR_TLS_SNI_FROM_SERVER\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst { onpskexchange: kOnPskExchange } = internalBinding('symbols');\x0d\nconst {\x0d\n  getOptionValue\x2C\x0d\n  getAllowUnauthorized\x2C\x0d\n} = require('internal/options');\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateBuffer\x2C\x0d\n  validateFunction\x2C\x0d\n  validateInt32\x2C\x0d\n  validateNumber\x2C\x0d\n  validateObject\x2C\x0d\n  validateString\x2C\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  InternalX509Certificate\x2C\x0d\n} = require('internal/crypto/x509');\x0d\nconst traceTls = getOptionValue('--trace-tls');\x0d\nconst tlsKeylog = getOptionValue('--tls-keylog