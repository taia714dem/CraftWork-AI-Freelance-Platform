script-source,1299,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/guards/guards-context-creator.js,import { iterate } from 'iterare';\nimport { ContextCreator } from '../helpers/context-creator.js';\nimport { STATIC_CONTEXT } from '../injector/constants.js';\nimport { GUARDS_METADATA\x2C isEmpty\x2C isFunction\x2C } from '@nestjs/common/internal';\nexport class GuardsContextCreator extends ContextCreator {\n    container;\n    config;\n    moduleContext;\n    constructor(container\x2C config) {\n        super();\n        this.container = container;\n        this.config = config;\n    }\n    create(instance\x2C callback\x2C module\x2C contextId = STATIC_CONTEXT\x2C inquirerId) {\n        this.moduleContext = module;\n        return this.createContext(instance\x2C callback\x2C GUARDS_METADATA\x2C contextId\x2C inquirerId);\n    }\n    createConcreteContext(metadata\x2C contextId = STATIC_CONTEXT\x2C inquirerId) {\n        if (isEmpty(metadata)) {\n            return [];\n        }\n        return iterate(metadata)\n            .filter((guard) => guard && (guard.name || guard.canActivate))\n            .map(guard => this.getGuardInstance(guard\x2C contextId\x2C inquirerId))\n            .filter((guard) => !!guard && isFunction(guard.canActivate))\n            .toArray();\n    }\n    getGuardInstance(metatype\x2C contextId = STATIC_CONTEXT\x2C inquirerId) {\n        const isObject = !!metatype.canActivate;\n        if (isObject) {\n            return metatype;\n        }\n        const instanceWrapper = this.getInstanceByMetatype(metatype);\n        if (!instanceWrapper) {\n            return null;\n        }\n        const instanceHost = instanceWrapper.getInstanceByContextId(this.getContextId(contextId\x2C instanceWrapper)\x2C inquirerId);\n        return instanceHost && instanceHost.instance;\n    }\n    getInstanceByMetatype(metatype) {\n        if (!this.moduleContext) {\n            return;\n        }\n        const collection = this.container.getModules();\n        const moduleRef = collection.get(this.moduleContext);\n        if (!moduleRef) {\n            return;\n        }\n        const injectables = moduleRef.injectables;\n        return injectables.get(metatype);\n    }\n    getGlobalMetadata(contextId = STATIC_CONTEXT\x2C inquirerId) {\n        if (!this.config) {\n            return [];\n        }\n        const globalGuards = this.config.getGlobalGuards();\n        if (contextId === STATIC_CONTEXT && !inquirerId) {\n            return globalGuards;\n        }\n        const scopedGuardWrappers = this.config.getGlobalRequestGuards();\n        const scopedGuards = iterate(scopedGuardWrappers)\n            .map(wrapper => wrapper.getInstanceByContextId(this.getContextId(contextId\x2C wrapper)\x2C inquirerId))\n            .filter(host => !!host)\n            .map(host => host.instance)\n            .toArray();\n        return globalGuards.concat(scopedGuards);\n    }\n}\n
