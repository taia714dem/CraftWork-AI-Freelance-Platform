ference the timer to avoid blocking of application shutdown and\x0d\n      // clear the timeout if the socket was successfully closed.\x0d\n      timer.unref();\x0d\n\x0d\n      socket.once('close'\x2C () => clearTimeout(timer));\x0d\n\x0d\n      // We don't know what to do\x2C so let's just tell the other side what's\x0d\n      // going on in a format that they *might* understand.\x0d\n      socket.end('HTTP/1.0 403 Forbidden\\r\\n' +\x0d\n                 'Content-Type: text/plain\\r\\n\\r\\n' +\x0d\n                 'Missing ALPN Protocol\x2C expected `h2` to be available.\\n' +\x0d\n                 'If this is a HTTP request: The server was not ' +\x0d\n                 'configured with the `allowHTTP1` option or a ' +\x0d\n                 'listener for the `unknownProtocol` event.\\n');\x0d\n    }\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Set up the Session\x0d\n  const session = new ServerHttp2Session(options\x2C socket\x2C this);\x0d\n\x0d\n  session.on('stream'\x2C sessionOnStream);\x0d\n  session.on('error'\x2C sessionOnError);\x0d\n  // Don't count our own internal listener.\x0d\n  session.on('priority'\x2C sessionOnPriority);\x0d\n  session[kNativeFields][kSessionPriorityListenerCount]--;\x0d\n\x0d\n  if (this.timeout)\x0d\n    session.setTimeout(this.timeout\x2C sessionOnTimeout);\x0d\n\x0d\n  socket[kServer] = this;\x0d\n\x0d\n  this.emit('session'\x2C session);\x0d\n}\x0d\n\x0d\nfunction initializeOptions(options) {\x0d\n  assertIsObject(options\x2C 'options');\x0d\n  options = { ...options };\x0d\n  assertIsObject(options.settings\x2C 'options.settings');\x0d\n  options.settings = { ...options.settings };\x0d\n\x0d\n  assertIsArray(options.remoteCustomSettings\x2C 'options.remoteCustomSettings');\x0d\n  if (options.remoteCustomSettings) {\x0d\n    options.remoteCustomSettings = [ ...options.remoteCustomSettings ];\x0d\n    if (options.remoteCustomSettings.length > MAX_ADDITIONAL_SETTINGS)\x0d\n      throw new ERR_HTTP2_TOO_MANY_CUSTOM_SETTINGS();\x0d\n  }\x0d\n\x0d\n  if (options.maxSessionInvalidFrames !== undefined)\x0d\n    validateUint32(options.maxSessionInvalidFrames\x2C 'maxSessionInvalidFrames');\x0d\n\x0d\n  if (options.maxSessionRejectedStreams !== undefined) {\x0d\n    validateUint32(\x0d\n      options.maxSessionRejectedStreams\x2C\x0d\n      'maxSessionRejectedStreams'\x2C\x0d\n    );\x0d\n  }\x0d\n\x0d\n  if (options.unknownProtocolTimeout !== undefined)\x0d\n    validateUint32(options.unknownProtocolTimeout\x2C 'unknownProtocolTimeout');\x0d\n  else\x0d\n    // TODO(danbev): is this a good default value?\x0d\n    options.unknownProtocolTimeout = 10000;\x0d\n\x0d\n\x0d\n  // Used only with allowHTTP1\x0d\n  options.Http1IncomingMessage ||= http.IncomingMessage;\x0d\n  options.Http1ServerResponse ||= http.ServerResponse;\x0d\n\x0d\n  options.Http2ServerRequest ||= Http2ServerRequest;\x0d\n  options.Http2ServerResponse ||= Http2ServerResponse;\x0d\n  return options;\x0d\n}\x0d\n\x0d\nfunction initializeTLSOptions(options\x2C servername) {\x0d\n  options = initializeOptions(options);\x0d\n\x0d\n  if (!options.ALPNCallback) {\x0d\n    options.ALPNProtocols = ['h2'];\x0d\n    if (options.allowHTTP1 === true)\x0d\n      options.ALPNProtocols.push('http/1.1');\x0d\n  }\x0d\n\x0d\n  if (servername !== undefined && !options.servername)\x0d\n    options.servername = servername;\x0d\n  return options;\x0d\n}\x0d\n\x0d\nfunction onErrorSecureServerSession(err\x2C socket) {\x0d\n  if (!this.emit('clientError'\x2C err\x2C socket))\x0d\n    socket.destroy(err);\x0d\n}\x0d\n\x0d\nclass Http2SecureServer extends TLSServer {\x0d\n  constructor(options\x2C requestListener) {\x0d\n    options = initializeTLSOptions(options);\x0d\n    super(options\x2C connectionListener);\x0d\n    this[kOptions] = options;\x0d\n    this.timeout = 0;\x0d\n    this.on('newListener'\x2C setupCompat);\x0d\n    if (options.allowHTTP1 === true) {\x0d\n      this.headersTimeout = 60_000; // Minimum between 60 seconds or requestTimeout\x0d\n      this.requestTimeout = 300_000; // 5 minutes\x0d\n      this.connectionsCheckingInterval = 30_000; // 30 seconds\x0d\n      this.on('listening'\x2C setupConnectionsTracking);\x0d\n    }\x0d\n    if (typeof requestListener === 'function')\x0d\n      this.on('request'\x2C requestListener);\x0d\n    this.on('tlsClientError'\x2C onErrorSecureServerSession);\x0d\n  }\x0d\n\x0d\n  setTimeout(msecs\x2C callback) {\x0d\n    this.timeout = msecs;\x0d\n    if (callback !== undefined) {\x0d\n      validateFunction(callback\x2C 'callback');\x0d\n      this.on('timeout'\x2C callback);\x0d\n    }\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  updateSettings(settings) {\x0d\n    assertIsObject(settings\x2C 'settings');\x0d\n    validateSettings(settings);\x0d\n    this[kOptions].settings = { ...this[kOptions].settings\x2C ...settings };\x0d\n  }\x0d\n\x0d\n  close() {\x0d\n    if (this[kOptions].allowHTTP1 === true) {\x0d\n      httpServerPreClose(this);\x0d\n    }\x0d\n    ReflectApply(TLSServer.prototype.close\x2C this\x2C arguments);\x0d\n  }\x0d\n\x0d\n  closeIdleConnections() {\x0d\n    if (this[kOptions].allowHTTP1 === true) {\x0d\n      ReflectApply(HttpServer.prototype.closeIdleConnections\x2C this\x2C arguments);\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nclass Http2Server extends NETServer {\x0d\n  constructor(options\x2C requestListener) {\x0d\n    options = initializeOptions(options);\x0d\n    super(options\x2C connectionListener);\x0d\n    this[kOptions] = options;\x0d\n    this.timeout = 0;\x0d\n    this.on('newListener'\x2C setupCompat);\x0d\n    if (typeof requestListener === 'function')\x0d\n      this.on('request'\x2C requestListener);\x0d\n  }\x0d\n\x0d\n  setTimeout(msecs\x2C callback) {\x0d\n    this.timeout = msecs;\x0d\n    if (callback !== undefined) {\x0d\n      validateFunction(callback\x2C 'callback');\x0d\n      this.on('timeout'\x2C callback);\x0d\n    }\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  updateSettings(settings) {\x0d\n    assertIsObject(settings\x2C 'settings');\x0d\n    validateSettings(settings);\x0d\n    this[kOptions].settings = { ...this[kOptions].settings\x2C ...settings };\x0d\n  }\x0d\n\x0d\n  async [SymbolAsyncDispose]() {\x0d\n    return promisify(super.close).call(this);\x0d\n  }\x0d\n}\x0d\n\x0d\nHttp2Server.prototype[EventEmitter.captureRejectionSymbol] = function(\x0d\n  err\x2C event\x2C ...args) {\x0d\n\x0d\n  switch (event) {\x0d\n    case 'stream': {\x0d\n      // TODO(mcollina): we might want to match this with what we do on\x0d\n      // the compat side.\x0d\n      const { 0: stream } = args;\x0d\n      if (stream.sentHeaders) {\x0d\n        stream.destroy(err);\x0d\n      } else {\x0d\n        stream.respond({ [HTTP2_HEADER_STATUS]: 500 });\x0d\n        stream.end();\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    case 'request': {\x0d\n      const { 1: res } = args;\x0d\n      if (!res.headersSent && !res.finished) {\x0d\n        // Don't leak headers.\x0d\n        for (const name of res.getHeaderNames()) {\x0d\n          res.removeHeader(name);\x0d\n        }\x0d\n        res.statusCode = 500;\x0d\n        res.end(http.STATUS_CODES[500]);\x0d\n      } else {\x0d\n        res.destroy();\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    default:\x0d\n      args.unshift(err\x2C event);\x0d\n      ReflectApply(net.Server.prototype[EventEmitter.captureRejectionSymbol]\x2C\x0d\n                   this\x2C args);\x0d\n  }\x0d\n};\x0d\n\x0d\nfunction setupCompat(ev) {\x0d\n  if (ev === 'request') {\x0d\n    this.removeListener('newListener'\x2C setupCompat);\x0d\n    this.on('stream'\x2C onServerStream.bind(this\x2C this[kOptions].Http2ServerRequest\x2C\x0d\n                                          this[kOptions].Http2ServerResponse));\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction socketOnClose() {\x0d\n  const session = this[kBoundSession];\x0d\n  if (session !== undefined) {\x0d\n    debugSessionObj(session\x2C 'socket closed');\x0d\n    const err = session.connecting ? new ERR_SOCKET_CLOSED() : null;\x0d\n    const state = session[kState];\x0d\n    state.streams.forEach((stream) => stream.close(NGHTTP2_CANCEL));\x0d\n    state.pendingStreams.forEach((stream) => stream.close(NGHTTP2_CANCEL));\x0d\n    session.close();\x0d\n    session[kMaybeDestroy](err);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction connect(authority\x2C options\x2C listener) {\x0d\n  if (typeof options === 'function') {\x0d\n    listener = options;\x0d\n    options = undefined;\x0d\n  }\x0d\n\x0d\n  assertIsObject(options\x2C 'options');\x0d\n  options = { ...options };\x0d\n\x0d\n  assertIsArray(options.remoteCustomSettings\x2C 'options.remoteCustomSettings');\x0d\n  if (options.remoteCustomSettings) {\x0d\n    options.remoteCustomSettings = [ ...options.remoteCustomSettings ];\x0d\n    if (options.remoteCustomSettings.length > MAX_ADDITIONAL_SETTINGS)\x0d\n      throw new ERR_HTTP2_TOO_MANY_CUSTOM_SETTINGS();\x0d\n  }\x0d\n\x0d\n  if (typeof authority === 'string')\x0d\n    authority = new URL(authority);\x0d\n\x0d\n  assertIsObject(authority\x2C 'authority'\x2C ['string'\x2C 'Object'\x2C 'URL']);\x0d\n\x0d\n  const protocol = authority.protocol || options.protocol || 'https:';\x0d\n  const port = '' + (authority.port !== '' ?\x0d\n    authority.port : (authority.protocol === 'http:' ? 80 : 443));\x0d\n  let host = 'localhost';\x0d\n\x0d\n  if (authority.hostname) {\x0d\n    host = authority.hostname;\x0d\n\x0d\n    if (host[0] === '[')\x0d\n      host = host.slice(1\x2C -1);\x0d\n  } else if (authority.host) {\x0d\n    host = authority.host;\x0d\n  }\x0d\n\x0d\n  let socket;\x0d\n  if (typeof options.createConnection === 'function') {\x0d\n    socket = options.createConnection(authority\x2C options);\x0d\n  } else {\x0d\n    switch (protocol) {\x0d\n      case 'http:':\x0d\n        socket = net.connect({ port\x2C host\x2C ...options });\x0d\n        break;\x0d\n      case 'https:':\x0d\n        socket = tls.connect(port\x2C host\x2C initializeTLSOptions(options\x2C host));\x0d\n        break;\x0d\n      default:\x0d\n        throw new ERR_HTTP2_UNSUPPORTED_PROTOCOL(protocol);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const session = new ClientHttp2Session(options\x2C socket);\x0d\n\x0d\n  session[kAuthority] = `${options.servername || host}:${port}`;\x0d\n  session[kProtocol] = protocol;\x0d\n\x0d\n  if (typeof listener === 'function')\x0d\n    session.once('connect'\x2C listener);\x0d\n\x0d\n  return session;\x0d\n}\x0d\n\x0d\n// Support util.promisify\x0d\nObjectDefineProperty(connect\x2C promisify.custom\x2C {\x0d\n  __proto__: null\x2C\x0d\n  value: (authority\x2C options) => {\x0d\n    return new Promise((resolve\x2C reject) => {\x0d\n      const server = connect(authority\x2C options\x2C () => {\x0d\n        server.removeListener('error'\x2C reject);\x0d\n        return resolve(server);\x0d\n      });\x0d\n\x0d\n      server.once('error'\x2C reject);\x0d\n    });\x0d\n  }\x2C\x0d\n});\x0d\n\x0d\nfunction createSecureServer(options\x2C handler) {\x0d\n  return new Http2SecureServer(options\x2C handler);\x0d\n}\x0d\n\x0d\nfunction createServer(options\x2C handler) {\x0d\n  if (typeof options === 'function') {\x0d\n    handler = options;\x0d\n    options = kEmptyObject;\x0d\n  }\x0d\n  return new Http2Server(options\x2C handler);\x0d\n}\x0d\n\x0d\n// Returns a Base64 encoded settings frame payload from the given\x0d\n// object. The value is suitable for passing as the value of the\x0d\n// HTTP2-Settings header frame.\x0d\nfunction getPackedSettings(settings) {\x0d\n  assertIsObject(settings\x2C 'settings');\x0d\n  validateSettings(settings);\x0d\n  updateSettingsBuffer({ ...settings });\x0d\n  return binding.packSettings();\x0d\n}\x0d\n\x0d\nfunction getUnpackedSettings(buf\x2C options = kEmptyObject) {\x0d\n  if (!isArrayBufferView(buf) || buf.length === undefined) {\x0d\n    throw new ERR_INVALID_ARG_TYPE('buf'\x2C\x0d\n                                   ['Buffer'\x2C 'TypedArray']\x2C buf);\x0d\n  }\x0d\n  if (buf.length % 6 !== 0)\x0d\n    throw new ERR_HTTP2_INVALID_PACKED_SETTINGS_LENGTH();\x0d\n  const settings = {};\x0d\n  let offset = 0;\x0d\n  while (offset < buf.length) {\x0d\n    const id = ReflectApply(readUInt16BE\x2C buf\x2C [offset]);\x0d\n    offset += 2;\x0d\n    const value = ReflectApply(readUInt32BE\x2C buf\x2C [offset]);\x0d\n    switch (id) {\x0d\n      case NGHTTP2_SETTINGS_HEADER_TABLE_SIZE:\x0d\n        settings.headerTableSize = value;\x0d\n        break;\x0d\n      case NGHTTP2_SETTINGS_ENABLE_PUSH:\x0d\n        settings.enablePush = value !== 0;\x0d\n        break;\x0d\n      case NGHTTP2_SETTINGS_MAX_CONCURRENT_STREAMS:\x0d\n        settings.maxConcurrentStreams = value;\x0d\n        break;\x0d\n      case NGHTTP2_SETTINGS_INITIAL_WINDOW_SIZE:\x0d\n        settings.initialWindowSize = value;\x0d\n        break;\x0d\n      case NGHTTP2_SETTINGS_MAX_FRAME_SIZE:\x0d\n        settings.maxFrameSize = value;\x0d\n        break;\x0d\n      case NGHTTP2_SETTINGS_MAX_HEADER_LIST_SIZE:\x0d\n        settings.maxHeaderListSize = settings.maxHeaderSize = value;\x0d\n        break;\x0d\n      case NGHTTP2_SETTINGS_ENABLE_CONNECT_PROTOCOL:\x0d\n        settings.enableConnectProtocol = value !== 0;\x0d\n        break;\x0d\n      default:\x0d\n        settings.customSettings ||= {};\x0d\n        settings.customSettings[id] = value;\x0d\n    }\x0d\n    offset += 4;\x0d\n  }\x0d\n\x0d\n  if (options != null && options.validate)\x0d\n    validateSettings(settings);\x0d\n\x0d\n  return settings;\x0d\n}\x0d\n\x0d\nfunction performServerHandshake(socket\x2C options = {}) {\x0d\n  options = initializeOptions(options);\x0d\n  return new ServerHttp2Session(options\x2C socket\x2C undefined);\x0d\n}\x0d\n\x0d\nbinding.setCallbackFunctions(\x0d\n  onSessionInternalError\x2C\x0d\n  onPriority\x2C\x0d\n  onSettings\x2C\x0d\n  onPing\x2C\x0d\n  onSessionHeaders\x2C\x0d\n  onFrameError\x2C\x0d\n  onGoawayData\x2C\x0d\n  onAltSvc\x2C\x0d\n  onOrigin\x2C\x0d\n  onStreamTrailers\x2C\x0d\n  onStreamClose\x2C\x0d\n);\x0d\n\x0d\n// Exports\x0d\nmodule.exports = {\x0d\n  connect\x2C\x0d\n  constants\x2C\x0d\n  createServer\x2C\x0d\n  createSecureServer\x2C\x0d\n  getDefaultSettings\x2C\x0d\n  getPackedSettings\x2C\x0d\n  getUnpackedSettings\x2C\x0d\n  performServerHandshake\x2C\x0d\n  sensitiveHeaders: kSensitiveHeaders\x2C\x0d\n  Http2Session\x2C\x0d\n  Http2Stream\x2C\x0d\n  ServerHttp2Session\x2C\x0d\n  Http2ServerRequest\x2C\x0d\n  Http2ServerResponse\x2C\x0d\n};\x0d\n
