te.module);\n        });\n    }\n    registerModulePathMetadata(moduleCtor\x2C modulePath) {\n        Reflect.defineMetadata(MODULE_PATH + this.modulesContainer.applicationId\x2C modulePath\x2C moduleCtor);\n    }\n    updateTargetModulesCache(moduleCtor) {\n        let moduleClassSet;\n        if (targetModulesByContainer.has(this.modulesContainer)) {\n            moduleClassSet = targetModulesByContainer.get(this.modulesContainer);\n        }\n        else {\n            moduleClassSet = new WeakSet();\n            targetModulesByContainer.set(this.modulesContainer\x2C moduleClassSet);\n        }\n        const moduleRef = Array.from(this.modulesContainer.values()).find(item => item?.metatype === moduleCtor);\n        if (!moduleRef) {\n            return;\n        }\n        moduleClassSet.add(moduleRef);\n    }\n};\nRouterModule = RouterModule_1 = __decorate([\n    Module({})\x2C\n    __param(1\x2C Inject(ROUTES))\x2C\n    __metadata("design:paramtypes"\x2C [ModulesContainer\x2C Array])\n]\x2C RouterModule);\nexport { RouterModule };\n
