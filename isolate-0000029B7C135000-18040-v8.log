ract year and add century\n  var full_year = tin.slice(4\x2C 6);\n  var century_symbol = tin.slice(6\x2C 7);\n  switch (century_symbol) {\n    case '+':\n      full_year = "18".concat(full_year);\n      break;\n    case '-':\n      full_year = "19".concat(full_year);\n      break;\n    default:\n      full_year = "20".concat(full_year);\n      break;\n  }\n  // Check date validity\n  var date = "".concat(full_year\x2C "/").concat(tin.slice(2\x2C 4)\x2C "/").concat(tin.slice(0\x2C 2));\n  if (!(0\x2C _isDate.default)(date\x2C 'YYYY/MM/DD')) {\n    return false;\n  }\n\n  // Calculate check character\n  var checksum = parseInt(tin.slice(0\x2C 6) + tin.slice(7\x2C 10)\x2C 10) % 31;\n  if (checksum < 10) {\n    return checksum === parseInt(tin.slice(10)\x2C 10);\n  }\n  checksum -= 10;\n  var letters_lookup = ['A'\x2C 'B'\x2C 'C'\x2C 'D'\x2C 'E'\x2C 'F'\x2C 'H'\x2C 'J'\x2C 'K'\x2C 'L'\x2C 'M'\x2C 'N'\x2C 'P'\x2C 'R'\x2C 'S'\x2C 'T'\x2C 'U'\x2C 'V'\x2C 'W'\x2C 'X'\x2C 'Y'];\n  return letters_lookup[checksum] === tin.slice(10);\n}\n\n/*\n * fr/nl-BE validation function\n * (Num\xe9ro national (N.N.)\x2C persons only)\n * Checks if birth date (first six digits) is valid and calculates check (last two) digits\n */\nfunction frBeCheck(tin) {\n  // Zero month/day value is acceptable\n  if (tin.slice(2\x2C 4) !== '00' || tin.slice(4\x2C 6) !== '00') {\n    // Extract date from first six digits of TIN\n    var date = "".concat(tin.slice(0\x2C 2)\x2C "/").concat(tin.slice(2\x2C 4)\x2C "/").concat(tin.slice(4\x2C 6));\n    if (!(0\x2C _isDate.default)(date\x2C 'YY/MM/DD')) {\n      return false;\n    }\n  }\n  var checksum = 97 - parseInt(tin.slice(0\x2C 9)\x2C 10) % 97;\n  var checkdigits = parseInt(tin.slice(9\x2C 11)\x2C 10);\n  if (checksum !== checkdigits) {\n    checksum = 97 - parseInt("2".concat(tin.slice(0\x2C 9))\x2C 10) % 97;\n    if (checksum !== checkdigits) {\n      return false;\n    }\n  }\n  return true;\n}\n\n/*\n * fr-FR validation function\n * (Num\xe9ro fisca