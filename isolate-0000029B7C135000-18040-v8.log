connectionListener: httpConnectionListener } = http;\x0d\nlet debug = require('internal/util/debuglog').debuglog('http2'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst debugEnabled = debug.enabled;\x0d\n\x0d\nfunction debugStream(id\x2C sessionType\x2C message\x2C ...args) {\x0d\n  if (!debugEnabled) {\x0d\n    return;\x0d\n  }\x0d\n  debug('Http2Stream %s [Http2Session %s]: ' + message\x2C\x0d\n        id\x2C sessionName(sessionType)\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction debugStreamObj(stream\x2C message\x2C ...args) {\x0d\n  const session = stream[kSession];\x0d\n  const type = session ? session[kType] : undefined;\x0d\n  debugStream(stream[kID]\x2C type\x2C message\x2C ...args);\x0d\n}\x0d\n\x0d\nfunction debugSession(sessionType\x2C message\x2C ...args) {\x0d\n  debug('Http2Session %s: ' + message\x2C sessionName(sessionType)\x2C\x0d\n        ...args);\x0d\n}\x0d\n\x0d\nfunction debugSessionObj(session\x2C message\x2C ...args) {\x0d\n  debugSession(session[kType]\x2C message\x2C ...args);\x0d\n}\x0d\n\x0d\nconst kMaxFrameSize = (2 ** 24) - 1;\x0d\nconst kMaxInt = (2 ** 32) - 1;\x0d\nconst kMaxStreams = (2 ** 32) - 1;\x0d\nconst kMaxALTSVC = (2 ** 14) - 2;\x0d\n\x0d\n// eslint-disable-next-line no-control-regex\x0d\nconst kQuotedString = /^[\\x09\\x20-\\x5b\\x5d-\\x7e\\x80-\\xff]*$/;\x0d\n\x0d\nconst { constants\x2C nameForErrorCode } = binding;\x0d\n\x0d\nconst NETServer = net.Server;\x0d\nconst TLSServer = tls.Server;\x0d\n\x0d\nconst kAlpnProtocol = Symbol('alpnProtocol');\x0d\nconst kAuthority = Symbol('authority');\x0d\nconst kEncrypted = Symbol('encrypted');\x0d\nconst kID = Symbol('id');\x0d\nconst kInit = Symbol('init');\x0d\nconst kInfoHeaders = Symbol('sent-info-headers');\x0d\nconst kLocalSettings = Symbol('local-settings');\x0d\nconst kNativeFields = Symbol('kNativeFields');\x0d\nconst kOptions = Symbol('options');\x0d\nconst kOwner = owner_symbol;\x0d\nconst kOrigin = Symbol('origin');\x0d\nconst kPendingRequestCalls = Symbol('kPendingRequestCalls');\x0d\nconst kProceed = Symbol('proceed');\x0d\nconst kProtocol = Symbol('protocol');\x0d\nconst kRemoteSettings = Symbol('remote-settings');\x0d\nconst kRequestAsyncResource = Symbol('requestAsyncResource');\x0d\nconst kSelectPadding = Symbol('select-padding');\x0d\nconst kSentHeaders = Symbol('sent-headers');\x0d\nconst kSentTrailers = Symbol('sent-trailers');\x0d\nconst kServer = Symbol('server');\x0d\nconst kState = Symbol('state');\x0d\nconst kType = Symbol('type');\x0d\nconst kWriteGeneric = Symbol('write-generic');\x0d\n\x0d\nconst {\x0d\n  kBitfield\x2C\x0d\n  kSessionPriorityListenerCount\x2C\x0d\n  kSessionFrameErrorListenerCount\x2C\x0d\n  kSessionMaxInvalidFrames\x2C\x0d\n  kSessionMaxRejectedStreams\x2C\x0d\n  kSessionUint8FieldCount\x2C\x0d\n  kSessionHasRemoteSettingsListeners\x2C\x0d\n  kSessionRemoteSettingsIsUpToDate\x2C\x0d\n  kSessionHasPingListeners\x2C\x0d\n  kSessionHasAltsvcListeners\x2C\x0d\n} = binding;\x0d\n\x0d\nconst {\x0d\n  NGHTTP2_CANCEL\x2C\x0d\n  NGHTTP2_REFUSED_STREAM\x2C\x0d\n  NGHTTP2_DEFAULT_WEIGHT\x2C\x0d\n  NGHTTP2_FLAG_END_STREAM\x2C\x0d\n  NGHTTP2_HCAT_PUSH_RESPONSE\x2C\x0d\n  NGHTTP2_HCAT_RESPONSE\x2C\x0d\n  NGHTTP2_INTERNAL_ERROR\x2C\x0d\n  NGHTTP2_NO_ERROR\x2C\x0d\n  NGHTTP2_SESSION_CLIENT\x2C\x0d\n  NGHTTP2_SESSION_SERVER\x2C\x0d\n  NGHTTP2_ERR_STREAM_ID_NOT_AVAILABLE\x2C\x0d\n  NGHTTP2_ERR_INVALID_ARGUMENT\x2C\x0d\n  NGHTTP2_ERR_STREAM_CLOSED\x2C\x0d\n  NGHTTP2_ERR_NOMEM\x2C\x0d\n\x0d\n  HTTP2_HEADER_AUTHORITY\x2C\x0d\n  HTTP2_HEADER_DATE\x2C\x0d\n  HTTP2_HEADER_METHOD\x2C\x0d\n  HTTP2_HEADER_PATH\x2C\x0d\n  HTTP2_HEADER_PROTOCOL\x2C\x0d\n  HTTP2_HEADER_SCHEME\x2C\x0d\n  HTTP2_HEADER_STATUS\x2C\x0d\n  HTTP2_HEADER_CONTENT_LENGTH\x2C\x0d\n\x0d\n  NGHTTP2_SETTINGS_HEADER_TABLE_SIZE\x2C\x0d\n  NGHTTP2_SETTINGS_ENABLE_PUSH\x2C\x0d\n  NGHTTP2_SETTINGS_MAX_CONCURRENT_STREAMS\x2C\x0d\n  NGHTTP2_SETTINGS_INITIAL_WINDOW_SIZE\x2C\x0d\n  NGHTTP2_SETTINGS_MAX_FRAME_SIZE\x2C\x0d\n  NGHTTP2_SETTINGS_MAX_HEADER_LIST_SIZE\x2C\x0d\n  NGHTTP2_SETTINGS_ENABLE_CONNECT_PROTOCOL\x2C\x0d\n\x0d\n  HTTP2_METHOD_GET\x2C\x0d\n  HTTP2_METHOD_HEAD\x2C\x0d\n  HTTP2_METHOD_CONNECT\x2C\x0d\n\x0d\n  HTTP_STATUS_CONTINUE\x2C\x0d\n  HTTP_STATUS_RESET_CONTENT\x2C\x0d\n  HTTP_STATUS_OK\x2C\x0d\n  HTTP_STATUS_NO_CONTENT\x2C\x0d\n  HTTP_STATUS_NOT_MODIFIED\x2C\x0d\n  HTTP_STATUS_SWITCHING_PROTOCOLS\x2C\x0d\n  HTTP_STATUS_MISDIRECTED_REQUEST\x2C\x0d\n\x0d\n  STREAM_OPTION_EMPTY_PAYLOAD\x2C\x0d\n  STREAM_OPTION_GET_TRAILERS\x2C\x0d\n} = constants;\x0d\n\x0d\nconst STREAM_FLAGS_PENDING = 0x0;\x0d\nconst STREAM_FLAGS_READY = 0x1;\x0d\nconst STREAM_FLAGS_CLOSED = 0x2;\x0d\nconst STREAM_FLAGS_HEADERS_SENT = 0x4;\x0d\nconst STREAM_FLAGS_HEAD_REQUEST = 0x8;\x0d\nconst STREAM_FLAGS_ABORTED = 0x10;\x0d\nconst STREAM_FLAGS_HAS_TRAILERS = 0x20;\x0d\n\x0d\nconst SESSION_FLAGS_PENDING = 0x0;\x0d\nconst SESSION_FLAGS_READY = 0x1;\x0d\nconst SESSION_FLAGS_CLOSED = 0x2;\x0d\nconst SESSION_FLAGS_DESTROYED = 0x4;\x0d\n\x0d\n// Top level to avoid creating a closure\x0d\nfunction emit(self\x2C ...args) {\x0d\n  ReflectApply(self.emit\x2C self\x2C args);\x0d\n}\x0d\n\x0d\n// Called when a new block of headers has been received for a given\x0d\n// stream. The stream may or may not be new. If the stream is new\x2C\x0d\n// create the associated Http2Stream instance and emit the 'stream'\x0d\n// event. If the stream is not new\x2C emit the 'headers' event to pass\x0d\n// the block of headers on.\x0d\nfunction onSessionHeaders(handle\x2C id\x2C cat\x2C flags\x2C headers\x2C sensitiveHeaders) {\x0d\n  const session = this[kOwner];\x0d\n  if (session.destroyed)\x0d\n    return;\x0d\n\x0d\n  const type = session[kType];\x0d\n  session[kUpdateTimer]();\x0d\n  debugStream(id\x2C type\x2C 'headers received');\x0d\n  const streams = session[kState].streams;\x0d\n\x0d\n  const endOfStream = !!(flags & NGHTTP2_FLAG_END_STREAM);\x0d\n  let stream = streams.get(id);\x0d\n\x0d\n  // Convert the array of header name value pairs into an object\x0d\n  const obj = toHeaderObject(headers\x2C sensitiveHeaders);\x0d\n\x0d\n  if (stream === undefined) {\x0d\n    if (session.closed) {\x0d\n      // We are not accepting any new streams at this point. This callback\x0d\n      // should not be invoked at this point in time\x2C but just in case it is\x2C\x0d\n      // refuse the stream using an RST_STREAM and destroy the handle.\x0d\n      handle.rstStream(NGHTTP2_REFUSED_STREAM);\x0d\n      handle.destroy();\x0d\n      return;\x0d\n    }\x0d\n    // session[kType] can be only one of two possible values\x0d\n    if (type === NGHTTP2_SESSION_SERVER) {\x0d\n      // eslint-disable-next-line no-use-before-define\x0d\n      stream = new ServerHttp2Stream(session\x2C handle\x2C id\x2C {}\x2C obj);\x0d\n      if (endOfStream) {\x0d\n        stream.push(null);\x0d\n      }\x0d\n      if (obj[HTTP2_HEADER_METHOD] === HTTP2_METHOD_HEAD) {\x0d\n        // For head requests\x2C there must not be a body...\x0d\n        // end the writable side immediately.\x0d\n        stream.end();\x0d\n        stream[kState].flags |= STREAM_FLAGS_HEAD_REQUEST;\x0d\n      }\x0d\n    } else {\x0d\n      // eslint-disable-next-line no-use-before-define\x0d\n      stream = new ClientHttp2Stream(session\x2C handle\x2C id\x2C {});\x0d\n      if (endOfStream) {\x0d\n        stream.push(null);\x0d\n      }\x0d\n      stream.end();\x0d\n    }\x0d\n    if (endOfStream)\x0d\n      stream[kState].endAfterHeaders = true;\x0d\n    process.nextTick(emit\x2C session\x2C 'stream'\x2C stream\x2C obj\x2C flags\x2C headers);\x0d\n  } else {\x0d\n    let event;\x0d\n    const status = obj[HTTP2_HEADER_STATUS];\x0d\n    if (cat === NGHTTP2_HCAT_RESPONSE) {\x0d\n      if (!endOfStream &&\x0d\n          status !== undefined &&\x0d\n          status >= 100 &&\x0d\n          status < 200) {\x0d\n        event = 'headers';\x0d\n      } else {\x0d\n        event = 'response';\x0d\n      }\x0d\n    } else if (cat === NGHTTP2_HCAT_PUSH_RESPONSE) {\x0d\n      event = 'push';\x0d\n    } else if (status !== undefined && status >= 200) {\x0d\n      event = 'response';\x0d\n    } else {\x0d\n      event = endOfStream ? 'trailers' : 'headers';\x0d\n    }\x0d\n    const session = stream.session;\x0d\n    if (status === HTTP_STATUS_MISDIRECTED_REQUEST) {\x0d\n      const originSet = session[kState].originSet = initOriginSet(session);\x0d\n      originSet.delete(stream[kOrigin]);\x0d\n    }\x0d\n    debugStream(id\x2C type\x2C "emitting stream '%s' event"\x2C event);\x0d\n    const reqAsync = stream[kRequestAsyncResource];\x0d\n    if (reqAsync)\x0d\n      reqAsync.runInAsyncScope(process.nextTick\x2C null\x2C emit\x2C stream\x2C event\x2C obj\x2C flags\x2C headers);\x0d\n    else\x0d\n      process.nextTick(emit\x2C stream\x2C event\x2C obj\x2C flags\x2C headers);\x0d\n  }\x0d\n  if (endOfStream) {\x0d\n    stream.push(null);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction tryClose(fd) {\x0d\n  // Try to close the file descriptor. If closing fails\x2C assert because\x0d\n  // an error really should not happen at this point.\x0d\n  fs.close(fd\x2C assert.ifError);\x0d\n}\x0d\n\x0d\n// Called when the Http2Stream has finished sending data and is ready for\x0d\n// trailers to be sent. This will only be called if the { hasOptions: true }\x0d\n// option is set.\x0d\nfunction onStreamTrailers() {\x0d\n  const stream = this[kOwner];\x0d\n  stream[kState].trailersReady = true;\x0d\n  if (stream.destroyed || stream.closed)\x0d\n    return;\x0d\n  if (!stream.emit('wantTrailers')) {\x0d\n    // There are no listeners\x2C send empty trailing HEADERS frame and close.\x0d\n    stream.sendTrailers({});\x0d\n  }\x0d\n}\x0d\n\x0d\n// Submit an RST-STREAM frame to be sent to the remote peer.\x0d\n// This will cause the Http2Stream to be closed.\x0d\nfunction submitRstStream(code) {\x0d\n  if (this[kHandle] !== undefined) {\x0d\n    this[kHandle].rstStream(code);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Keep track of the number/presence of JS event listeners. Knowing that there\x0d\n// a