RORED();\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  createMainThreadPort\x2C\x0d\n  destroyMainThreadPort\x2C\x0d\n  setupMainThreadPort\x2C\x0d\n  postMessageToThread\x2C\x0d\n};\x0d\n
