script-source,1874,node:internal/http2/compat,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  Boolean\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectHasOwn\x2C\x0d\n  ObjectKeys\x2C\x0d\n  Proxy\x2C\x0d\n  ReflectApply\x2C\x0d\n  ReflectGetPrototypeOf\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst assert = require('internal/assert');\x0d\nconst Stream = require('stream');\x0d\nconst { Readable } = Stream;\x0d\nconst {\x0d\n  constants: {\x0d\n    HTTP2_HEADER_AUTHORITY\x2C\x0d\n    HTTP2_HEADER_CONNECTION\x2C\x0d\n    HTTP2_HEADER_METHOD\x2C\x0d\n    HTTP2_HEADER_PATH\x2C\x0d\n    HTTP2_HEADER_SCHEME\x2C\x0d\n    HTTP2_HEADER_STATUS\x2C\x0d\n\x0d\n    HTTP_STATUS_CONTINUE\x2C\x0d\n    HTTP_STATUS_EARLY_HINTS\x2C\x0d\n    HTTP_STATUS_EXPECTATION_FAILED\x2C\x0d\n    HTTP_STATUS_METHOD_NOT_ALLOWED\x2C\x0d\n    HTTP_STATUS_OK\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('http2');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_HTTP2_HEADERS_SENT\x2C\x0d\n    ERR_HTTP2_INFO_STATUS_NOT_ALLOWED\x2C\x0d\n    ERR_HTTP2_INVALID_HEADER_VALUE\x2C\x0d\n    ERR_HTTP2_INVALID_STREAM\x2C\x0d\n    ERR_HTTP2_NO_SOCKET_MANIPULATION\x2C\x0d\n    ERR_HTTP2_PSEUDOHEADER_NOT_ALLOWED\x2C\x0d\n    ERR_HTTP2_STATUS_INVALID\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_HTTP_TOKEN\x2C\x0d\n    ERR_STREAM_WRITE_AFTER_END\x2C\x0d\n  }\x2C\x0d\n  hideStackFrames\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  validateFunction\x2C\x0d\n  validateString\x2C\x0d\n  validateLinkHeaderValue\x2C\x0d\n  validateObject\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  kSocket\x2C\x0d\n  kRequest\x2C\x0d\n  kProxySocket\x2C\x0d\n  assertValidPseudoHeader\x2C\x0d\n  getAuthority\x2C\x0d\n} = require('internal/http2/util');\x0d\nconst { _checkIsHttpToken: checkIsHttpToken } = require('_http_common');\x0d\n\x0d\nconst kBeginSend = Symbol('begin-send');\x0d\nconst kState = Symbol('state');\x0d\nconst kStream = Symbol('stream');\x0d\nconst kResponse = Symbol('response');\x0d\nconst kHeaders = Symbol('headers');\x0d\nconst kRawHeaders = Symbol('rawHeaders');\x0d\nconst kTrailers = Symbol('trailers');\x0d\nconst kRawTrailers = Symbol('rawTrailers');\x0d\nconst kSetHeader = Symbol('setHeader');\x0d\nconst kAppendHeader = Symbol('appendHeader');\x0d\nconst kAborted = Symbol('aborted');\x0d\n\x0d\nlet statusMessageWarned = false;\x0d\nlet statusConnectionHeaderWarned = false;\x0d\n\x0d\n// Defines and implements an API compatibility layer on top of the core\x0d\n// HTTP/2 implementation\x2C intended to provide an interface that is as\x0d\n// close as possible to the current require('http') API\x0d\n\x0d\nconst assertValidHeader = hideStackFrames((name\x2C value) => {\x0d\n  if (name === '' ||\x0d\n      typeof name !== 'string' ||\x0d\n      name.includes(' ')) {\x0d\n    throw new ERR_INVALID_HTTP_TOKEN.HideStackFramesError('Header name'\x2C name);\x0d\n  }\x0d\n  if (isPseudoHeader(name)) {\x0d\n    throw new ERR_HTTP2_PSEUDOHEADER_NOT_ALLOWED.HideStackFramesError();\x0d\n  }\x0d\n  if (value === undefined || value === null) {\x0d\n    throw new ERR_HTTP2_INVALID_HEADER_VALUE.HideStackFramesError(value\x2C name);\x0d\n  }\x0d\n  if (!isConnectionHeaderAllowed(name\x2C value)) {\x0d\n    connectionHeaderMessageWarn();\x0d\n  }\x0d\n});\x0d\n\x0d\nfunction isPseudoHeader(name) {\x0d\n  switch (name) {\x0d\n    case HTTP2_HEADER_STATUS:    // :status\x0d\n    case HTTP2_HEADER_METHOD:    // :method\x0d\n    case HTTP2_HEADER_PATH:      // :path\x0d\n    case HTTP2_HEADER_AUTHORITY: // :authority\x0d\n    case HTTP2_HEADER_SCHEME:    // :scheme\x0d\n      return true;\x0d\n    default:\x0d\n      return false;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction statusMessageWarn() {\x0d\n  if (statusMessageWarned === false) {\x0d\n    process.emitWarning(\x0d\n      'Status message is not supported by HTTP/2 (RFC7540 8.1.2.4)'\x2C\x0d\n      'UnsupportedWarning'\x2C\x0d\n    );\x0d\n    statusMessageWarned = true;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction isConnectionHeaderAllowed(name\x2C value) {\x0d\n  return name !== HTTP2_HEADER_CONNECTION ||\x0d\n         value === 'trailers';\x0d\n}\x0d\n\x0d\nfunction connectionHeaderMessageWarn() {\x0d\n  if (statusConnectionHeaderWarned === false) {\x0d\n    process.emitWarning(\x0d\n      'The provided connection header is not valid\x2C ' +\x0d\n      'the value will be dropped from the header and ' +\x0d\n      'will never be in use.'\x2C\x0d\n      'UnsupportedWarning'\x2C\x0d\n    );\x0d\n    statusConnectionHeaderWarned = true;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamData(chunk) {\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined && !request.push(chunk))\x0d\n    this.pause();\x0d\n}\x0d\n\x0d\nfunction onStreamTrailers(trailers\x2C flags\x2C rawTrailers) {\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined) {\x0d\n    ObjectAssign(request[kTrailers]\x2C trailers);\x0d\n    request[kRawTrailers].push(...rawTrailers);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamEnd() {\x0d\n  // Cause the request stream to end as well.\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined)\x0d\n    this[kRequest].push(null);\x0d\n}\x0d\n\x0d\nfunction onStreamError(error) {\x0d\n  // This is purposefully left blank\x0d\n  //\x0d\n  // errors in compatibility mode are\x0d\n  // not forwarded to the request\x0d\n  // and response objects.\x0d\n}\x0d\n\x0d\nfunction onRequestPause() {\x0d\n  this[kStream].pause();\x0d\n}\x0d\n\x0d\nfunction onRequestResume() {\x0d\n  this[kStream].resume();\x0d\n}\x0d\n\x0d\nfunction onStreamDrain() {\x0d\n  const response = this[kResponse];\x0d\n  if (response !== undefined)\x0d\n    response.emit('drain');\x0d\n}\x0d\n\x0d\nfunction onStreamAbortedRequest() {\x0d\n  const request = this[kRequest];\x0d\n  if (request !== undefined && request[kState].closed === false) {\x0d\n    request[kAborted] = true;\x0d\n    request.emit('aborted');\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStre