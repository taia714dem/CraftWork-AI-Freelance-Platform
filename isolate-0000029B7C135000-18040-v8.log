script-source,1453,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/repl/native-functions/debug-repl-fn.js,import { ReplFunction } from '../repl-function.js';\nimport { clc } from '@nestjs/common/internal';\nexport class DebugReplFn extends ReplFunction {\n    fnDefinition = {\n        name: 'debug'\x2C\n        description: 'Print all registered modules as a list together with their controllers and providers.\\nIf the argument is passed in\x2C for example\x2C "debug(MyModule)" then it will only print components of this specific module.'\x2C\n        signature: '(moduleCls?: ClassRef | string) => void'\x2C\n    };\n    action(moduleCls) {\n        this.ctx.writeToStdout('\\n');\n        if (moduleCls) {\n            const token = typeof moduleCls === 'function' ? moduleCls.name : moduleCls;\n            const moduleEntry = this.ctx.debugRegistry[token];\n            if (!moduleEntry) {\n                return this.logger.error(`"${token}" has not been found in the modules registry`);\n            }\n            this.printCtrlsAndProviders(token\x2C moduleEntry);\n        }\n        else {\n            for (const [moduleKey\x2C entry] of Object.entries(this.ctx.debugRegistry)) {\n                this.printCtrlsAndProviders(moduleKey\x2C entry);\n            }\n        }\n        this.ctx.writeToStdout('\\n');\n    }\n    printCtrlsAndProviders(moduleName\x2C moduleDebugEntry) {\n        this.ctx.writeToStdout(`${clc.green(moduleName)}:\\n`);\n        this.printCollection('controllers'\x2C moduleDebugEntry['controllers']);\n        this.printCollection('providers'\x2C moduleDebugEntry['providers']);\n    }\n    printCollection(title\x2C collectionValue) {\n        const collectionEntries = Object.keys(collectionValue);\n        if (collectionEntries.length <= 0) {\n            return;\n        }\n        this.ctx.writeToStdout(` ${clc.yellow(`- ${title}`)}:\\n`);\n        collectionEntries.forEach(provider => this.ctx.writeToStdout(`  ${clc.green('\u25fb')} ${provider}\\n`));\n    }\n}\n
