script-source,2455,node:internal/crypto/webidl,'use strict';\x0d\n\x0d\n// Adapted from the following sources\x0d\n// - https://github.com/jsdom/webidl-conversions\x0d\n//   Copyright Domenic Denicola. Licensed under BSD-2-Clause License.\x0d\n//   Original license at https://github.com/jsdom/webidl-conversions/blob/master/LICENSE.md.\x0d\n// - https://github.com/denoland/deno\x0d\n//   Copyright Deno authors. Licensed under MIT License.\x0d\n//   Original license at https://github.com/denoland/deno/blob/main/LICENSE.md.\x0d\n// Changes include using primordials and stripping the code down to only what\x0d\n// WebCryptoAPI needs.\x0d\n\x0d\nconst {\x0d\n  ArrayBufferIsView\x2C\x0d\n  ArrayBufferPrototype\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeSort\x2C\x0d\n  MathPow\x2C\x0d\n  MathTrunc\x2C\x0d\n  Number\x2C\x0d\n  NumberIsFinite\x2C\x0d\n  ObjectPrototypeIsPrototypeOf\x2C\x0d\n  SafeArrayIterator\x2C\x0d\n  String\x2C\x0d\n  TypedArrayPrototypeGetBuffer\x2C\x0d\n  TypedArrayPrototypeGetSymbolToStringTag\x2C\x0d\n  globalThis: {\x0d\n    SharedArrayBuffer\x2C\x0d\n  }\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  makeException\x2C\x0d\n  createEnumConverter\x2C\x0d\n  createSequenceConverter\x2C\x0d\n} = require('internal/webidl');\x0d\n\x0d\nconst {\x0d\n  kEmptyObject\x2C\x0d\n  setOwnProperty\x2C\x0d\n} = require('internal/util');\x0d\nconst { CryptoKey } = require('internal/crypto/webcrypto');\x0d\nconst { getDataViewOrTypedArrayBuffer } = require('internal/crypto/util');\x0d\n\x0d\n// https://tc39.es/ecma262/#sec-tonumber\x0d\nfunction toNumber(value\x2C opts = kEmptyObject) {\x0d\n  switch (typeof value) {\x0d\n    case 'number':\x0d\n      return value;\x0d\n    case 'bigint':\x0d\n      throw makeException(\x0d\n        'is a BigInt and cannot be converted to a number.'\x2C\x0d\n        opts);\x0d\n    case 'symbol':\x0d\n      throw makeException(\x0d\n        'is a Symbol and cannot be converted to a number.'\x2C\x0d\n        opts);\x0d\n    default:\x0d\n      return Number(value);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction type(V) {\x0d\n  if (V === null)\x0d\n    return 'Null';\x0d\n\x0d\n  switch (typeof V) {\x0d\n    case 'undefined':\x0d\n      return 'Undefined';\x0d\n    case 'boolean':\x0d\n      return 'Boolean';\x0d\n    case 'number':\x0d\n      return 'Number';\x0d\n    case 'string':\x0d\n      return 'String';\x0d\n    case 'symbol':\x0d\n      return 'Symbol';\x0d\n    case 'bigint':\x0d\n      return 'BigInt';\x0d\n    case 'object': // Fall through\x0d\n    case 'function': // Fall through\x0d\n    default:\x0d\n      // Per ES spec\x2C typeof returns an implementation-defined value that is not\x0d\n      // any of the existing ones for uncallable non-standard exotic objects.\x0d\n      // Yet Type() which the Web IDL spec depends on returns Object for such\x0d\n      // cases. So treat the default case as an object.\x0d\n      return 'Object';\x0d\n  }\x0d\n}\x0d\n\x0d\nconst integerPart = MathTrunc;\x0d\n\x0d\n// This was updated to only consider bitlength up to 32 used by WebCryptoAPI\x0d\nfunction createIntegerConversion(bitLength) {\x0d\n  const lowerBound = 0;\x0d\n  const upperBound = MathPow(2\x2C bitLength) - 1;\x0d\n\x0d\n  const twoToTheBitLength = MathPow(2\x2C bitLength);\x0d\n\x0d\n  return (V\x2C opts = kEmptyObject) => {\x0d\n    let x = toNumber(V\x2C opts);\x0d\n\x0d\n    if (opts.enforceRange) {\x0d\n      if (!NumberIsFinite(x)) {\x0d\n        throw makeException(\x0d\n          'is not a finite number.'\x2C\x0d\n          opts);\x0d\n      }\x0d\n\x0d\n      x = integerPart(x);\x0d\n\x0d\n      if (x < lowerBound || x > upperBound) {\x0d\n        throw makeException(\x0d\n          `is outside the expected range of ${lowerBound} to ${upperBound}.`\x2C\x0d\n          { __proto__: null\x2C ...opts\x2C code: 'ERR_OUT_OF_RANGE' }\x2C\x0d\n        );\x0d\n      }\x0d\n\x0d\n      return x;\x0d\n    }\x0d\n\x0d\n    if (!NumberIsFinite(x) || x === 0) {\x0d\n      return 0;\x0d\n    }\x0d\n\x0d\n    x = integerPart(x);\x0d\n\x0d\n    if (x >= lowerBound && x <= upperBound) {\x0d\n      return x;\x0d\n    }\x0d\n\x0d\n    x = x % twoToTheBitLength;\x0d\n\x0d\n    return x;\x0d\n  };\x0d\n}\x0d\n\x0d\nconst converters = {};\x0d\n\x0d\nconverters.boolean = (val) => !!val;\x0d\nconverters.octet = createIntegerConversion(8);\x0d\nconverters['unsigned short'] = createIntegerConversion(16);\x0d\nconverters['unsigned long'] = createIntegerConversion(32);\x0d\n\x0d\nconverters.DOMString = function(V\x2C opts = kEmptyObject) {\x0d\n  if (typeof V === 'string') {\x0d\n    return V;\x0d\n  } else if (typeof V === 'symbol') {\x0d\n    throw makeException(\x0d\n      'is a Symbol and cannot be converted to a string.'\x2C\x0d\n      opts);\x0d\n  }\x0d\n\x0d\n  return String(V);\x0d\n};\x0d\n\x0d\nconverters.object = (V\x2C opts) => {\x0d\n  if (type(V) !== 'Object') {\x0d\n    throw makeException(\x0d\n      'is not an object.'\x2C\x0d\n      opts);\x0d\n  }\x0d\n\x0d\n  return V;\x0d\n};\x0d\n\x0d\nfunction isNonSharedArrayBuffer(V) {\x0d\n  return ObjectPrototypeIsPrototypeOf(ArrayBufferPrototype\x2C V);\x0d\n}\x0d\n\x0d\nfunction isSharedArrayBuffer(V) {\x0d\n  // SharedArrayBuffers can be disabled with --no-harmony-sharedarraybuffer.\x0d\n  if (SharedArrayBuffer !== undefined)\x0d\n    return ObjectPrototypeIsPrototypeOf(SharedArrayBuffer.prototype\x2C V);\x0d\n  return false;\x0d\n}\x0d\n\x0d\nconverters.Uint8Array = (V\x2C opts = kEmptyObject) => {\x0d\n  if (!ArrayBufferIsView(V) ||\x0d\n    TypedArrayPrototypeGetSymbolToStringTag(V) !== 'Uint8Array') {\x0d\n    throw makeException(\x0d\n      'is not an Uint8Array object.'\x2C\x0d\n      opts);\x0d\n  }\x0d\n  if (isSharedArrayBuffer(TypedArrayPrototypeGetBuffer(V))) {\x0d\n    throw makeException(\x0d\n      'is a view on a SharedArrayBuffer\x2C which is not allowed.'\x2C\x0d\n      opts);\x0d\n  }\x0d\n\x0d\n  return V;\x0d\n};\x0d\n\x0d\nconverters.BufferSource = (V\x2C opts = kEmptyObject) => {\x0d\n  if (ArrayBufferIsView(V)) {\x0d\n    if (isSharedArrayBuffer(getDataViewOrTypedArrayBuffer(V))) {\x0d\n      throw makeException(\x0d\n        'is a view on a SharedArrayBuffer\x2C which is not allowed.'\x2C\x0d\n        opts);\x0d\n    }\x0d\n\x0d\n    return V;\x0d\n  }\x0d\n\x0d\n  if (!isNonSharedArrayBuffer(V)) {\x0d\n    throw makeException(\x0d\n      'is not instance of ArrayBuffer\x2C Buffer\x2C TypedArray\x2C or DataView.'\x2C\x0d\n      opts);\x0d\n  }\x0d\n\x0d\n  return V;\x0d\n};\x0d\n\x0d\nconverters['sequence<DOMString>'] = createSequenceConverter(\x0d\n  converters.DOMString);\x0d\n\x0d\nfunction requiredArguments(length\x2C required\x2C opts = kEmptyObject) {\x0d\n  if (length < required) {\x0d\n    throw makeException(\x0d\n      `${required} argument${\x0d\n        required === 1 ? '' : 's'\x0d\n      } required\x2C but only ${length} present.`\x2C\x0d\n      { __proto__: null\x2C ...opts\x2C context: ''\x2C code: 'ERR_MISSING_ARGS' });\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction createDictionaryConverter(name\x2C dictionaries) {\x0d\n  let hasRequiredKey = false;\x0d\n  const allMembers = [];\x0d\n  for (let i = 0; i < dictionaries.length; i++) {\x0d\n    const member = dictionaries[i];\x0d\n    if (member.required) {\x0d\n      hasRequiredKey = true;\x0d\n    }\x0d\n    ArrayPrototypePush(allMembers\x2C member);\x0d\n  }\x0d\n  ArrayPrototypeSort(allMembers\x2C (a\x2C b) => {\x0d\n    if (a.key === b.key) {\x0d\n      return 0;\x0d\n    }\x0d\n    return a.key < b.key ? -1 : 1;\x0d\n  });\x0d\n\x0d\n  return function(V\x2C opts = kEmptyObject) {\x0d\n    const typeV = type(V);\x0d\n    switch (typeV) {\x0d\n      case 'Undefined':\x0d\n      case 'Null':\x0d\n      case 'Object':\x0d\n        break;\x0d\n      default:\x0d\n        throw makeException(\x0d\n          'can not be converted to a dictionary'\x2C\x0d\n          opts);\x0d\n    }\x0d\n    const esDict = V;\x0d\n    const idlDict = {};\x0d\n\x0d\n    // Fast path null and undefined.\x0d\n    if (V == null && !hasRequiredKey) {\x0d\n      return idlDict;\x0d\n    }\x0d\n\x0d\n    for (const member of new SafeArrayIterator(allMembers)) {\x0d\n      const key = member.key;\x0d\n\x0d\n      let esMemberValue;\x0d\n      if (typeV === 'Undefined' || typeV === 'Null') {\x0d\n        esMemberValue = undefined;\x0d\n      } else {\x0d\n        esMemberValue = esDict[key];\x0d\n      }\x0d\n\x0d\n      if (esMemberValue !== undefined) {\x0d\n        const context = `'${key}' of '${name}'${\x0d\n          opts.context ? ` (${opts.context})` : ''\x0d\n        }`;\x0d\n        const converter = member.converter;\x0d\n        const idlMemberValue = converter(esMemberValue\x2C {\x0d\n          __proto__: null\x2C\x0d\n          ...opts\x2C\x0d\n          context\x2C\x0d\n        });\x0d\n        setOwnProperty(idlDict\x2C key\x2C idlMemberValue);\x0d\n      } else if (member.required) {\x0d\n        throw makeException(\x0d\n          `can not be converted to '${name}' because '${key}' is required in '${name}'.`\x2C\x0d\n          { __proto__: null\x2C ...opts\x2C code: 'ERR_MISSING_OPTION' });\x0d\n      }\x0d\n    }\x0d\n\x0d\n    return idlDict;\x0d\n  };\x0d\n}\x0d\n\x0d\nfunction createInterfaceConverter(name\x2C prototype) {\x0d\n  return (V\x2C opts) => {\x0d\n    if (!ObjectPrototypeIsPrototypeOf(prototype\x2C V)) {\x0d\n      throw makeException(\x0d\n        `is not of type ${name}.`\x2C\x0d\n        opts);\x0d\n    }\x0d\n    return V;\x0d\n  };\x0d\n}\x0d\n\x0d\nconverters.AlgorithmIdentifier = (V\x2C opts) => {\x0d\n  // Union for (object or DOMString)\x0d\n  if (type(V) === 'Object') {\x0d\n    return converters.object(V\x2C opts);\x0d\n  }\x0d\n  return converters.DOMString(V\x2C opts);\x0d\n};\x0d\n\x0d\nconverters.KeyFormat = createEnumConverter('KeyFormat'\x2C [\x0d\n  'raw'\x2C\x0d\n  'pkcs8'\x2C\x0d\n  'spki'\x2C\x0d\n  'jwk'\x2C\x0d\n]);\x0d\n\x0d\nconverters.KeyUsage = createEnumConverter('KeyUsage'\x2C [\x0d\n  'encrypt'\x2C\x0d\n  'decrypt'\x2C\x0d\n  'sign'\x2C\x0d\n  'verify'\x2C\x0d\n  'deriveKey'\x2C\x0d\n  'deriveBits'\x2C\x0d\n  'wrapKey'\x2C\x0d\n  'unwrapKey'\x2C\x0d\n]);\x0d\n\x0d\nconverters['sequence<KeyUsage>'] = createSequenceConverter(converters.KeyUsage);\x0d\n\x0d\nconverters.HashAlgorithmIdentifier = converters.AlgorithmIdentifier;\x0d\n\x0d\nconst dictAlgorithm = [\x0d\n  {\x0d\n    key: 'name'\x2C\x0d\n    converter: converters.DOMString\x2C\x0d\n    required: true\x2C\x0d\n  }\x2C\x0d\n];\x0d\n\x0d\nconverters.Algorithm = createDictionaryConverter(\x0d\n  'Algorithm'\x2C dictAlgorithm);\x0d\n\x0d\nconverters.BigInteger = converters.Uint8Array;\x0d\n\x0d\nconst dictRsaKeyGenParams = [\x0d\n  ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n  {\x0d\n    key: 'modulusLength'\x2C\x0d\n    converter: (V\x2C opts) =>\x0d\n      converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\x0d\n    required: true\x2C\x0d\n  }\x2C\x0d\n  {\x0d\n    key: 'publicExponent'\x2C\x0d\n    converter: converters.BigInteger\x2C\x0d\n    required: true\x2C\x0d\n  }\x2C\x0d\n];\x0d\n\x0d\nconverters.RsaKeyGenParams = createDictionaryConverter(\x0d\n  'RsaKeyGenParams'\x2C dictRsaKeyGenParams);\x0d\n\x0d\nconverters.RsaHashedKeyGenParams = createDictionaryConverter(\x0d\n  'RsaHashedKeyGenParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictRsaKeyGenParams)\x2C\x0d\n    {\x0d\n      key: 'hash'\x2C\x0d\n      converter: converters.HashAlgorithmIdentifier\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.RsaHashedImportParams = createDictionaryConverter(\x0d\n  'RsaHashedImportParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'hash'\x2C\x0d\n      converter: converters.HashAlgorithmIdentifier\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.NamedCurve = converters.DOMString;\x0d\n\x0d\nconverters.EcKeyImportParams = createDictionaryConverter(\x0d\n  'EcKeyImportParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'namedCurve'\x2C\x0d\n      converter: converters.NamedCurve\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.EcKeyGenParams = createDictionaryConverter(\x0d\n  'EcKeyGenParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'namedCurve'\x2C\x0d\n      converter: converters.NamedCurve\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.AesKeyGenParams = createDictionaryConverter(\x0d\n  'AesKeyGenParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'length'\x2C\x0d\n      converter: (V\x2C opts) =>\x0d\n        converters['unsigned short'](V\x2C { ...opts\x2C enforceRange: true })\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.HmacKeyGenParams = createDictionaryConverter(\x0d\n  'HmacKeyGenParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'hash'\x2C\x0d\n      converter: converters.HashAlgorithmIdentifier\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n    {\x0d\n      key: 'length'\x2C\x0d\n      converter: (V\x2C opts) =>\x0d\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.RsaPssParams = createDictionaryConverter(\x0d\n  'RsaPssParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'saltLength'\x2C\x0d\n      converter: (V\x2C opts) =>\x0d\n        converters['unsigned long'](V\x2C { ...opts\x2C enforceRange: true })\x2C\x0d\n      required: true\x2C\x0d\n    }\x2C\x0d\n  ]);\x0d\n\x0d\nconverters.RsaOaepParams = createDictionaryConverter(\x0d\n  'RsaOaepParams'\x2C [\x0d\n    ...new SafeArrayIterator(dictAlgorithm)\x2C\x0d\n    {\x0d\n      key: 'label'\x2C\x0d\n      converter: converters.BufferSource\x2C\x0d\n    }\x2C\x0d\n  ]);\x