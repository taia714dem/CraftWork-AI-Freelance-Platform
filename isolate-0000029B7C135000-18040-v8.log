k.latin1Slice(self._lastPos\x2C pos - 1);\n    }\n    self._valTrunc = true;\n    for (; pos < len; ++pos) {\n      if (chunk[pos] === 38/* '&' */)\n        break;\n      ++self._bytesVal;\n    }\n    self._lastPos = pos;\n  }\n\n  return pos;\n}\n\n/* eslint-disable no-multi-spaces */\nconst HEX_VALUES = [\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n   0\x2C  1\x2C  2\x2C  3\x2C  4\x2C  5\x2C  6\x2C  7\x2C  8\x2C  9\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C 10\x2C 11\x2C 12\x2C 13\x2C 14\x2C 15\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C 10\x2C 11\x2C 12\x2C 13\x2C 14\x2C 15\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C\n  -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -1\x2C -