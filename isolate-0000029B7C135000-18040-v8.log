optional Node global is inspected only to improve the missing-File diagnostic in runtimes without process.\n        const { process } = globalThis;\n        const isOldNode = typeof process?.versions?.node === 'string' &&\n            Number.parseInt(process.versions.node.split('.')\x2C 10) < 20;\n        throw new Error('`File` is not defined as a global\x2C which is required for file uploads.' +\n            (isOldNode\n                ? " Update to a supported Node.js LTS release\x2C or set `globalThis.File` to `import('node:buffer').File`."\n                : ''));\n    }\n};\n/**\n * Construct a `File` instance. This is used to ensure a helpful error is thrown\n * for environments that don't define a global `File` yet.\n *\n * A missing filename becomes `unknown_file`.\n */\nexport function makeFile(fileBits\x2C fileName\x2C options) {\n    checkFileSupport();\n    // SAFETY: The SDK BlobPart union supports Node and web binary inputs; the native File constructor handles those parts across their differing ambient types.\n    return new File(fileBits\x2C fileName ?? 'unknown_file'\x2C options);\n}\n/**\n * Infers a filename from an object's `name`\x2C `url`\x2C `filename`\x2C or `path` value.\n *\n * Directory components separated by either `/` or `\\\\` are discarded unless an\n * explicitly supplied `name` or `filename` opts into preserving its path. Preserved\n * paths must be safe and relative\x2C and use forward slashes. Paths inferred from URLs and filesystem streams\n * discard their directories. URL filenames decode valid UTF-8 percent escapes\x2C\n * except that ASCII control characters stay escaped for multipart compatibility.\n * A basename stays encoded if decoding would introduce literal multipart escape sequences.\n */\nexport function getName(value\x2C options) {\n    if (typeof value !== 'object' || value === null) {\n        return undefined;\n    }\n    const name = 'name' in value ? value.name : undefined;\n    const explicitName = (name && Str