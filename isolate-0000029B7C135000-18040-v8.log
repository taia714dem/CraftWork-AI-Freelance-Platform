ase 'end':\x0d\n      case 'emit':\x0d\n      case 'destroy':\x0d\n        stream[prop] = value;\x0d\n        return true;\x0d\n      case 'setTimeout': {\x0d\n        const session = stream.session;\x0d\n        if (session !== undefined)\x0d\n          session.setTimeout = value;\x0d\n        else\x0d\n          stream.setTimeout = value;\x0d\n        return true;\x0d\n      }\x0d\n      case 'write':\x0d\n      case 'read':\x0d\n      case 'pause':\x0d\n      case 'resume':\x0d\n        throw new ERR_HTTP2_NO_SOCKET_MANIPULATION();\x0d\n      default: {\x0d\n        const ref = stream.session !== undefined ?\x0d\n          stream.session[kSocket] : stream;\x0d\n        ref[prop] = value;\x0d\n        return true;\x0d\n      }\x0d\n    }\x0d\n  }\x2C\x0d\n};\x0d\n\x0d\nfunction onStreamCloseRequest() {\x0d\n  const req = this[kRequest];\x0d\n\x0d\n  if (req === undefined)\x0d\n    return;\x0d\n\x0d\n  const state = req[kState];\x0d\n  state.closed = true;\x0d\n\x0d\n  req.push(null);\x0d\n  // If the user didn't interact with incoming data and didn't pipe it\x2C\x0d\n  // dump it for compatibility with http1\x0d\n  if (!state.didRead && !req._readableState.resumeScheduled)\x0d\n    req.resume();\x0d\n\x0d\n  this[kProxySocket] = null;\x0d\n  this[kRequest] = undefined;\x0d\n\x0d\n  req.emit('close');\x0d\n}\x0d\n\x0d\nfunction onStreamTimeout(kind) {\x0d\n  return function onStreamTimeout() {\x0d\n    const obj = this[kind];\x0d\n    obj.emit('timeout');\x0d\n  };\x0d\n}\x0d\n\x0d\nclass Http2ServerRequest extends Readable {\x0d\n  constructor(stream\x2C headers\x2C options\x2C rawHeaders) {\x0d\n    super({ autoDestroy: false\x2C ...options });\x0d\n    this[kState] = {\x0d\n      closed: false\x2C\x0d\n      didRead: false\x2C\x0d\n    };\x0d\n    // Headers in HTTP/1 are not initialized using Object.create(null) which\x2C\x0d\n    // although preferable\x2C would simply break too much code. Ergo header\x0d\n    // initialization using Object.create(null) in HTT