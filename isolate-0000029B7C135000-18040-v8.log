ge\n      };\n    }\n    return null;\n  }\n\n  function applyHeaders(headers\x2C res) {\n    for (var i = 0\x2C n = headers.length; i < n; i++) {\n      var header = headers[i];\n      if (header) {\n        if (Array.isArray(header)) {\n          applyHeaders(header\x2C res);\n        } else if (header.key === 'Vary' && header.value) {\n          vary(res\x2C header.value);\n        } else if (header.value) {\n          res.setHeader(header.key\x2C header.value);\n        }\n      }\n    }\n  }\n\n  function cors(options\x2C req\x2C res\x2C next) {\n    var headers = []\x2C\n      method = req.method && req.method.toUpperCase && req.method.toUpperCase();\n\n    if (method === 'OPTIONS') {\n      // preflight\n      headers.push(configureOrigin(options\x2C req));\n      headers.push(configureCredentials(options))\n      headers.push(configureMethods(options))\n      headers.push(configureAllowedHeaders(options\x2C req));\n      headers.push(configureMaxAge(options))\n      headers.push(configureExposedHeaders(options))\n      applyHeaders(headers\x2C res);\n\n      if (options.preflightContinue) {\n        next();\n      } else {\n        // Safari (and potentially other browsers) need content-length 0\x2C\n        //   for 204 or they just hang waiting for a body\n        res.statusCode = options.optionsSuccessStatus;\n        res.setHeader('Content-Length'\x2C '0');\n        res.end();\n      }\n    } else {\n      // actual response\n      headers.push(configureOrigin(options\x2C req));\n      headers.push(configureCredentials(options))\n      headers.push(configureExposedHeaders(options))\n      applyHeaders(headers\x2C res);\n      next();\n    }\n  }\n\n  function middlewareWrapper(o) {\n    // if options are static (either via defaults or custom options passed in)\x2C wrap in a function\n    var optionsCallback = null;\n    if (typeof o === 'function') {\n      optionsCallback = o;\n    } else {\n      optionsCallback = function (req\x2C cb) {\n        cb(nu