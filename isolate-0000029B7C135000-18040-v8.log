script-source,2308,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\mime-types\\mimeScore.js,// 'mime-score' back-ported to CommonJS\n\n// Score RFC facets (see https://tools.ietf.org/html/rfc6838#section-3)\nvar FACET_SCORES = {\n  'prs.': 100\x2C\n  'x-': 200\x2C\n  'x.': 300\x2C\n  'vnd.': 400\x2C\n  default: 900\n}\n\n// Score mime source (Logic originally from `jshttp/mime-types` module)\nvar SOURCE_SCORES = {\n  nginx: 10\x2C\n  apache: 20\x2C\n  iana: 40\x2C\n  default: 30 // definitions added by `jshttp/mime-db` project?\n}\n\nvar TYPE_SCORES = {\n  // prefer application/xml over text/xml\n  // prefer application/rtf over text/rtf\n  application: 1\x2C\n\n  // prefer font/woff over application/font-woff\n  font: 2\x2C\n\n  // prefer video/mp4 over audio/mp4 over application/mp4\n  // See https://www.rfc-editor.org/rfc/rfc4337.html#section-2\n  audio: 2\x2C\n  video: 3\x2C\n\n  default: 0\n}\n\n/**\n * Get each component of the score for a mime type.  The sum of these is the\n * total score.  The higher the score\x2C the more "official" the type.\n */\nmodule.exports = function mimeScore (mimeType\x2C source = 'default') {\n  if (mimeType === 'application/octet-stream') {\n    return 0\n  }\n\n  const [type\x2C subtype] = mimeType.split('/')\n\n  const facet = subtype.replace(/(\\.|x-).*/\x2C '$1')\n\n  const facetScore = FACET_SCORES[facet] || FACET_SCORES.default\n  const sourceScore = SOURCE_SCORES[source] || SOURCE_SCORES.default\n  const typeScore = TYPE_SCORES[type] || TYPE_SCORES.default\n\n  // All else being equal prefer shorter types\n  const lengthScore = 1 - mimeType.length / 100\n\n  return facetScore + sourceScore + typeScore + lengthScore\n}\n
