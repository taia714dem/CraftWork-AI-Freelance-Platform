valueStart = index;\n    index = skipValue(header\x2C index\x2C len\x2C stopChar);\n    const valueEnd = trailingOWS(header\x2C valueStart\x2C index);\n    const type = header.slice(valueStart\x2C valueEnd).toLowerCase();\n    if (options?.parameters === false) {\n        return { type\x2C index\x2C parameters: new NullObject() };\n    }\n    return parseParameters(header\x2C type\x2C index\x2C len\x2C stopChar);\n}\nconst SP = 32; // " "\nconst HTAB = 9; // "\\t"\nconst SEMI = 59; // ";"\nconst EQ = 61; // "="\nconst DQUOTE = 34; // '"'\nconst BSLASH = 92; // "\\\\"\nconst COMMA = 44; // "\x2C"\n/**\n * Parses the parameters of a `Content-Type` header starting at the given index.\n */\nfunction parseParameters(header\x2C type\x2C index\x2C len\x2C stopChar) {\n    const parameters = new NullObject();\n    parameter: while (index < len) {\n        if (header.charCodeAt(index) === stopChar)\n            break;\n        index = skipOWS(header\x2C index + 1 /* Skip over ; */\x2C len);\n        const keyStart = index;\n        while (index < len) {\n            const code = header.charCodeAt(index);\n            if (code === stopChar)\n                break parameter;\n            if (code === SEMI)\n                continue parameter;\n            if (code === EQ) {\n                const keyEnd = trailingOWS(header\x2C keyStart\x2C index);\n                const key = header.slice(keyStart\x2C keyEnd).toLowerCase();\n                index = skipOWS(header\x2C index + 1\x2C len);\n                if (index < len && header.charCodeAt(index) === DQUOTE) {\n                    index++;\n                    let value = "";\n                    while (index < len) {\n                        const code = header.charCodeAt(index++);\n                        if (code === DQUOTE) {\n                            index = skipValue(header\x2C index\x2C len\x2C stopChar);\n                            if (parameters[key] === undefined)\n                                parameters[key]