\x2C\n        preservePath: preservePath\x2C\n        defParamCharset: defParamCharset\n      })\n    } catch (err) {\n      return next(err)\n    }\n\n    appender = new FileAppender(fileStrategy\x2C req)\n\n    // handle text field data\n    busboy.on('field'\x2C function (fieldname\x2C value\x2C { nameTruncated\x2C valueTruncated }) {\n      if (fieldname == null) return abortWithCode('MISSING_FIELD_NAME')\n      if (nameTruncated) return abortWithCode('LIMIT_FIELD_KEY')\n      if (valueTruncated) return abortWithCode('LIMIT_FIELD_VALUE'\x2C fieldname)\n\n      // Work around bug in Busboy (https://github.com/mscdex/busboy/issues/6)\n      if (limits && Object.prototype.hasOwnProperty.call(limits\x2C 'fieldNameSize')) {\n        if (fieldname.length > limits.fieldNameSize) return abortWithCode('LIMIT_FIELD_KEY')\n      }\n\n      if (limits && Object.prototype.hasOwnProperty.call(limits\x2C 'fieldNestingDepth')) {\n        if (fieldname.split('[').length - 1 > limits.fieldNestingDepth) return abortWithCode('LIMIT_FIELD_NESTING'\x2C fieldname)\n      }\n\n      appendField(req.body\x2C fieldname\x2C value)\n    })\n\n    // handle files\n    busboy.on('file'\x2C function (fieldname\x2C fileStream\x2C { filename\x2C encoding\x2C mimeType }) {\n      var pendingWritesIncremented = false\n\n      fileStream.on('error'\x2C function (err) {\n        if (pendingWritesIncremented) {\n          pendingWrites.decrement()\n        }\n        abortWithError(err)\n      })\n\n      if (fieldname == null) return abortWithCode('MISSING_FIELD_NAME')\n\n      // don't attach to the files object\x2C if there is no file\n      if (!filename) return fileStream.resume()\n\n      // Work around bug in Busboy (https://github.com/mscdex/busboy/issues/6)\n      if (limits && Object.prototype.hasOwnProperty.call(limits\x2C 'fieldNameSize')) {\n        if (fieldname.length > limits.fieldNameSize) return abortWithCode('LIMIT_FIELD_KEY')\n      }\n\n      var file = {\n        fieldname: fieldname\x2C\n        originalname: filename\x2C\n        encoding: encoding\x2C\n        mimetype: mimeType\n      }\n\n      var placeholder = appender.insertPlaceholder(file)\n\n      fileFilter(req\x2C file\x2C function (err\x2C includeFile) {\n        if (errorOccured) {\n          appender.removePlaceholder(placeholder)\n          return fileStream.resume()\n        }\n\n        if (err) {\n          appender.removePlaceholder(placeholder)\n          return abortWithError(err)\n        }\n\n        if (!includeFile) {\n          appender.removePlaceholder(placeholder)\n          return fileStream.resume()\n        }\n\n        var aborting = false\n        pendingWritesIncremented = true\n        pendingWrites.increment()\n\n        Object.defineProperty(file\x2C 'stream'\x2C {\n          configurable: true\x2C\n          enumerable: false\x2C\n          value: fileStream\n        })\n\n        fileStream.on('limit'\x2C function () {\n          aborting = true\n          abortWithCode('LIMIT_FILE_SIZE'\x2C fieldname)\n        })\n\n        pendingFiles.push(file)\n\n        storage._handleFile(req\x2C file\x2C function (err\x2C info) {\n          var idx = pendingFiles.indexOf(file)\n          if (idx !== -1) pendingFiles.splice(idx\x2C 1)\n\n          if (aborting) {\n            appender.removePlaceholder(placeholder)\n            uploadedFiles.push({ ...file\x2C ...info })\n            return pendingWrites.decrement()\n          }\n\n          if (err) {\n            appender.removePlaceholder(placeholder)\n            pendingWrites.decrement()\n            return abortWithError(err)\n          }\n\n          var fileInfo = { ...file\x2C ...info }\n\n          appender.replacePlaceholder(placeholder\x2C fileInfo)\n          uploadedFiles.push(fileInfo)\n          pendingWrites.decrement()\n          indicateDone()\n        })\n      })\n    })\n\n    busboy.on('error'\x2C function (err) { abortWithError(err) })\n    busboy.on('partsLimit'\x2C function () { abortWithCode('LIMIT_PART_COUNT') })\n    busboy.on('filesLimit'\x2C function () { abortWithCode('LIMIT_FILE_COUNT') })\n    busboy.on('fieldsLimit'\x2C function () { abortWithCode('LIMIT_FIELD_COUNT') })\n    busboy.on('close'\x2C function () {\n      readFinished = true\n      indicateDone()\n    })\n\n    req.pipe(busboy)\n  }\n}\n\nmodule.exports = makeMiddleware\n
