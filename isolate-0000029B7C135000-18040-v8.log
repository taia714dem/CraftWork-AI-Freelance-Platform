code-creation,Eval,9,3232183,0x34e27859eb8,5, C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\pg\\lib\\utils.js:1:1,0x211ffc1f298,~
script-source,1815,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\pg\\lib\\utils.js,'use strict'\n\nconst defaults = require('./defaults')\nconst nodeUtils = require('util')\n\nconst { isDate } = require('util/types')\n\nconst invalidDateDeprecationNotice = nodeUtils.deprecate(\n  () => {}\x2C\n  'Sending an invalid date to Postgres is deprecated and will throw an error in the next major version of pg. Ensure any Date object passed as a query parameter is valid.'\x2C\n  'PG_INVALID_DATE'\n)\n\nfunction escapeElement(elementRepresentation) {\n  const escaped = elementRepresentation.replace(/\\\\/g\x2C '\\\\\\\\').replace(/"/g\x2C '\\\\"')\n\n  return '"' + escaped + '"'\n}\n\n// convert a JS array to a postgres array literal\n// uses comma separator so won't work for types like box that use\n// a different array separator.\nfunction arrayString(val) {\n  let result = '{'\n  for (let i = 0; i < val.length; i++) {\n    if (i > 0) {\n      result += '\x2C'\n    }\n    let item = val[i]\n    if (item == null) {\n      result += 'NULL'\n    } else if (Array.isArray(item)) {\n      result += arrayString(item)\n    } else if (ArrayBuffer.isView(item)) {\n      if (!(item instanceof Buffer)) {\n        item = Buffer.from(item.buffer\x2C item.byteOffset\x2C item.byteLength)\n      }\n      result += '\\\\\\\\x' + item.toString('hex')\n    } else {\n      result += escapeElement(prepareValue(item))\n    }\n  }\n  result += '}'\n  return result\n}\n\n// converts values from javascript types\n// to their 'raw' counterparts for use as a postgres parameter\n// note: you can override this function to provide your own conversion mechanism\n// for complex types\x2C etc...\nconst prepareValue = function (val\x2C seen) {\n  // null and undefined are both null for postgres\n  if (val == null) {\n    return null\n  }\n  if (typeof val === 'object') {\n    if (val instanceof Buffer) {\n      return val\n    }\n    if (ArrayBuffer.isView(val)) {\n      return Buffer.from(val.buffer\x2C val.byteOffset\x2C val.byteLength)\n    }\n    if (isDate(val)) {\n      if (isNaN(val.getTime())) {\n        invalidDateDeprecationNotice()\n      }\n      if (defaults.parseInputDatesAsUTC) {\n        return dateToStringUTC(val)\n      } else {\n        return dateToString(val)\n      }\n    }\n    if (Array.isArray(val)) {\n      return arrayString(val)\n    }\n\n    return prepareObject(val\x2C seen)\n  }\n  return val.toString()\n}\n\nfunction prepareObject(val\x2C seen) {\n  if (val && typeof val.toPostgres === 'function') {\n    seen = seen || []\n    if (seen.indexOf(val) !== -1) {\n      throw new Error('circular reference detected while preparing "' + val + '" for query')\n    }\n    seen.push(val)\n\n    return prepareValue(val.toPostgres(prepareValue)\x2C seen)\n  }\n  return JSON.stringify(val)\n}\n\nfunction dateToString(date) {\n  let offset = -date.getTimezoneOffset()\n\n  let year = date.getFullYear()\n  const isBCYear = year < 1\n  if (isBCYear) year = Math.abs(year) + 1 // negative years are 1 off their BC representation\n\n  let ret =\n    String(year).padStart(4\x2C '0') +\n    '-' +\n    String(date.getMonth() + 1).padStart(2\x2C '0') +\n    '-' +\n    String(date.getDate()).padStart(2\x2C '0') +\n    'T' +\n    String(date.getHours()).padStart(2\x2C '0') +\n    ':' +\n    String(date.getMinutes()).padStart(2\x2C '0') +\n    ':' +\n    String(date.getSeconds()).padStart(2\x2C '0') +\n    '.' +\n    String(date.getMilliseconds()).padStart(3\x2C '0')\n\n  if (offset < 0) {\n    ret += '-'\n    offset *= -1\n  } else {\n    ret += '+'\n  }\n\n  ret += String(Math.floor(offset / 60)).padStart(2\x2C '0') + ':' + String(offset % 60).padStart(2\x2C '0')\n  if (isBCYear) ret += ' BC'\n  return ret\n}\n\nfunction dateToStringUTC(date) {\n  let year = date.getUTCFullYear()\n  const isBCYear = year < 1\n  if (isBCYear) year = Math.abs(year) + 1 // negative years are 1 off their BC representation\n\n  let ret =\n    String(year).padStart(4\x2C '0') +\n    '-' +\n    String(date.getUTCMonth() + 1).padStart(2\x2C '0') +\n    '-' +\n    String(date.getUTCDate()).padStart(2\x2C '0') +\n    'T' +\n    String(date.getUTCHours()).padStart(2\x2C '0') +\n    ':' +\n    String(date.getUTCMinutes()).padStart(2\x2C '0') +\n    ':' +\n    String(date.getUTCSeconds()).padStart(2\x2C '0') +\n    '.' +\n    String(date.getUTCMilliseconds()).padStart(3\x2C '0')\n\n  ret += '+00:00'\n  if (isBCYear) ret += ' BC'\n  return ret\n}\n\nfunction normalizeQueryConfig(config\x2C values\x2C callback) {\n  // can take in strings or config objects\n  // Copy config so normalization does not mutate the caller's object.\n  config = typeof config === 'string' ? { text: config } : cloneQueryConfig(config)\n  if (values) {\n    if (typeof values === 'function') {\n      config.callback = values\n    } else {\n      config.values = values\n    }\n  }\n  if (callback) {\n    config.callback = callback\n  }\n  return config\n}\n\nfunction cloneQueryConfig(config) {\n  if (config == null) {\n    return config\n  }\n  return Object.defineProperties(Object.create(Object.getPrototypeOf(config))\x2C Object.getOwnPropertyDescriptors(config))\n}\n\n// Ported from PostgreSQL 9.2.4 source code in src/interfaces/libpq/fe-exec.c\nconst escapeIdentifier = function (str) {\n  return '"' + str.replace(/"/g\x2C '""') + '"'\n}\n\nconst escapeLiteral = function (str) {\n  let hasBackslash = false\n  let escaped = "'"\n\n  if (str == null) {\n    return "''"\n  }\n\n  if (typeof str !== 'string') {\n    return "''"\n  }\n\n  for (let i = 0; i < str.length; i++) {\n    const c = str[i]\n    if (c === "'") {\n      escaped += c + c\n    } else if (c === '\\\\') {\n      escaped += c + c\n      hasBackslash = true\n    } else {\n      escaped += c\n    }\n  }\n\n  escaped += "'"\n\n  if (hasBackslash === true) {\n    escaped = ' E' + escaped\n  }\n\n  return escaped\n}\n\nmodule.exports = {\n  prepareValue: function prepareValueWrapper(value) {\n    // this ensures that extra arguments do not get passed into prepareValue\n    // by accident\x2C eg: from calling values.map(utils.prepareValue)\n    return prepareValue(value)\n  }\x2C\n  normalizeQueryConfig\x2C\n  escapeIdentifier\x2C\n  escapeLiteral\x2C\n}\n
