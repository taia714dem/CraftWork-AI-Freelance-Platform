script-source,194,node:internal/source_map/source_map_cache_map,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeForEach\x2C\x0d\n  ObjectFreeze\x2C\x0d\n  SafeFinalizationRegistry\x2C\x0d\n  SafeMap\x2C\x0d\n  SafeWeakRef\x2C\x0d\n  SymbolIterator\x2C\x0d\n} = primordials;\x0d\nconst {\x0d\n  privateSymbols: {\x0d\n    source_map_data_private_symbol\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('util');\x0d\n\x0d\n/**\x0d\n * Specialized map of WeakRefs to module instances that caches source map\x0d\n * entries by `filename` and `sourceURL`. Cached entries can be iterated with\x0d\n * `for..of` syntax.\x0d\n *\x0d\n * The cache map maintains the cache entries by:\x0d\n * - `weakModuleMap`(Map): a strong sourceURL -> WeakRef(Module)\x2C\x0d\n * - WeakRef(Module[source_map_data_private_symbol]): source map data.\x0d\n *\x0d\n * Obsolete `weakModuleMap` entries are removed by the `finalizationRegistry`\x0d\n * callback. This pattern decouples the strong url reference to the source map\x0d\n * data and allow the cache to be reclaimed eagerly\x2C without depending on an\x0d\n * indeterministic callback of a finalization registry.\x0d\n */\x0d\nclass SourceMapCacheMap {\x0d\n  /**\x0d\n   * @type {Map<string\x2C WeakRef<*>>}\x0d\n   * The cached module instance can be removed from the global module registry\x0d\n   * with approaches like mutating `require.cache`.\x0d\n   * The `weakModuleMap` exposes entries by `filename` and `sourceURL`.\x0d\n   * In the case of mutated module registry\x2C obsolete entries are removed from\x0d\n   * the cache by the `finalizationRegistry`.\x0d\n   */\x0d\n  #weakModuleMap = new SafeMap();\x0d\n\x0d\n  #cleanup = ({ keys }) => {\x0d\n    // Delete the entry if the weak target has been reclaimed.\x0d\n    // If the weak target is not reclaimed\x2C the entry was overridden by a new\x0d\n    // weak target.\x0d\n    ArrayPrototypeForEach(keys\x2C (key) => {\x0d\n      const ref = this.#weakModuleMap.get(key);\x0d\n      if (ref && ref.deref() === undefined) {\x0d\n        this.#weakModuleMap.delete(key);\x0d\n      }\x0d\n    });\x0d\n  };\x0d\n  #finalizationRegistry = new SafeFinalizationRegistry(this.#cleanup);\x0d\n\x0d\n  /**\x0d\n   * Sets the value for the given key\x2C associated with the given module\x0d\n   * instance.\x0d\n   * @param {string[]} keys array of urls to index the value entry.\x0d\n   * @param {*} sourceMapData the value entry.\x0d\n   * @param {object} moduleInstance an object that can be weakly referenced and\x0d\n   * invalidate the [key\x2C value] entry after this object is reclaimed.\x0d\n   */\x0d\n  set(keys\x2C sourceMapData\x2C moduleInstance) {\x0d\n    const weakRef = new SafeWeakRef(moduleInstance);\x0d\n    ArrayPrototypeForEach(keys\x2C (key) => this.#weakModuleMap.set(key\x2C weakRef));\x0d\n    moduleInstance[source_map_data_private_symbol] = sourceMapData;\x0d\n    this.#finalizationRegistry.register(moduleInstance\x2C { keys });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Get an entry by the given key.\x0d\n   * @param {string} key a file url or source url\x0d\n   */\x0d\n  get(key) {\x0d\n    const weakRef = this.#weakModuleMap.get(key);\x0d\n    const moduleInstance = weakRef?.deref();\x0d\n    if (moduleInstance === undefined) {\x0d\n      return;\x0d\n    }\x0d\n    return moduleInstance[source_map_data_private_symbol];\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Estimate the size of the cache. The actual size may be smaller because\x0d\n   * some entries may be reclaimed with the module instance.\x0d\n   */\x0d\n  get size() {\x0d\n    return this.#weakModuleMap.size;\x0d\n  }\x0d\n\x0d\n  [SymbolIterator]() {\x0d\n    const iterator = this.#weakModuleMap.entries();\x0d\n\x0d\n    const next = () => {\x0d\n      const result = iterator.next();\x0d\n      if (result.done) return result;\x0d\n      const { 0: key\x2C 1: weakRef } = result.value;\x0d\n      const moduleInstance = weakRef.deref();\x0d\n      if (moduleInstance == null) return next();\x0d\n      const value 