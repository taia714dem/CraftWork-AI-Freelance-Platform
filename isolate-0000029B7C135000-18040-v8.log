script-source,255,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/router/routes-resolver.js,import { Logger\x2C NotFoundException\x2C } from '@nestjs/common';\nimport { HOST_METADATA\x2C MODULE_PATH\x2C VERSION_METADATA\x2C } from '@nestjs/common/internal';\nimport { CONTROLLER_MAPPING_MESSAGE\x2C VERSIONED_CONTROLLER_MAPPING_MESSAGE\x2C } from '../helpers/messages.js';\nimport { MetadataScanner } from '../metadata-scanner.js';\nimport { RoutePathFactory } from './route-path-factory.js';\nimport { RouterExceptionFilters } from './router-exception-filters.js';\nimport { RouterExplorer } from './router-explorer.js';\nimport { RouterProxy } from './router-proxy.js';\nexport class RoutesResolver {\n    container;\n    applicationConfig;\n    injector;\n    logger = new Logger(RoutesResolver.name\x2C {\n        timestamp: true\x2C\n    });\n    routerProxy = new RouterProxy();\n    routePathFactory;\n    routerExceptionsFilter;\n    routerExplorer;\n    constructor(container\x2C applicationConfig\x2C injector\x2C graphInspector) {\n        this.container = container;\n        this.applicationConfig = applicationConfig;\n        this.injector = injector;\n        const httpAdapterRef = container.getHttpAdapterRef();\n        this.routerExceptionsFilter = new RouterExceptionFilters(container\x2C applicationConfig\x2C httpAdapterRef);\n        this.routePathFactory = new RoutePathFactory(this.applicationConfig);\n        const metadataScanner = new MetadataScanner();\n        this.routerExplorer = new RouterExplorer(metadataScanner\x2C this.container\x2C this.injector\x2C this.routerProxy\x2C this.routerExceptionsFilter\x2C this.applicationConfig\x2C this.routePathFactory\x2C graphInspector);\n    }\n    resolve(applicationRef\x2C globalPrefix\x2C options = {}) {\n        const modules = this.container.getModules();\n        modules.forEach(({ controllers\x2C metatype }\x2C moduleName) => {\n            const modulePath = this.getModulePathMetadata(metatype);\n            this.registerRouters(controllers\x2C moduleName\x2C globalPrefix\x2C modulePath\x2C applicationRef\x2C options);\n        });\n    }\n    registerResolvedRoute(applicationRef\x2C route) {\n        this.routerExplorer.registerResolvedRoute(applicationRef\x2C route);\n    }\n    registerRouters(routes\x2C moduleName\x2C globalPrefix\x2C modulePath\x2C applicationRef\x2C options = {}) {\n        routes.forEach(instanceWrapper => {\n            const { metatype } = instanceWrapper;\n            const host = this.getHostMetadata(metatype);\n            const routerPaths = this.routerExplorer.extractRouterPath(metatype);\n            const controllerVersion = this.getVersionMetadata(metatype);\n            const controllerName = metatype.name;\n            routerPaths.forEach(path => {\n                const pathsToLog = this.routePathFactory.create({\n                    ctrlPath: path\x2C\n                    modulePath\x2C\n                    globalPrefix\x2C\n                });\n                if (!controllerVersion) {\n                    pathsToLog.forEach(path => {\n                        const logMessage = CONTROLLER_MAPPING_MESSAGE(controllerName\x2C path);\n                        this.logger.log(logMessage);\n                    });\n                }\n                else {\n                    pathsToLog.forEach(path => {\n                        const logMessage = VERSIONED_CONTROLLER_MAPPING_MESSAGE(controllerName\x2C path\x2C controllerVersion);\n                        this.logger.log(logMessage);\n                    });\n                }\n                const versioningOptions = this.applicationConfig.getVersioning();\n                const routePathMetadata = {\n                    ctrlPath: path\x2C\n                    modulePath\x2C\n                    globalPrefix\x2C\n                    controllerVersion\x2C\n                    versioningOptions\x2C\n                };\n                this.routerExplorer.explore(instanceWrapper\x2C moduleName\x2C applicationRef\x2C host\x2C routePathMetadata\x2C options);\n            });\n        });\n    }\n    registerNotFoundHandler() {\n        const applicationRef = this.container.getHttpAdapterRef();\n        const callback = (req\x2C res) => {\n            const method = applicationRef.getRequestMethod(req);\n            const url = applicationRef.getRequestUrl(req);\n            throw new NotFoundException(`Cannot ${method} ${url}`);\n        };\n        const handler = this.routerExceptionsFilter.create({}\x2C callback\x2C undefined);\n        const proxy = this.routerProxy.createProxy(callback\x2C handler);\n        const prefix = this.applicationConfig.getGlobalPrefix();\n        applicationRef.setNotFoundHandler &&\n            applicationRef.setNotFoundHandler(proxy\x2C prefix);\n    }\n    registerExceptionHandler() {\n        const callback = (err\x2C req\x2C res\x2C next) => {\n            throw this.container.getHttpAdapterRef().mapException(err);\n        };\n        const handler = this.routerExceptionsFilter.create({}\x2C callback\x2C undefined);\n        const proxy = this.routerProxy.createExceptionLayerProxy(callback\x2C handler);\n        const applicationRef = this.container.getHttpAdapterRef();\n        const prefix = this.applicationConfig.getGlobalPrefix();\n        applicationRef.setErrorHandler &&\n            applicationRef.setErrorHandler(proxy\x2C prefix);\n    }\n    getModulePathMetadata(metatype) {\n        const modulesContainer = this.container.getModules();\n        const modulePath = Reflect.getMetadata(MODULE_PATH + modulesContainer.applicationId\x2C metatype);\n        return modulePath ?? Reflect.getMetadata(MODULE_PATH\x2C metatype);\n    }\n    getHostMetadata(metatype) {\n        return Reflect.getMetadata(HOST_METADATA\x2C metatype);\n    }\n    getVersionMetadata(metatype) {\n        const versioningConfig = this.applicationConfig.getVersioning();\n        if (versioningConfig) {\n            return (Reflect.getMetadata(VERSION_METADATA\x2C metatype) ??\n                versioningConfig.defaultVersion);\n        }\n    }\n}\n
