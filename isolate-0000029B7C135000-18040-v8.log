script-source,729,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/helpers/external-proxy.js,import { ExecutionContextHost } from '../helpers/execution-context-host.js';\nexport class ExternalErrorProxy {\n    createProxy(targetCallback\x2C exceptionsHandler\x2C type) {\n        return async (...args) => {\n            try {\n                return await targetCallback(...args);\n            }\n            catch (e) {\n                const host = new ExecutionContextHost(args);\n                host.setType(type);\n                return exceptionsHandler.next(e\x2C host);\n            }\n        };\n    }\n}\n
