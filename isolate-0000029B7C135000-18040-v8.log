t(!state.closed);\x0d\n    if (!state.didRead) {\x0d\n      state.didRead = true;\x0d\n      this[kStream].on('data'\x2C onStreamData);\x0d\n    } else {\x0d\n      process.nextTick(resumeStream\x2C this[kStream]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  get method() {\x0d\n    return this[kHeaders][HTTP2_HEADER_METHOD];\x0d\n  }\x0d\n\x0d\n  set method(method) {\x0d\n    validateString(method\x2C 'method');\x0d\n    if (method.trim() === '')\x0d\n      throw new ERR_INVALID_ARG_VALUE('method'\x2C method);\x0d\n\x0d\n    this[kHeaders][HTTP2_HEADER_METHOD] = method;\x0d\n  }\x0d\n\x0d\n  get authority() {\x0d\n    return getAuthority(this[kHeaders]);\x0d\n  }\x0d\n\x0d\n  get scheme() {\x0d\n    return this[kHeaders][HTTP2_HEADER_SCHEME];\x0d\n  }\x0d\n\x0d\n  get url() {\x0d\n    return this[kHeaders][HTTP2_HEADER_PATH];\x0d\n  }\x0d\n\x0d\n  set url(url) {\x0d\n    this[kHeaders][HTTP2_HEADER_PATH] = url;\x0d\n  }\x0d\n\x0d\n  setTimeout(msecs\x2C callback) {\x0d\n    if (!this[kState].closed)\x0d\n      this[kStream].setTimeout(msecs\x2C callback);\x0d\n    return this;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onStreamTrailersReady() {\x0d\n  this.sendTrailers(this[kResponse][kTrailers]);\x0d\n}\x0d\n\x0d\nfunction onStreamCloseResponse() {\x0d\n  const res = this[kResponse];\x0d\n\x0d\n  if (res === undefined)\x0d\n    return;\x0d\n\x0d\n  const state = res[kState];\x0d\n\x0d\n  if (this.headRequest !== state.headRequest)\x0d\n    return;\x0d\n\x0d\n  state.closed = true;\x0d\n\x0d\n  this[kProxySocket] = null;\x0d\n\x0d\n  this.removeListener('wantTrailers'\x2C onStreamTrailersReady);\x0d\n  this[kResponse] = undefined;\x0d\n\x0d\n  res.emit('finish');\x0d\n  res.emit('close');\x0d\n}\x0d\n\x0d\nclass Http2ServerResponse extends Stream {\x0d\n  constructor(stream\x2C options) {\x0d\n    super(options);\x0d\n    this[kState] = {\x0d\n      closed: false\x2C\x0d\n      ending: false\x2C\x0d\n      destroyed: false\x2C\x0d\n      headRequest: false\x2C\x0d\n      sendDate: true\x2C\x0d\n      statusCode: HTTP_STATUS_OK\x2C\x0d\n    };\x0d\n    this[kHeaders] = { __proto__: null };\x0d\n    this[kTrailers] = { __proto__: null };\x0d\n    this[kStream] = stream;\x0d\n    stream[kProxySocket] = null;\x0d\n    stream[kResponse] = this;\x0d\n    this.writable = true;\x0d\n    this.req = stream[kRequest];\x0d\n    stream.on('drain'\x2C onStreamDrain);\x0d\n    stream.on('aborted'\x2C onStreamAbortedResponse);\x0d\n    stream.on('close'\x2C onStreamCloseResponse);\x0d\n    stream.on('wantTrailers'\x2C onStreamTrailersReady);\x0d\n    stream.on('timeout'\x2C onStreamTimeout(kResponse));\x0d\n  }\x0d\n\x0d\n  // User land modules such as finalhandler just check truthiness of this\x0d\n  // but if someone is actually trying to use this for more than that\x0d\n  // then we simply can't support such use cases\x0d\n  get _header() {\x0d\n    return this.headersSent;\x0d\n  }\x0d\n\x0d\n  get writableEnded() {\x0d\n    const state = this[kState];\x0d\n    return state.ending;\x0d\n  }\x0d\n\x0d\n  get finished() {\x0d\n    const state = this[kState];\x0d\n    return state.ending;\x0d\n  }\x0d\n\x0d\n  get socket() {\x0d\n    // This is compatible with http1 which removes socket reference\x0d\n    // only from ServerResponse but not IncomingMessage\x0d\n    if (this[kState].closed)\x0d\n      return undefined;\x0d\n\x0d\n    const stream = this[kStream];\x0d\n    const proxySocket = stream[kProxySocket];\x0d\n    if (proxySocket === null)\x0d\n      return stream[kProxySocket] = new Proxy(stream\x2C proxySocketHandler);\x0d\n    return proxySocket;\x0d\n  }\x0d\n\x0d\n  get connection() {\x0d\n    return this.socket;\x0d\n  }\x0d\n\x0d\n  get stream() {\x0d\n    return this[kStream];\x0d\n  }\x0d\n\x0d\n  get headersSent() {\x0d\n    return this[kStream].headersSent;\x0d\n  }\x0d\n\x0d\n  get sendDate() {\x0d\n    return this[kState].sendDate;\x0d\n  }\x0d\n\x0d\n  set sendDate(bool) {\x0d\n    this[kState].sendDate = Boolean(bool);\x0d\n  }\x0d\n\x0d\n  get statusCode() {\x0d\n    return this[kState].statusCode;\x0d\n  }\x0d\n\x0d\n  get writableCorked() {\x0d\n    return this[kStream].writableCorked;\x0d\n  }\x0d\n\x0d\n  get writableHighWaterMark() {\x0d\n    return this[kStream].writableHighWaterMark;\x0d\n  }\x0d\n\x0d\n  get writableFinished() {\x0d\n    return this[kStream].writableFinished;\x0d\n  }\x0d\n\x0d\n  get writableLength() {\x0d\n    return this[kStream].writableLength;\x0d\n  }\x0d\n\x0d\n  set statusCode(code) {\x0d\n    code |= 0;\x0d\n    if (code >= 100 && code < 200)\x0d\n      throw new ERR_HTTP2_INFO_STATUS_NOT_ALLOWED();\x0d\n    if (code < 100 || code > 599)\x0d\n      throw new ERR_HTTP2_STATUS_INVALID(code);\x0d\n    this[kState].statusCode = code;\x0d\n  }\x0d\n\x0d\n  setTrailer(name\x2C value) {\x0d\n    validateString(name\x2C 'name');\x0d\n    name = name.trim().toLowerCase();\x0d\n    assertValidHeader(name\x2C value);\x0d\n    this[kTrailers][name] = value;\x0d\n  }\x0d\n\x0d\n  addTrailers(headers) {\x0d\n    const keys = ObjectKeys(headers);\x0d\n    let key = '';\x0d\n    for (let i = 0; i < keys.length; i++) {\x0d\n      key = keys[i];\x0d\n      this.setTrailer(key\x2C headers[key]);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  getHeader(name) {\x0d\n    validateString(name\x2C 'name');\x0d\n    name = name.trim().toLowerCase();\x0d\n    return this[kHeaders][name];\x0d\n  }\x0d\n\x0d\n  getHeaderNames() {\x0d\n    return ObjectKeys(this[kHeaders]);\x0d\n  }\x0d\n\x0d\n  getHeaders() {\x0d\n    const headers = { __proto__: null };\x0d\n    return ObjectAssign(headers\x2C this[kHeaders]);\x0d\n  }\x0d\n\x0d\n  hasHeader(name) {\x0d\n    validateString(name\x2C 'name');\x0d\n    name = name.trim().toLowerCase();\x0d\n    return ObjectHasOwn(this[kHeaders]\x2C name);\x0d\n  }\x0d\n\x0d\n  removeHeader(name) {\x0d\n    validateString(name\x2C 'name');\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    name = name.trim().toLowerCase();\x0d\n\x0d\n    if (name === 'date') {\x0d\n      this[kState].sendDate = false;\x0d\n\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    delete this[kHeaders][name];\x0d\n  }\x0d\n\x0d\n  setHeader(name\x2C value) {\x0d\n    validateString(name\x2C 'name');\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    this[kSetHeader](name\x2C value);\x0d\n  }\x0d\n\x0d\n  [kSetHeader](name\x2C value) {\x0d\n    name = name.trim().toLowerCase();\x0d\n    assertValidHeader(name\x2C value);\x0d\n\x0d\n    if (!isConnectionHeaderAllowed(name\x2C value)) {\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    if (name[0] === ':')\x0d\n      assertValidPseudoHeader(name);\x0d\n    else if (!checkIsHttpToken(name))\x0d\n      this.destroy(new ERR_INVALID_HTTP_TOKEN('Header name'\x2C name));\x0d\n\x0d\n    this[kHeaders][name] = value;\x0d\n  }\x0d\n\x0d\n  appendHeader(name\x2C value) {\x0d\n    validateString(name\x2C 'name');\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    this[kAppendHeader](name\x2C value);\x0d\n  }\x0d\n\x0d\n  [kAppendHeader](name\x2C value) {\x0d\n    name = name.trim().toLowerCase();\x0d\n    assertValidHeader(name\x2C value);\x0d\n\x0d\n    if (!isConnectionHeaderAllowed(name\x2C value)) {\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    if (name[0] === ':')\x0d\n      assertValidPseudoHeader(name);\x0d\n    else if (!checkIsHttpToken(name))\x0d\n      this.destroy(new ERR_INVALID_HTTP_TOKEN('Header name'\x2C name));\x0d\n\x0d\n    // Handle various possible cases the same as OutgoingMessage.appendHeader:\x0d\n    const headers = this[kHeaders];\x0d\n    if (headers === null || !headers[name]) {\x0d\n      return this.setHeader(name\x2C value);\x0d\n    }\x0d\n\x0d\n    if (!ArrayIsArray(headers[name])) {\x0d\n      headers[name] = [headers[name]];\x0d\n    }\x0d\n\x0d\n    const existingValues = headers[name];\x0d\n    if (ArrayIsArray(value)) {\x0d\n      for (let i = 0\x2C length = value.length; i < length; i++) {\x0d\n        existingValues.push(value[i]);\x0d\n      }\x0d\n    } else {\x0d\n      existingValues.push(value);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  get statusMessage() {\x0d\n    statusMessageWarn();\x0d\n\x0d\n    return '';\x0d\n  }\x0d\n\x0d\n  set statusMessage(msg) {\x0d\n    statusMessageWarn();\x0d\n  }\x0d\n\x0d\n  flushHeaders() {\x0d\n    const state = this[kState];\x0d\n    if (!state.closed && !this[kStream].headersSent)\x0d\n      this.writeHead(state.statusCode);\x0d\n  }\x0d\n\x0d\n  writeHead(statusCode\x2C statusMessage\x2C headers) {\x0d\n    const state = this[kState];\x0d\n\x0d\n    if (state.closed || this.stream.destroyed)\x0d\n      return this;\x0d\n    if (this[kStream].headersSent)\x0d\n      throw new ERR_HTTP2_HEADERS_SENT();\x0d\n\x0d\n    if (typeof statusMessage === 'string')\x0d\n      statusMessageWarn();\x0d\n\x0d\n    if (headers === undefined && typeof statusMessage === 'object')\x0d\n      headers = statusMessage;\x0d\n\x0d\n    let i;\x0d\n    if (ArrayIsArray(headers)) {\x0d\n      if (this[kHeaders]) {\x0d\n        // Headers in obj should override previous headers but still\x0d\n        // allow explicit duplicates. To do so\x2C we first remove any\x0d\n        // existing conflicts\x2C then use appendHeader. This is the\x0d\n        // slow path\x2C which only applies when you use setHeader and\x0d\n        // then pass headers in writeHead too.\x0d\n\x0d\n        // We need to handle both the tuple and flat array formats\x2C just\x0d\n        // like the logic further below.\x0d\n        if (headers.length && ArrayIsArray(headers[0])) {\x0d\n          for (let n = 0; n < headers.length; n += 1) {\x0d\n            const key = headers[n + 0][0];\x0d\n            this.removeHeader(key);\x0d\n          }\x0d\n        } else {\x0d\n          for (let n = 0; n < headers.length; n += 2) {\x0d\n            const key = headers[n + 0];\x0d\n            this.removeHeader(key);\x0d\n          }\x0d\n        }\x0d\n      }\x0d\n\x0d\n      // Append all the headers provided in the array:\x0d\n      if (headers.length && ArrayIsArray(headers[0])) {\x0d\n        for (i = 0; i < headers.length; i++) {\x0d\n          const header = headers[i];\x0d\n          this[kAppendHeader](header[0]\x2C header[1]);\x0d\n        }\x0d\n      } else {\x0d\n        if (headers.length % 2 !== 0) {\x0d\n          throw new ERR_INVALID_ARG_VALUE('headers'\x2C headers);\x0d\n        }\x0d\n\x0d\n        for (i = 0; i < headers.length; i += 2) {\x0d\n          this[kAppendHeader](headers[i]\x2C headers[i + 1]);\x0d\n        }\x0d\n      }\x0d\n    } else if (typeof headers === 'object') {\x0d\n      const keys = ObjectKeys(headers);\x0d\n      let key = '';\x0d\n      for (i = 0; i < keys.length; i++) {\x0d\n        key = keys[i];\x0d\n        this[kSetHeader](key\x2C headers[key]);\x0d\n      }\x0d\n    }\x0d\n\x0d\n    state.statusCode = statusCode;\x0d\n    this[kBeginSend]();\x0d\n\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  cork() {\x0d\n    this[kStream].cork();\x0d\n  }\x0d\n\x0d\n  uncork() {\x0d\n    this[kStream].uncork();\x0d\n  }\x0d\n\x0d\n  write(chunk\x2C encoding\x2C cb) {\x0d\n    const state = this[kState];\x0d\n\x0d\n    if (typeof encoding === 'function') {\x0d\n      cb = encoding;\x0d\n      encoding = 'utf8';\x0d\n    }\x0d\n\x0d\n    let err;\x0d\n    if (state.ending) {\x0d\n      err = new ERR_STREAM_WRITE_AFTER_END();\x0d\n    } else if (state.closed) {\x0d\n      err = new ERR_HTTP2_INVALID_STREAM();\x0d\n    } else if (state.destroyed) {\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    if (err) {\x0d\n      if (typeof cb === 'function')\x0d\n        process.nextTick(cb\x2C err);\x0d\n      this.destroy(err);\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    const stream = this[kStream];\x0d\n    if (!stream.headersSent)\x0d\n      this.writeHead(state.statusCode);\x0d\n    return stream.write(chunk\x2C encoding\x2C cb);\x0d\n  }\x0d\n\x0d\n  end(chunk\x2C encoding\x2C cb) {\x0d\n    const stream = this[kStream];\x0d\n    const state = this[kState];\x0d\n\x0d\n    if (typeof chunk === 'function') {\x0d\n      cb = chunk;\x0d\n      chunk = null;\x0d\n    } else if (typeof encoding === 'function') {\x0d\n      cb = encoding;\x0d\n      encoding = 'utf8';\x0d\n    }\x0d\n\x0d\n    if ((state.closed || state.ending) &&\x0d\n        state.headRequest === stream.headRequest) {\x0d\n      if (typeof cb === 'function') {\x0d\n        process.nextTick(cb);\x0d\n      }\x0d\n      return this;\x0d\n    }\x0d\n\x0d\n    if (chunk !== null && chunk !== undefined)\x0d\n      this.write(chunk\x2C encoding);\x0d\n\x0d\n    state.headRequest = stream.headRequest;\x0d\n    state.ending = true;\x0d\n\x0d\n    if (typeof cb === 'function') {\x0d\n      if (stream.writableEnded)\x0d\n        this.once('finish'\x2C cb);\x0d\n      else\x0d\n        stream.once('finish'\x2C cb);\x0d\n    }\x0d\n\x0d\n    if (!stream.headersSent)\x0d\n      this.writeHead(this[kState].statusCode);\x0d\n\x0d\n    if (this[kState].closed || stream.destroyed)\x0d\n      ReflectApply(onStreamCloseResponse\x2C stream\x2C []);\x0d\n    else\x0d\n      stream.end();\x0d\n\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  destroy(err) {\x0d\n    if (this[kState].destroyed)\x0d\n      return;\x0d\n\x0d\n    this[kState].destroyed = true;\x0d\n    this[kStream].destroy(err);\x0d\n  }\x0d\n\x0d\n  setTimeout(msecs\x2C callback) {\x0d\n    if (this[kState].closed)\x0d\n      return;\x0d\n    this[kStream].setTimeout(msecs\x2C callback);\x0d\n  }\x0d\n\x0d\n  createPushResponse(headers\x2C callback) {\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n    if (this[kState].closed) {\x0d\n      process.nextTick(callback\x2C new ERR_HTTP2_INVALID_STREAM());\x0d\n      return;\x0d\n    }\x0d\n    this[kStream].pushStream(headers\x2C {}\x2C (err\x2C stream\x2C headers\x2C options) => {\x0d\n      if (err) {\x0d\n        callback(err);\x0d\n        return;\x0d\n      }\x0d\n      callback(null\x2C new Http2ServerResponse(stream));\x0d\n    });\x0d\n  }\x0d\n\x0d\n  [kBeginSend]() {\x0d\n    const state = this[kState];\x0d\n    const headers = this[kHeaders];\x0d\n    headers[HTTP2_HEADER_STATUS] = state.statusCode;\x0d\n    const options = {\x0d\n      endStream: state.ending\x2C\x0d\n      waitForTrailers: true\x2C\x0d\n      sendDate: state.sendDate\x2C\x0d\n    };\x0d\n    this[kStream].respond(headers\x2C options);\x0d\n  }\x0d\n\x0d\n  // TODO doesn't support callbacks\x0d\n  writeContinue() {\x0d\n    const stream = this[kStream];\x0d\n    if (stream.headersSent || this[kState].closed)\x0d\n      return false;\x0d\n    stream.additionalHeaders({\x0d\n      [HTTP2_HEADER_STATUS]: HTTP_STATUS_CONTINUE\x2C\x0d\n    });\x0d\n    return true;\x0d\n  }\x0d\n\x0d\n  writeEarlyHints(hints) {\x0d\n    validateObject(hints\x2C 'hints');\x0d\n\x0d\n    const headers = { __proto__: null };\x0d\n\x0d\n    const linkHeaderValue = validateLinkHeaderValue(hints.link);\x0d\n\x0d\n    for (const key of ObjectKeys(hints)) {\x0d\n      if (key !== 'link') {\x0d\n        headers[key] = hints[key];\x0d\n      }\x0d\n    }\x0d\n\x0d\n    if (linkHeaderValue.length === 0) {\x0d\n      return false;\x0d\n    }\x0d\n\x0d\n    const stream = this[kStream];\x0d\n\x0d\n    if (stream.headersSent || this[kState].closed)\x0d\n      return false;\x0d\n\x0d\n    stream.additionalHeaders({\x0d\n      ...headers\x2C\x0d\n      [HTTP2_HEADER_STATUS]: HTTP_STATUS_EARLY_HINTS\x2C\x0d\n      'Link': linkHeaderValue\x2C\x0d\n    });\x0d\n\x0d\n    return true;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction onServerStream(ServerRequest\x2C ServerResponse\x2C\x0d\n                        stream\x2C headers\x2C flags\x2C rawHeaders) {\x0d\n  const server = this;\x0d\n  const request = new ServerRequest(stream\x2C headers\x2C undefined\x2C rawHeaders);\x0d\n  const response = new ServerResponse(stream);\x0d\n\x0d\n  // Check for the CONNECT method\x0d\n  const method = head