script-source,762,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/helpers/messages.js,import { RequestMethod\x2C VERSION_NEUTRAL } from '@nestjs/common';\nexport const MODULE_INIT_MESSAGE = (text\x2C module) => `${module} dependencies initialized`;\nexport const ROUTE_MAPPED_MESSAGE = (path\x2C method) => `Mapped {${path}\x2C ${RequestMethod[method]}} route`;\nexport const VERSIONED_ROUTE_MAPPED_MESSAGE = (path\x2C method\x2C version) => {\n    const controllerVersions = Array.isArray(version) ? version : [version];\n    const versions = controllerVersions\n        .map(version => (version === VERSION_NEUTRAL ? 'Neutral' : version))\n        .join('\x2C');\n    return `Mapped {${path}\x2C ${RequestMethod[method]}} (version: ${versions}) route`;\n};\nexport const CONTROLLER_MAPPING_MESSAGE = (name\x2C path) => `${name} {${path}}:`;\nexport const VERSIONED_CONTROLLER_MAPPING_MESSAGE = (name\x2C path\x2C version) => {\n    const controllerVersions = Array.isArray(version) ? version : [version];\n    const versions = controllerVersions\n        .map(version => (version === VERSION_NEUTRAL ? 'Neutral' : version))\n        .join('\x2C');\n    return `${name} {${path}} (version: ${versions}):`;\n};\nexport const INVALID_EXECUTION_CONTEXT = (methodName\x2C currentContext) => `Calling ${methodName} is not allowed in this context. Your current execution context is "${currentContext}".`;\n
