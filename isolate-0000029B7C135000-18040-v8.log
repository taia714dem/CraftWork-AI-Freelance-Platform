script-source,189,node:internal/source_map/prepare_stack_trace,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeIndexOf\x2C\x0d\n  ArrayPrototypeJoin\x2C\x0d\n  ArrayPrototypeMap\x2C\x0d\n  ErrorPrototypeToString\x2C\x0d\n  RegExpPrototypeSymbolSplit\x2C\x0d\n  SafeStringIterator\x2C\x0d\n  StringPrototypeRepeat\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n} = primordials;\x0d\n\x0d\nlet debug = require('internal/util/debuglog').debuglog('source_map'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { getStringWidth } = require('internal/util/inspect');\x0d\nconst { readFileSync } = require('fs');\x0d\nconst { findSourceMap } = require('internal/source_map/source_map_cache');\x0d\nconst {\x0d\n  kIsNodeError\x2C\x0d\n} = require('internal/errors');\x0d\nconst { fileURLToPath } = require('internal/url');\x0d\nconst { setGetSourceMapErrorSource } = internalBinding('errors');\x0d\n\x0d\nconst kStackLineAt = '\\n    at ';\x0d\n\x0d\n// Create a prettified stacktrace\x2C inserting context from source maps\x0d\n// if possible.\x0d\nfunction prepareStackTraceWithSourceMaps(error\x2C trace) {\x0d\n  let errorString;\x0d\n  if (kIsNodeError in error) {\x0d\n    errorString = `${error.name} [${error.code}]: ${error.message}`;\x0d\n  } else {\x0d\n    errorString = ErrorPrototypeToString(error);\x0d\n  }\x0d\n\x0d\n  if (trace.length === 0) {\x0d\n    return errorString;\x0d\n  }\x0d\n\x0d\n  let lastSourceMap;\x0d\n  let lastFileName;\x0d\n  const preparedTrace = ArrayPrototypeJoin(ArrayPrototypeMap(trace\x2C (callSite\x2C i) => {\x0d\n    try {\x0d\n      // A stack trace will often have several call sites in a row within the\x0d\n      // same file\x2C cache the source map and file content accordingly:\x0d\n      let fileName = callSite.getFileName();\x0d\n      if (fileName === undefined) {\x0d\n        fileName = callSite.getEvalOrigin();\x0d\n      }\x0d\n      const sm = fileName === lastFileName ?\x0d\n        lastSourceMap :\x0d\n        findSourceMap(fileName);\x0d\n      lastSourceMap = sm;\x0d\n      lastFileName = fileName;\x0d\n      if (sm) {\x0d\n        return `${kStackLineAt}${serializeJSStackFrame(sm\x2C callSite\x2C trace[i + 1])}`;\x0d\n      }\x0d\n    } catch (err) {\x0d\n      debug(err);\x0d\n    }\x0d\n    return `${kStackLineAt}${callSite}`;\x0d\n  })\x2C '');\x0d\n  return `${errorString}${preparedTrace}`;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Serialize a single call site in the stack trace.\x0d\n * Refer to SerializeJSStackFrame in deps/v8/src/objects/call-site-info.cc for\x0d\n * more details about the default ToString(CallSite).\x0d\n * The CallSite API is documented at https://v8.dev/docs/stack-trace-api.\x0d\n * @param {import('internal/source_map/source_map').SourceMap} sm\x0d\n * @param {CallSite} callSite - the CallSite object to be serialized\x0d\n * @param {CallSite} callerCallSite - caller site info\x0d\n * @returns {string} - the serialized call site\x0d\n */\x0d\nfunction serializeJSStackFrame(sm\x2C callSite\x2C callerCallSite) {\x0d\n  // Source Map V3 lines/columns start at 0/0 whereas stack traces\x0d\n  // start at 1/1:\x0d\n  const {\x0d\n    originalLine\x2C\x0d\n    originalColumn\x2C\x0d\n    originalSource\x2C\x0d\n  } = sm.findEntry(callSite.getLineNumber() - 1\x2C callSite.getColumnNumber() - 1);\x0d\n  if (originalSource === undefined || originalLine === undefined ||\x0d\n      originalColumn === undefined) {\x0d\n    return `${callSite}`;\x0d\n  }\x0d\n  const name = getOriginalSymbolName(sm\x2C callSite\x2C callerCallSite);\x0d\n  const originalSourceNoScheme =\x0d\n    StringPrototypeStartsWith(originalSource\x2C 'file://') ?\x0d\n      fileURLToPath(originalSource) : originalSource;\x0d\n  // Construct call site name based on: v8.dev/docs/stack-trace-api:\x0d\n  const fnName = callSite.getFunctionName() ?? callSite.getMethodName();\x0d\n\x0d\n  let prefix = '';\x0d\n  if (callSite.isAsync()) {\x0d\n    // Promise aggregation operation frame has no locations. This must be an\x0d\n    // async stack frame.\x0d\n    prefix = 'async ';\x0d\n  } else if (callSite.isConstructor()) {\x0d\n    prefix = 'new ';\x0d\n  }\x0d\n\x0d\n  const typeName = callSite.getTypeName();\x0d\n  const namePrefix = typeName !== null && typeName !== 'global' ? `${typeName}.` : '';\x0d\n  const originalName = `${namePrefix}${fnName || '<anonymous>'}`;\x0d\n  // The original call site may have a different symbol name\x0d\n  // associated with it\x2C use it:\x0d\n  const mappedName = (name && name !== originalName) ?\x0d\n    `${name}` :\x0d\n    `${originalName}`;\x0d\n  const hasName = !!(name || originalName);\x0d\n  // Replace the transpiled call site with the original:\x0d\n  return `${prefix}${mappedName}${hasName ? ' (' : ''}` +\x0d\n    `${originalSourceNoScheme}:${originalLine + 1}:` +\x0d\n    `${originalColumn + 1}${hasName ? ')' : ''}`;\x0d\n}\x0d\n\x0d\n// Transpilers may have removed the original symbol name used in the stack\x0d\n// trace\x2C if possible restore it from the names field of the source map:\x0d\nfunction getOriginalSymbolName(sourceMap\x2C callSite\x2C callerCallSite) {\x0d\n  // First check for a symbol name associated with the enclosing function:\x0d\n  const enclosingEntry = sourceMap.findEntry(\x0d\n    callSite.getEnclosingLineNumber() - 1\x2C\x0d\n    callSite.getEnclosingColumnNumber() - 1\x2C\x0d\n  );\x0d\n  if (enclosingEntry.name) return enclosingEntry.name;\x0d\n  // Fallback to using the symbol name attached to the caller site:\x0d\n  const currentFileName = callSite.getFileName();\x0d\n  if (callerCallSite && currentFileName === callerCallSite.getFileName()) {\x0d\n    const { name } = sourceMap.findEntry(\x0d\n      callerCallSite.getLineNumber() - 1\x2C\x0d\n      callerCallSite.getColumnNumber() - 1\x2C\x0d\n    );\x0d\n    return name;\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Return a snippet of code from where the exception was originally thrown\x0d\n * above the stack trace. This called from GetErrorSource in node_errors.cc.\x0d\n * @param {import('internal/source_map/source_map').SourceMap} sourceMap - the source map to be used\x0d\n * @param {string} originalSourcePath - path or url of the original source\x0d\n * @param {number} originalLine - line number in the original source\x0d\n * @param {number} originalColumn - column number in the original source\x0d\n * @returns {string | undefined} - the exact line in the source content or undefined if file not found\x0d\n */\x0d\nfunction getErrorSource(\x0d\n  sourceMap\x2C\x0d\n  originalSourcePath\x2C\x0d\n  originalLine\x2C\x0d\n  originalColumn\x2C\x0d\n) {\x0d\n  const originalSourcePathNoScheme =\x0d\n    StringPrototypeStartsWith(originalSourcePath\x2C 'file://') ?\x0d\n      fileURLToPath(originalSourcePath) : originalSourcePath;\x0d\n  const source = getOriginalSource(\x0d\n    sourceMap.payload\x2C\x0d\n    originalSourcePath\x2C\x0d\n  );\x0d\n  if (typeof source !== 'string') {\x0d\n    return;\x0d\n  }\x0d\n  const lines = RegExpPrototypeSymbolSplit(/\\r?\\n/\x2C source\x2C originalLine + 1);\x0d\n  const line = lines[originalLine];\x0d\n  if (!line) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Display ^ in appropriate position\x2C regardless of whether tabs or\x0d\n  // spaces are used:\x0d\n  let prefix = '';\x0d\n  for (const character of new SafeStringIterator(\x0d\n    StringPrototypeSlice(line\x2C 0\x2C originalColumn + 1))) {\x0d\n    prefix += character === '\\t' ? '\\t' :\x0d\n      StringPrototypeRepeat(' '\x2C getStringWidth(character));\x0d\n  }\x0d\n  prefix = StringPrototypeSlice(prefix\x2C 0\x2C -1); // The last character is '^'.\x0d\n\x0d\n  const exceptionLine =\x0d\n   `${originalSourcePathNoScheme}:${originalLine + 1}\\n${line}\\n${prefix}^\\n\\n`;\x0d\n  return exceptionLine;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Retrieve the original source code from the source map's `sources` list or disk.\x0d\n * @param {import('internal/source_map/source_map').SourceMap.payload} payload\x0d\n * @param {string} originalSourcePath - path or url of the original source\x0d\n * @returns {string | undefined} - the source content or undefined if file not found\x0d\n */\x0d\nfunction getOriginalSource(payload\x2C originalSourcePath) {\x0d\n  let source;\x0d\n  // payload.sources has been normalized to be an array of absolute urls.\x0d\n  const sourceContentIndex =\x0d\n    ArrayPrototypeIndexOf(payload.sources\x2C originalSourcePath);\x0d\n  if (payload.sourcesContent?.[sourceContentIndex]) {\x0d\n    // First we check if the original source content was provided in the\x0d\n    // source map itself:\x0d\n    source = payload.sourcesContent[sourceContentIndex];\x0d\n  } else if (StringPrototypeStartsWith(originalSourcePath\x2C 'file://')) {\x0d\n    // If no sourcesContent was found\x2C attempt to load the original source\x0d\n    // from disk:\x0d\n    debug(`read source of ${originalSourcePath} from filesystem`);\x0d\n    const originalSourcePathNoScheme = fileURLToPath(originalSourcePath);\x0d\n    try {\x0d\n      source = readFileSync(originalSourcePathNoScheme\x2C 'utf8');\x0d\n    } catch (err) {\x0d\n      debug(err);\x0d\n    }\x0d\n  }\x0d\n  return source;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Retrieve exact line in the original source code from the source map's `sources` list or disk.\x0d\n * @param {string} fileName - actual file name\x0d\n * @param {number} lineNumber - actual line number\x0d\n * @param {number} columnNumber - actual column number\x0d\n * @returns {string | undefined} - the source content or undefined if file not found\x0d\n */\x0d\nfunction getSourceMapErrorSource(fileName\x2C lineNumber\x2C columnNumber) {\x0d\n  const sm = findSourceMap(fileName);\x0d\n  if (sm === undefined) {\x0d\n    return;\x0d\n  }\x0d\n  const {\x0d\n    originalLine\x2C\x0d\n    originalColumn\x2C\x0d\n    originalSource\x2C\x0d\n  } = sm.findEntry(lineNumber - 1\x2C columnNumber);\x0d\n  const errorSource = getErrorSource(sm\x2C originalSource\x2C originalLine\x2C originalColumn);\x0d\n  return errorSource;\x0d\n}\x0d\n\x0d\nsetGetSourceMapErrorSource(getSourceMapErrorSource);\x0d\n\x0d\nmodule.exports = {\x0d\n  prepareStackTraceWithSourceMaps\x2C\x0d\n};\x0d\n
