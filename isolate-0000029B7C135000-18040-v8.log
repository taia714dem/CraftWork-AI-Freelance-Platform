         throw new UnknownElementException();\n            }\n            return instance;\n        };\n        if (Array.isArray(instanceLinkOrArray)) {\n            return Promise.all(instanceLinkOrArray.map(instanceLink => pluckInstance(instanceLink)));\n        }\n        return pluckInstance(instanceLinkOrArray);\n    }\n}\n
