moduleKey\x2C requestMethod\x2C contextId = STATIC_CONTEXT\x2C inquirerId) {\n        const contextType = 'http';\n        const { argsLength\x2C fnHandleResponse\x2C isSseHandler\x2C paramtypes\x2C getParamsMetadata\x2C httpStatusCode\x2C responseHeaders\x2C hasCustomHeaders\x2C } = this.getMetadata(instance\x2C callback\x2C methodName\x2C moduleKey\x2C requestMethod\x2C contextType);\n        const paramsOptions = this.contextUtils.mergeParamsMetatypes(getParamsMetadata(moduleKey\x2C contextId\x2C inquirerId)\x2C paramtypes);\n        const pipes = this.pipesContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId);\n        const guards = this.guardsContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId);\n        const interceptors = this.interceptorsContextCreator.create(instance\x2C callback\x2C moduleKey\x2C contextId\x2C inquirerId);\n        const fnCanActivate = this.createGuardsFn(guards\x2C instance\x2C callback\x2C contextType);\n        const fnApplyPipes = this.createPipesFn(pipes\x2C paramsOptions);\n        const handler = (args\x2C req\x2C res\x2C next) => async () => {\n            fnApplyPipes && (await fnApplyPipes(args\x2C req\x2C res\x2C next));\n            return callback.apply(instance\x2C args);\n        };\n        return async (req\x2C res\x2C next) => {\n            const args = this.contextUtils.createNullArray(argsLength);\n            fnCanActivate && (await fnCanActivate([req\x2C res\x2C next]));\n            this.responseController.setStatus(res\x2C httpStatusCode);\n            hasCustomHeaders &&\n                this.responseController.setHeaders(res\x2C responseHeaders);\n            if (isSseHandler) {\n                // Attach a per-request AbortController before the handler runs so async\n                // @Sse() handlers can observe client disconnects via @SseSignal() during\n                // their setup. The controller is aborted in RouterResponseController.sse()\n                // when the underlying connection closes.\n                this.attachSseAbortSignal(req);\n            }\n            const resultOrDeferred = this.interceptorsConsumer.intercept(interceptors\x2C [req\x2C res\x2C next]\x2C instance\x2C callback\x2C handler(args\x2C req\x2C res\x2C next)\x2C contextType);\n            const result = isSseHandler ? resultOrDeferred : await resultOrDeferred;\n            await fnHandleResponse(result\x2C res\x2C req);\n        };\n    }\n    getMetadata(instance\x2C callback\x2C methodName\x2C moduleKey\x2C requestMethod\x2C contextType) {\n        const cacheMetadata = this.handlerMetadataStorage.get(instance\x2C methodName);\n        if (cacheMetadata) {\n            return cacheMetadata;\n        }\n        const metadata = this.contextUtils.reflectCallbackMetadata(instance\x2C methodName\x2C ROUTE_ARGS_METADATA) || {};\n        const keys = Object.keys(metadata);\n        const argsLength = this.contextUtils.getArgumentsLength(keys\x2C metadata);\n        const paramtypes = this.contextUtils.reflectCallbackParamtypes(instance\x2C methodName);\n        const contextFactory = this.contextUtils.getContextFactory(contextType\x2C instance\x2C callback);\n        const getParamsMetadata = (moduleKey\x2C contextId = STATIC_CONTEXT\x2C inquirerId) => this.exchangeKeysForValues(keys\x2C metadata\x2C moduleKey\x2C contextId\x2C inquirerId\x2C contextFactory);\n        const paramsMetadata = getParamsMetadata(moduleKey);\n        const isResponseHandled = this.isResponseHandled(instance\x2C methodName\x2C paramsMetadata);\n        const httpRedirectResponse = this.reflectRedirect(callback);\n        const fnHandleResponse = this.createHandleResponseFn(callback\x2C isResponseHandled\x2C httpRedirectResponse);\n        const isSseHandler = !!this.reflectSse(callback);\n        const httpCode = this.reflectHttpStatusCode(callback);\n        const httpStatusCode = httpCode ?? this.responseController.getStatusByMethod(requestMethod);\n        const responseHeaders = this.reflectResponseHeaders(callback);\n        const hasCustomHeaders = !isEmptyArray(responseHeaders);\n        const handlerMetadata = {\n            argsLength\x2C\n            fnHandleResponse\x2C\n            isSseHandler\x2C\n            paramtypes\x2C\n            getParamsMetadata\x2C\n            httpStatusCode\x2C\n            hasCustomHeaders\x2C\n            responseHeaders\x2C\n        };\n        this.handlerMetadataStorage.set(instance\x2C methodName\x2C handlerMetadata);\n        return handlerMetadata;\n    }\n    reflectRedirect(callback) {\n        return Reflect.getMetadata(REDIRECT_METADATA\x2C callback);\n    }\n    reflectHttpStatusCode(callback) {\n        return Reflect.getMetadata(HTTP_CODE_METADATA\x2C callback);\n    }\n    reflectRenderTemplate(callback) {\n        return Reflect.getMetadata(RENDER_METADATA\x2C callback);\n    }\n    reflectResponseHeaders(callback) {\n        return Reflect.getMetadata(HEADERS_METADATA\x2C callback) || [];\n    }\n    reflectSse(callback) {\n        return Reflect.getMetadata(SSE_METADATA\x2C callback);\n    }\n    exchangeKeysForValues(keys\x2C metadata\x2C moduleContext\x2C contextId = STATIC_CONTEXT\x2C inquirerId\x2C contextFactory) {\n        this.pipesContextCreator.setModuleContext(moduleContext);\n        return keys.map(key => {\n            const { index\x2C data\x2C pipes: pipesCollection\x2C schema } = metadata[key];\n            const pipes = this.pipesContextCreator.createConcreteContext(pipesCollection\x2C contextId\x2C inquirerId);\n            const type = this.contextUtils.mapParamType(key);\n            if (key.includes(CUSTOM_ROUTE_ARGS_METADATA)) {\n                const { factory } = metadata[key];\n                const customExtractValue = this.contextUtils.getCustomFactory(factory\x2C data\x2C contextFactory);\n                return {\n                    index\x2C\n                    extractValue: customExtractValue\x2C\n                    type\x2C\n                    data\x2C\n                    pipes\x2C\n                    schema\x2C\n                };\n            }\n            const numericType = Number(type);\n            const extractValue = (req\x2C res\x2C next) => this.paramsFactory.exchangeKeyForValue(numericType\x2C data\x2C {\n                req: req\x2C\n                res\x2C\n                next\x2C\n            });\n            return { index\x2C extractValue\x2C type: numericType\x2C data\x2C pipes\x2C schema };\n        });\n    }\n    async getParamValue(value\x2C metadata\x2C pipes) {\n        if (!isEmptyArray(pipes)) {\n            return this.pipesConsumer.apply(value\x2C metadata\x2C pipes);\n        }\n        return value;\n    }\n    isPipeable(type) {\n        return (type === RouteParamtypes.BODY ||\n            type === RouteParamtypes.RAW_BODY ||\n            type === RouteParamtypes.QUERY ||\n            type === RouteParamtypes.PARAM ||\n            type === RouteParamtypes.FILE ||\n            type === RouteParamtypes.FILES ||\n            isString(type));\n    }\n    createGuardsFn(guards\x2C instance\x2C callback\x2C contextType) {\n        const canActivateFn = async (args) => {\n            const canActivate = await this.guardsConsumer.tryActivate(guards\x2C args\x2C instance\x2C callback\x2C contextType);\n            if (!canActivate) {\n                throw new ForbiddenException(FORBIDDEN_MESSAGE);\n            }\n        };\n        return guards.length ? canActivateFn : null;\n    }\n    createPipesFn(pipes\x2C paramsOptions) {\n        const pipesFn = async (args\x2C req\x2C res\x2C next) => {\n            const resolveParamValue = async (param) => {\n                const { index\x2C extractValue\x2C type\x2C data\x2C metatype\x2C pipes: paramPipes\x2C schema\x2C } = param;\n                const value = extractValue(req\x2C res\x2C next);\n                args[index] = this.isPipeable(type)\n                    ? await this.getParamValue(value\x2C { metatype\x2C type\x2C data\x2C schema }\x2C pipes.concat(paramPipes))\n                    : value;\n            };\n            await Promise.all(paramsOptions.map(resolveParamValue));\n        };\n        return paramsOptions.length ? pipesFn : null;\n    }\n    createHandleResponseFn(callback\x2C isResponseHandled\x2C redirectResponse\x2C httpStatusCode) {\n        const renderTemplate = this.reflectRenderTemplate(callback);\n        if (renderTemplate) {\n            return async (result\x2C res) => {\n                return await this.responseController.render(result\x2C res\x2C renderTemplate);\n            };\n        }\n        if (redirectResponse && isString(redirectResponse.url)) {\n            return async (result\x2C res) => {\n                await this.responseController.redirect(result\x2C res\x2C redirectResponse);\n            };\n        }\n        const isSseHandler = !!this.reflectSse(callback);\n        if (isSseHandler) {\n            return async (result\x2C res\x2C req) => {\n                const rawResponse = res.raw ?? res;\n                await this.responseController.sse(result\x2C rawResponse\x2C req.raw || req\x2C {\n                    additionalHeaders: res.getHeaders?.()\x2C\n                    statusCode: res.statusCode ??\n                        rawResponse.statusCode\x2C\n                });\n            };\n        }\n        return async (result\x2C res) => {\n            result = await this.responseController.transformToResult(result);\n            !isResponseHandled &&\n                (await this.responseController.apply(result\x2C res\x2C httpStatusCode));\n            return res;\n        };\n    }\n    isResponseHandled(instance\x2C methodName\x2C paramsMetadata) {\n        const hasResponseOrNextDecorator = paramsMetadata.some(({ type }) => type === RouteParamtypes.RESPONSE || type === RouteParamtypes.NEXT);\n        const isPassthroughEnabled = this.contextUtils.reflectPassthrough(instance\x2C methodName);\n        return hasResponseOrNextDecorator && !isPassthroughEnabled;\n    }\n    attachSseAbortSignal(req) {\n        const carrier = req;\n        // Attach to both the framework request and its raw form (when present)\x2C since\n        // @SseSignal() reads from the execution-context request while\n        // RouterResponseController.sse() operates on the raw request.\n        if (!carrier[SSE_ABORT_CONTROLLER]) {\n            carrier[SSE_ABORT_CONTROLLER] = new AbortController();\n        }\n        if (carrier.raw && !carrier.raw[SSE_ABORT_CONTROLLER]) {\n            carrier.raw[SSE_ABORT_CONTROLLER] =\n                carrier[SSE_ABORT_CONTROLLER];\n        }\n    }\n}\n
