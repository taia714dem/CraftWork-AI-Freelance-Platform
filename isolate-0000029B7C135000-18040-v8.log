code-creation,Script,9,1414604,0x1e04eefc140,113, file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/injector/module-ref.js:1:1,0x2042bb3bc70,~
script-source,243,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/injector/module-ref.js,import { Scope } from '@nestjs/common';\nimport { getClassScope } from '../helpers/get-class-scope.js';\nimport { isDurable } from '../helpers/is-durable.js';\nimport { AbstractInstanceResolver } from './abstract-instance-resolver.js';\nimport { STATIC_CONTEXT } from './constants.js';\nimport { Injector } from './injector.js';\nimport { InstanceLinksHost } from './instance-links-host.js';\nimport { InstanceWrapper } from './instance-wrapper.js';\nexport class ModuleRef extends AbstractInstanceResolver {\n    container;\n    injector;\n    _instanceLinksHost;\n    get instanceLinksHost() {\n        if (!this._instanceLinksHost) {\n            this._instanceLinksHost = new InstanceLinksHost(this.container);\n        }\n        return this._instanceLinksHost;\n    }\n    constructor(container) {\n        super();\n        this.container = container;\n        const contextOptions = container.contextOptions;\n        this.injector = new Injector({\n            preview: contextOptions?.preview ?? false\x2C\n            snapshot: contextOptions?.snapshot\x2C\n            instanceDecorator: contextOptions?.instrument?.instanceDecorator\x2C\n        });\n    }\n    introspect(token) {\n        const { wrapperRef } = this.instanceLinksHost.get(token);\n        let scope = Scope.DEFAULT;\n        if (!wrapperRef.isDependencyTreeStatic()) {\n            scope = Scope.REQUEST;\n        }\n        else if (wrapperRef.isTransient) {\n            scope = Scope.TRANSIENT;\n        }\n        return { scope };\n    }\n    registerRequestByContextId(request\x2C contextId) {\n        this.container.registerRequestProvider(request\x2C contextId);\n    }\n    async instantiateClass(type\x2C moduleRef\x2C contextId) {\n        const wrapper = new InstanceWrapper({\n            name: type && type.name\x2C\n            metatype: type\x2C\n            isResolved: false\x2C\n            scope: getClassScope(type)\x2C\n            durable: isDurable(type)\x2C\n            host: moduleRef\x2C\n        });\n        if (type?.prototype) {\n            wrapper.setInstanceByContextId(contextId ?? STATIC_CONTEXT\x2C {\n                instance: Object.create(type.prototype)\x2C\n                isResolved: false\x2C\n                isPending: false\x2C\n            });\n        }\n        return new Promise((resolve\x2C reject) => {\n            const loadInstance = async () => {\n                const callback = async (instances) => {\n                    const properties = await this.injector.resolveProperties(wrapper\x2C moduleRef\x2C undefined\x2C {\n                        contextId: contextId ?? STATIC_CONTEXT\x2C\n                        inquirer: wrapper\x2C\n                    });\n                    const instance = new type(...instances);\n                    this.injector.applyProperties(instance\x2C properties);\n                    resolve(instance);\n                };\n                await this.injector.resolveConstructorParams(wrapper\x2C moduleRef\x2C undefined\x2C callback\x2C {\n                    contextId: contextId ?? STATIC_CONTEXT\x2C\n                    inquirer: wrapper\x2C\n                });\n            };\n            void loadInstance().catch(reject);\n        });\n    }\n}\n
