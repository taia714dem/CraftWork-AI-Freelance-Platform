script-source,1826,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\pg-int8\\index.js,'use strict';\n\n// selected so (BASE - 1) * 0x100000000 + 0xffffffff is a safe integer\nvar BASE = 1000000;\n\nfunction readInt8(buffer) {\n\x09var high = buffer.readInt32BE(0);\n\x09var low = buffer.readUInt32BE(4);\n\x09var sign = '';\n\n\x09if (high < 0) {\n\x09\x09high = ~high + (low === 0);\n\x09\x09low = (~low + 1) >>> 0;\n\x09\x09sign = '-';\n\x09}\n\n\x09var result = '';\n\x09var carry;\n\x09var t;\n\x09var digits;\n\x09var pad;\n\x09var l;\n\x09var i;\n\n\x09{\n\x09\x09carry = high % BASE;\n\x09\x09high = high / BASE >>> 0;\n\n\x09\x09t = 0x100000000 * carry + low;\n\x09\x09low = t / BASE >>> 0;\n\x09\x09digits = '' + (t - BASE * low);\n\n\x09\x09if (low === 0 && high === 0) {\n\x09\x09\x09return sign + digits + result;\n\x09\x09}\n\n\x09\x09pad = '';\n\x09\x09l = 6 - digits.length;\n\n\x09\x09for (i = 0; i < l; i++) {\n\x09\x09\x09pad += '0';\n\x09\x09}\n\n\x09\x09result = pad + digits + result;\n\x09}\n\n\x09{\n\x09\x09carry = high % BASE;\n\x09\x09high = high / BASE >>> 0;\n\n\x09\x09t = 0x100000000 * carry + low;\n\x09\x09low = t / BASE >>> 0;\n\x09\x09digits = '' + (t - BASE * low);\n\n\x09\x09if (low === 0 && high === 0) {\n\x09\x09\x09return sign + digits + result;\n\x09\x09}\n\n\x09\x09pad = '';\n\x09\x09l = 6 - digits.length;\n\n\x09\x09for (i = 0; i < l; i++) {\n\x09\x09\x09pad += '0';\n\x09\x09}\n\n\x09\x09result = pad + digits + result;\n\x09}\n\n\x09{\n\x09\x09carry = high % BASE;\n\x09\x09high = high / BASE >>> 0;\n\n\x09\x09t = 0x100000000 * carry + low;\n\x09\x09low = t / BASE >>> 0;\n\x09\x09digits = '' + (t - BASE * low);\n\n\x09\x09if (low === 0 && high === 0) {\n\x09\x09\x09return sign + digits + result;\n\x09\x09}\n\n\x09\x09pad = '';\n\x09\x09l = 6 - digits.length;\n\n\x09\x09for (i = 0; i < l; i++) {\n\x09\x09\x09pad += '0';\n\x09\x09}\n\n\x09\x09result = pad + digits + result;