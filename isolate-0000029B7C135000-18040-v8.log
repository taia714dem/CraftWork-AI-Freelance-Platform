script-source,730,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/helpers/context-utils.js,import { ExecutionContextHost } from './execution-context-host.js';\nimport { PARAMTYPES_METADATA\x2C RESPONSE_PASSTHROUGH_METADATA\x2C isFunction\x2C } from '@nestjs/common/internal';\nexport class ContextUtils {\n    mapParamType(key) {\n        const keyPair = key.split(':');\n        return keyPair[0];\n    }\n    reflectCallbackParamtypes(instance\x2C methodName) {\n        return Reflect.getMetadata(PARAMTYPES_METADATA\x2C instance\x2C methodName);\n    }\n    reflectCallbackMetadata(instance\x2C methodName\x2C metadataKey) {\n        return Reflect.getMetadata(metadataKey\x2C instance.constructor\x2C methodName);\n    }\n    reflectPassthrough(instance\x2C methodName) {\n        return Reflect.getMetadata(RESPONSE_PASSTHROUGH_METADATA\x2C instance.constructor\x2C methodName);\n    }\n    getArgumentsLength(keys\x2C metadata) {\n        return keys.length\n            ? Math.max(...keys.map(key => metadata[key].index)) + 1\n            : 0;\n    }\n    createNullArray(length) {\n        const a = new Array(length);\n        for (let i = 0; i < length; ++i)\n            a[i] = undefined;\n        return a;\n    }\n    mergeParamsMetatypes(paramsProperties\x2C paramtypes) {\n        if (!paramtypes) {\n            return paramsProperties;\n        }\n        return paramsProperties.map(param => ({\n            ...param\x2C\n            metatype: paramtypes[param.index]\x2C\n        }));\n    }\n    getCustomFactory(factory\x2C data\x2C contextFactory) {\n        return isFunction(factory)\n            ? (...args) => factory(data\x2C contextFactory(args))\n            : () => null;\n    }\n    getContextFactory(contextType\x2C instance\x2C callback) {\n        const type = instance && instance.constructor;\n        return (args) => {\n            const ctx = new ExecutionContextHost(args\x2C type\x2C callback);\n            ctx.setType(contextType);\n            return ctx;\n        };\n    }\n}\n
