script-source,191,node:internal/modules/esm/hooks,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypePushApply\x2C\x0d\n  AtomicsLoad\x2C\x0d\n  AtomicsWait\x2C\x0d\n  AtomicsWaitAsync\x2C\x0d\n  Int32Array\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  Promise\x2C\x0d\n  ReflectSet\x2C\x0d\n  SafeSet\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeToUpperCase\x2C\x0d\n  globalThis\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  SharedArrayBuffer\x2C\x0d\n} = globalThis;\x0d\n\x0d\nconst {\x0d\n  ERR_INTERNAL_ASSERTION\x2C\x0d\n  ERR_INVALID_ARG_TYPE\x2C\x0d\n  ERR_INVALID_ARG_VALUE\x2C\x0d\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\x0d\n  ERR_INVALID_RETURN_VALUE\x2C\x0d\n  ERR_LOADER_CHAIN_INCOMPLETE\x2C\x0d\n  ERR_METHOD_NOT_IMPLEMENTED\x2C\x0d\n  ERR_WORKER_UNSERIALIZABLE_ERROR\x2C\x0d\n} = require('internal/errors').codes;\x0d\nconst { exitCodes: { kUnsettledTopLevelAwait } } = internalBinding('errors');\x0d\nconst { URLParse } = require('internal/url');\x0d\nconst { canParse: URLCanParse } = internalBinding('url');\x0d\nconst { receiveMessageOnPort } = require('worker_threads');\x0d\nconst {\x0d\n  isAnyArrayBuffer\x2C\x0d\n  isArrayBufferView\x2C\x0d\n} = require('internal/util/types');\x0d\nconst {\x0d\n  validateObject\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  kEmptyObject\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  defaultResolve\x2C\x0d\n  throwIfInvalidParentURL\x2C\x0d\n} = require('internal/modules/esm/resolve');\x0d\nconst {\x0d\n  getDefaultConditions\x2C\x0d\n  loaderWorkerId\x2C\x0d\n} = require('internal/modules/esm/utils');\x0d\nconst { deserializeError } = require('internal/error_serdes');\x0d\nconst {\x0d\n  SHARED_MEMORY_BYTE_LENGTH\x2C\x0d\n  WORKER_TO_MAIN_THREAD_NOTIFICATION\x2C\x0d\n} = require('internal/modules/esm/shared_constants');\x0d\nlet debug = require('internal/util/