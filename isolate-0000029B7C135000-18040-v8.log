script-source,1830,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\pg\\lib\\crypto\\utils.js,const nodeCrypto = require('crypto')\n\nmodule.exports = {\n  postgresMd5PasswordHash\x2C\n  randomBytes\x2C\n  deriveKey\x2C\n  sha256\x2C\n  hashByName\x2C\n  hmacSha256\x2C\n  md5\x2C\n}\n\n/**\n * The Web Crypto API - grabbed from the Node.js library or the global\n * @type Crypto\n */\n// eslint-disable-next-line no-undef\nconst webCrypto = nodeCrypto.webcrypto || globalThis.crypto\n/**\n * The SubtleCrypto API for low level crypto operations.\n * @type SubtleCrypto\n */\nconst subtleCrypto = webCrypto.subtle\nconst textEncoder = new TextEncoder()\n\n/**\n *\n * @param {*} length\n * @returns\n */\nfunction randomBytes(length) {\n  return webCrypto.getRandomValues(Buffer.alloc(length))\n}\n\nasync function md5(string) {\n  try {\n    return nodeCrypto.createHash('md5').update(string\x2C 'utf-8').digest('hex')\n  } catch (e) {\n    // `createHash()` failed so we are probably not in Node.js\x2C use the WebCrypto API instead.\n    // Note that the MD5 algorithm on WebCrypto is not available in Node.js.\n    // This is why we cannot just use WebCrypto in all environments.\n    const data = typeof string === 'string' ? textEncoder.encode(string) : string\n    const hash = await subtleCrypto.digest('MD5'\x2C data)\n    return Array.from(new Uint8Array(hash))\n      .map((b) => b.toString(16).padStart(2\x2C '0'))\n      .join('')\n  }\n}\n\n// See AuthenticationMD5Password at https://www.postgresql.org/docs/current/static/protocol-flow.html\nasync function postgresMd5PasswordHash(user\x2C password\x2C salt) {\n  const inner = await md5(password + user)\n  const outer = await md5(Buffer.concat([Buffer.from(inner)\x2C salt]))\n  return 'md5' + outer\n}\n\n/**\n * Create a SHA-256 digest of the given data\n * @param {Buffer} data\n */\nasync function sha256(text) {\n  return await subtleCrypto.digest('SHA-256'\x2C text)\n}\n\nasync function hashByName(hashName\x2C text) {\n  return await subtleCrypto.digest(hashName\x2C text)\n}\n\n/**\n * Sign the message with the given key\n * @param {ArrayBuffer} keyBuffer\n * @param {string} msg\n */\nasync function hmacSha256(keyBuffer\x2C msg) {\n  const key = await subtleCrypto.importKey('raw'\x2C keyBuffer\x2C { name: 'HMAC'\x2C hash: 'SHA-256' }\x2C false\x2C ['sign'])\n  return await subtleCrypto.sign('HMAC'\x2C key\x2C textEncoder.encode(msg))\n}\n\n/**\n * Derive a key from the password and salt\n * @param {string} password\n * @param {Uint8Array} salt\n * @param {number} iterations\n */\nasync function deriveKey(password\x2C salt\x2C iterations) {\n  const key = await subtleCrypto.importKey('raw'\x2C textEncoder.encode(password)\x2C 'PBKDF2'\x2C false\x2C ['deriveBits'])\n  const params = { name: 'PBKDF2'\x2C hash: 'SHA-256'\x2C salt: salt\x2C iterations: iterations }\n  return await subtleCrypto.deriveBits(params\x2C key\x2C 32 * 8\x2C ['deriveBits'])\n}\n
