script-source,87,node:internal/data_url,'use strict';\x0d\n\x0d\nconst {\x0d\n  RegExpPrototypeExec\x2C\x0d\n  RegExpPrototypeSymbolReplace\x2C\x0d\n  StringFromCharCodeApply\x2C\x0d\n  StringPrototypeCharCodeAt\x2C\x0d\n  StringPrototypeIndexOf\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  TypedArrayPrototypeSubarray\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst assert = require('internal/assert');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst { MIMEType } = require('internal/mime');\x0d\n\x0d\nlet encoder;\x0d\nfunction lazyEncoder() {\x0d\n  if (encoder === undefined) {\x0d\n    const { TextEncoder } = require('internal/encoding');\x0d\n    encoder = new TextEncoder();\x0d\n  }\x0d\n\x0d\n  return encoder;\x0d\n}\x0d\n\x0d\nconst ASCII_WHITESPACE_REPLACE_REGEX = /[\\u0009\\u000A\\u000C\\u000D\\u0020]/g // eslint-disable-line\x0d\n\x0d\n// https://fetch.spec.whatwg.org/#data-url-processor\x0d\n/** @param {URL} dataURL */\x0d\nfunction dataURLProcessor(dataURL) {\x0d\n  // 1. Assert: dataURL's scheme is "data".\x0d\n  assert(dataURL.protocol === 'data:');\x0d\n\x0d\n  // 2. Let input be the result of running the URL\x0d\n  // serializer on dataURL with exclude fragment\x0d\n  // set to true.\x0d\n  let input = URLSerializer(dataURL\x2C true);\x0d\n\x0d\n  // 3. Remove the leading "data:" string from input.\x0d\n  input = StringPrototypeSlice(input\x2C 5);\x0d\n\x0d\n  // 4. Let position point at the start of input.\x0d\n  const position = { position: 0 };\x0d\n\x0d\n  // 5. Let mimeType be the result of collecting a\x0d\n  // sequence of code points that are not equal\x0d\n  // to U+002C (\x2C)\x2C given position.\x0d\n  let mimeType = collectASequenceOfCodePointsFast(\x0d\n    '\x2C'\x2C\x0d\n    input\x2C\x0d\n    position\x2C\x0d\n  );\x0d\n\x0d\n  // 6. Strip leading and trailing ASCII whitespace\x0d\n  // from mimeType.\x0d\n  // Undici implementation note: we need to store the\x0d\n  // length because if the mimetype has spaces removed\x2C\x0d\n  // the wrong amount will be sliced from the input in\x0d\n  // step #9\x0d\n  const mimeTypeLength = mimeType.length;\x0d\n  mimeType = removeASCIIWhitespace(mimeType\x2C true\x2C true);\x0d\n\x0d\n  // 7. If position is past the end of input\x2C then\x0d\n  // return failure\x0d\n  if (position.position >= input.length) {\x0d\n    return 'failure';\x0d\n  }\x0d\n\x0d\n  // 8. Advance position by 1.\x0d\n  position.position++;\x0d\n\x0d\n  // 9. Let encodedBody be the remainder of input.\x0d\n  const encodedBody = StringPrototypeSlice(input\x2C mimeTypeLength + 1);\x0d\n\x0d\n  // 10. Let body be the percent-decoding of encodedBody.\x0d\n  let body = stringPercentDecode(encodedBody);\x0d\n\x0d\n  // 11. If mimeType ends with U+003B (;)\x2C followed by\x0d\n  // zero or more U+0020 SPACE\x2C followed by an ASCII\x0d\n  // case-insensitive match for "base64"\x2C then:\x0d\n  if (RegExpPrototypeExec(/;(\\u0020){0\x2C}base64$/i\x2C mimeType) !== null) {\x0d\n    // 1. Let stringBody be the isomorphic decode of body.\x0d\n    const stringBody = isomorphicDecode(body);\x0d\n\x0d\n    // 2. Set body to the forgiving-base64 decode of\x0d\n    // stringBody.\x0d\n    body = forgivingBase64(stringBody);\x0d\n\x0d\n    // 3. If body is failure\x2C then return failure.\x0d\n    if (body === 'failure') {\x0d\n      return 'failure';\x0d\n    }\x0d\n\x0d\n    // 4. Remove the last 6 code points from mimeType.\x0d\n    mimeType = StringPrototypeSlice(mimeType\x2C 0\x2C -6);\x0d\n\x0d\n    // 5. Remove trailing U+0020 SPACE code points from mimeType\x2C\x0d\n    // if any.\x0d\n    mimeType = RegExpPrototypeSymbolReplace(/(\\u0020)+$/\x2C mimeType\x2C '');\x0d\n\x0d\n    // 6. Remove the last U+003B (;) code point from mimeType.\x0d\n    mimeType = StringPrototypeSlice(mimeType\x2C 0\x2C -1);\x0d\n  }\x0d\n\x0d\n  // 12. If mimeType starts with U+003B (;)\x2C then prepend\x0d\n  // "text/plain" to mimeType.\x0d\n  if (mimeType[0] === ';') {\x0d\n    mimeType = 'text/plain' + mimeType;\x0d\n  }\x0d\n\x0d\n  // 13. Let mimeTypeRecord be the result of parsing\x0d\n  // mimeType.\x0d\n  // 14. If mimeTypeRecord is failure\x2C then set\x0d\n  // mimeTypeRecord to text/plain;charset=US-ASCII.\x0d\n  let mimeTypeRecord;\x0d\n\x0d\n  try {\x0d\n    mimeTypeRecord = new MIMEType(mimeType);\x0d\n  } catch {\x0d\n    mimeTypeRecord = new MIMEType('text/plain;charset=US-ASCII');\x0d\n  }\x0d\n\x0d\n  // 15. Return a new data: URL struct whose MIME\x0d\n  // type is mimeTypeRecord and body is body.\x0d\n  // https://fetch.spec.whatwg.org/#data-url-struct\x0d\n  return { mimeType: mimeTypeRecord\x2C body };\x0d\n}\x0d\n\x0d\n// https://url.spec.whatwg.org/#concept-url-serializer\x0d\n/**\x0d\n * @param {URL} url\x0d\n * @param {boolean} excludeFragment\x0d\n */\x0d\nfunction URLSerializer(url\x2C excludeFragment = false) {\x0d\n  const { href } = url;\x0d\n\x0d\n  if (!excludeFragment) {\x0d\n    return href;\x0d\n  }\x0d\n\x0d\n  const hashLength = url.hash.length;\x0d\n  const serialized = hashLength === 0 ? href : StringPrototypeSlice(href\x2C 0\x2C href.length - hashLength);\x0d\n\x0d\n  if (!hashLength && href[href.length - 1] === '#') {\x0d\n    return StringPrototypeSlice(serialized\x2C 0\x2C -1);\x0d\n  }\x0d\n\x0d\n  return serialized;\x0d\n}\x0d\n\x0d\n/**\x0d\n * A faster collectASequenceOfCodePoints that only works when comparing a single character.\x0d\n * @param {string} char\x0d\n * @param {string} input\x0d\n * @param {{ position: number }} position\x0d\n */\x0d\nfunction collectASequenceOfCodePointsFast(char\x2C input\x2C position) {\x0d\n  const idx = StringPrototypeIndexOf(input\x2C char\x2C position.position);\x0d\n  const start = position.position;\x0d\n\x0d\n  if (idx === -1) {\x0d\n    position.position = input.length;\x0d\n    return StringPrototypeSlice(input\x2C start);\x0d\n  }\x0d\n\x0d\n  position.position = idx;\x0d\n  return StringPrototypeSlice(input\x2C start\x2C position.position);\x0d\n}\x0d\n\x0d\n// https://url.spec.whatwg.org/#string-percent-decode\x0d\n/** @param {string} input */\x0d\nfunction stringPercentDecode(input) {\x0d\n  // 1. Let bytes be the UTF-8 encoding of input.\x0d\n  const bytes = lazyEncoder().encode(input);\x0d\n\x0d\n  // 2. Return the percent-decoding of bytes.\x0d\n  return percentDecode(bytes);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {number} byte\x0d\n */\x0d\nfunction isHexCharByte(byte) {\x0d\n  // 0-9 A-F a-f\x0d\n  return (byte >= 0x30 && byte <= 0x39) || (byte >= 0x41 && byte <= 0x46) || (byte >= 0x61 && byte <= 0x66);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {number} byte\x0d\n */\x0d\nfunction hexByteToNumber(byte) {\x0d\n  return (\x0d\n    // 0-9\x0d\n    byte >= 0x30 && byte <= 0x39 ?\x0d\n      (byte - 48) :\x0d\n    // Convert to uppercase\x0d\n    // ((byte & 0xDF) - 65) + 10\x0d\n      ((byte & 0xDF) - 55)\x0d\n  );\x0d\n}\x0d\n\x0d\n// https://url.spec.whatwg.org/#percent-decode\x0d\n/** @param {Uint8Array} input */\x0d\nfunction percentDecode(input) {\x0d\n  const length = input.length;\x0d\n  // 1. Let output be an empty byte sequence.\x0d\n  /** @type {Uint8Array} */\x0d\n  const output = new Uint8Array(length);\x0d\n  let j = 0;\x0d\n  // 2. For each byte byte in input:\x0d\n  for (let i = 0; i < length; ++i) {\x0d\n    const byte = input[i];\x0d\n\x0d\n    // 1. If byte is not 0x25 (%)\x2C then append byte to output.\x0d\n    if (byte !== 0x25) {\x0d\n      output[j++] = byte;\x0d\n\x0d\n    // 2. Otherwise\x2C if byte is 0x25 (%) and the next two bytes\x0d\n    // after byte in input are not in the ranges\x0d\n    // 0x30 (0) to 0x39 (9)\x2C 0x41 (A) to 0x46 (F)\x2C\x0d\n    // and 0x61 (a) to 0x66 (f)\x2C all inclusive\x2C append byte\x0d\n    // to output.\x0d\n    } else if (\x0d\n      byte === 0x25 &&\x0d\n      !(isHexCharByte(input[i + 1]) && isHexCharByte(input[i + 2]))\x0d\n    ) {\x0d\n      output[j++] = 0x25;\x0d\n\x0d\n    // 3. Otherwise:\x0d\n    } else {\x0d\n      // 1. Let bytePoint be the two bytes after byte in input\x2C\x0d\n      // decoded\x2C and then interpreted as hexadecimal number.\x0d\n      // 2. Append a byte whose value is bytePoint to output.\x0d\n      output[j++] = (hexByteToNumber(input[i + 1]) << 4) | hexByteToNumber(input[i + 2]);\x0d\n\x0d\n      // 3. Skip the next two bytes in input.\x0d\n      i += 2;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // 3. Return output.\x0d\n  return length === j ? output : TypedArrayPrototypeSubarray(output\x2C 0\x2C j);\x0d\n}\x0d\n\x0d\n// https://infra.spec.whatwg.org/#forgiving-base64-decode\x0d\n/** @param {string} data */\x0d\nfunction forgivingBase64(data) {\x0d\n  // 1. Remove all ASCII whitespace from data.\x0d\n  data = RegExpPrototypeSymbolReplace(ASCII_WHITESPACE_REPLACE_REGEX\x2C data\x2C '');\x0d\n\x0d\n  let dataLength = data.length;\x0d\n  // 2. If data's code point length divides by 4 leaving\x0d\n  // no remainder\x2C then:\x0d\n  if (dataLength % 4 === 0) {\x0d\n    // 1. If data ends with one or two U+003D (=) code points\x2C\x0d\n    // then remove them from data.\x0d\n    if (data[dataLength - 1] === '=') {\x0d\n      --dataLength;\x0d\n      if (data[dataLength - 1] === '=') {\x0d\n        --dataLength;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // 3. If data's code point length divides by 4 leaving\x0d\n  // a remainder of 1\x2C then return failure.\x0d\n  if (dataLength % 4 === 1) {\x0d\n    return 'failure';\x0d\n  }\x0d\n\x0d\n  // 4. If data contains a code point that is not one of\x0d\n  //  U+002B (+)\x0d\n  //  U+002F (/)\x0d\n  //  ASCII alphanumeric\x0d\n  // then return failure.\x0d\n  if (RegExpPrototypeExec(/[^+/0-9A-Za-z]/\x2C data.length === dataLength ? data : StringPrototypeSlice(data\x2C 0\x2C dataLength)) !== null) {\x0d\n    return 'failure';\x0d\n  }\x0d\n\x0d\n  const buffer = Buffer.from(data\x2C 'base64');\x0d\n  return new Uint8Array(buffer.buffer\x2C buffer.byteOffset\x2C buffer.byteLength);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @see https://infra.spec.whatwg.org/#ascii-whitespace\x0d\n * @param {number} char\x0d\n */\x0d\nfunction isASCIIWhitespace(char) {\x0d\n  // "\\r\\n\\t\\f "\x0d\n  return char === 0x00d || char === 0x00a || char === 0x009 || char === 0x00c || char === 0x020;\x0d\n}\x0d\n\x0d\n/**\x0d\n * @see https://infra.spec.whatwg.org/#strip-leading-and-trailing-ascii-whitespace\x0d\n * @param {string} str\x0d\n * @param {boolean} [leading=true]\x0d\n * @param {boolean} [trailing=true]\x0d\n */\x0d\nfunction removeASCIIWhitespace(str\x2C leading = true\x2C trailing = true) {\x0d\n  return removeChars(str\x2C leading\x2C trailing\x2C isASCIIWhitespace);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {string} str\x0d\n * @param {boolean} leading\x0d\n * @param {boolean} trailing\x0d\n * @param {(charCode: number) => boolean} predicate\x0d\n */\x0d\nfunction removeChars(str\x2C leading\x2C trailing\x2C predicate) {\x0d\n  let lead = 0;\x0d\n  let trail = str.length - 1;\x0d\n\x0d\n  if (leading) {\x0d\n    while (lead < str.length && predicate(StringPrototypeCharCodeAt(str\x2C lead))) lead++;\x0d\n  }\x0d\n\x0d\n  if (trailing) {\x0d\n    while (trail > 0 && predicate(StringPrototypeCharCodeAt(str\x2C trail))) trail--;\x0d\n  }\x0d\n\x0d\n  return lead === 0 && trail === str.length - 1 ? str : StringPrototypeSlice(str\x2C lead\x2C trail + 1);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @see https://infra.spec.whatwg.org/#isomorphic-decode\x0d\n * @param {Uint8Array} input\x0d\n * @returns {string}\x0d\n */\x0d\nfunction isomorphicDecode(input) {\x0d\n  // 1. To isomorphic decode a byte sequence input\x2C return a string whose code point\x0d\n  //    length is equal to input's length and whose code points have the same values\x0d\n  //    as the values of input's bytes\x2C in the same order.\x0d\n  const length = input.length;\x0d\n  if ((2 << 15) - 1 > length) {\x0d\n    return StringFromCharCodeApply(input);\x0d\n  }\x0d\n  let result = ''; let i = 0;\x0d\n  let addition = (2 << 15) - 1;\x0d\n  while (i < length) {\x0d\n    if (i + addition > length) {\x0d\n      addition = length - i;\x0d\n    }\x0d\n    result += StringFromCharCodeApply(TypedArrayPrototypeSubarray(input\x2C i\x2C i += addition));\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  dataURLProcessor\x2C\x0d\n};\x0d\n
