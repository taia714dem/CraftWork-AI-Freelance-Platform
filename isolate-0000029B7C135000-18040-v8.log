script-source,1816,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\pg\\lib\\defaults.js,'use strict'\n\nlet user\ntry {\n  user = process.platform === 'win32' ? process.env.USERNAME : process.env.USER\n} catch {\n  // ignore\x2C e.g.\x2C Deno without --allow-env\n}\n\nmodule.exports = {\n  // database host. defaults to localhost\n  host: 'localhost'\x2C\n\n  // database user's name\n  user\x2C\n\n  // name of database to connect\n  database: undefined\x2C\n\n  // database user's password\n  password: null\x2C\n\n  // a Postgres connection string to be used instead of setting individual connection items\n  // NOTE:  Setting this value will cause it to override any other value (such as database or user) defined\n  // in the defaults object.\n  connectionString: undefined\x2C\n\n  // database port\n  port: 5432\x2C\n\n  // number of rows to return at a time from a prepared statement's\n  // portal. 0 will return all rows at once\n  rows: 0\x2C\n\n  // binary result mode\n  binary: false\x2C\n\n  // Connection pool options - see https://github.com/brianc/node-pg-pool\n\n  // number of connections to use in connection pool\n  // 0 will disable connection pooling\n  max: 10\x2C\n\n  // max milliseconds a client can go unused before it is removed\n  // from the pool and destroyed\n  idleTimeoutMillis: 30000\x2C\n\n  client_encoding: ''\x2C\n\n  ssl: false\x2C\n\n  // SSL negotiation style: 'postgres' (traditional SSLRequest) or 'direct'\n  sslnegotiation: undefined\x2C\n\n  application_name: undefined\x2C\n\n  fallback_application_name: undefined\x2C\n\n  options: undefined\x2C\n\n  parseInputDatesAsUTC: false\x2C\n\n  // max milliseconds any query using this connection will execute for before timing out in error.\n  // false=unlimited\n  statement_timeout: false\x2C\n\n  // Abort any statement that waits longer than the specified duration in milliseconds while attempting to acquire a lock.\n  // false=unlimited\n  lock_timeout: false\x2C\n\n  // Terminate any session with an open transaction that has been idle for longer than the specified duration in milliseconds\n  // false=unlimited\n  idle_in_transaction_session_timeout: false\x2C\n\n  // max milliseconds to wait for query to complete (client side)\n  query_timeout: false\x2C\n\n  connect_timeout: 0\x2C\n\n  keepalives: 1\x2C\n\n  keepalives_idle: 0\x2C\n}\n\nconst pgTypes = require('pg-types')\n// save default parsers\nconst parseBigInteger = pgTypes.getTypeParser(20\x2C 'text')\nconst parseBigIntegerArray = pgTypes.getTypeParser(1016\x2C 'text')\n\n// parse int8 so you can get your count values as actual numbers\nmodule.exports.__defineSetter__('parseInt8'\x2C function (val) {\n  pgTypes.setTypeParser(20\x2C 'text'\x2C val ? pgTypes.getTypeParser(23\x2C 'text') : parseBigInteger)\n  pgTypes.setTypeParser(1016\x2C 'text'\x2C val ? pgTypes.getTypeParser(1007\x2C 'text') : parseBigIntegerArray)\n})\n
