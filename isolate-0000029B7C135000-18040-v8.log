script-source,254,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/middleware/middleware-module.js,import { Logger } from '@nestjs/common';\nimport { InvalidMiddlewareException } from '../errors/exceptions/invalid-middleware.exception.js';\nimport { RuntimeException } from '../errors/exceptions/runtime.exception.js';\nimport { ContextIdFactory } from '../helpers/context-id-factory.js';\nimport { ExecutionContextHost } from '../helpers/execution-context-host.js';\nimport { STATIC_CONTEXT } from '../injector/constants.js';\nimport { REQUEST_CONTEXT_ID } from '../router/request/request-constants.js';\nimport { RouterExceptionFilters } from '../router/router-exception-filters.js';\nimport { RouterProxy } from '../router/router-proxy.js';\nimport { isRequestMethodAll } from '../router/utils/index.js';\nimport { MiddlewareBuilder } from './builder.js';\nimport { MiddlewareResolver } from './resolver.js';\nimport { RouteInfoPathExtractor } from './route-info-path-extractor.js';\nimport { RoutesMapper } from './routes-mapper.js';\nimport { RequestMethod } from '@nestjs/common';\nimport { isUndefined\x2C } from '@nestjs/common/internal';\nexport class MiddlewareModule {\n    routerProxy = new RouterProxy();\n    exceptionFiltersCache = new WeakMap();\n    logger = new Logger(MiddlewareModule.name);\n    injector;\n    routerExceptionFilter;\n    routesMapper;\n    resolver;\n    container;\n    httpAdapter;\n    graphInspector;\n    appOptions;\n    routeInfoPathExtractor;\n    async register(middlewareContainer\x2C container\x2C config\x2C injector\x2C httpAdapter\x2C graphInspector\x2C options) {\n        this.appOptions = options;\n        const appRef = container.getHttpAdapterRef();\n        this.routerExceptionFilter = new RouterExceptionFilters(container\x2C config\x2C appRef);\n        this.routesMapper = new RoutesMapper(container\x2C config);\n        this.resolver = new MiddlewareResolver(middlewareContainer\x2C injector);\n        this.routeInfoPathExtractor = new RouteInfoPathExtractor(config);\n        this.injector = injector;\n        this.container = container;\n        this.httpAdapter = httpAdapter;\n        this.graphInspector = graphInspector;\n        const modules = container.getModules();\n        await this.resolveMiddleware(middlewareContainer\x2C modules);\n    }\n    async resolveMiddleware(middlewareContainer\x2C modules) {\n        const moduleEntries = [...modules.entries()];\n        const loadMiddlewareConfiguration = async ([moduleName\x2C moduleRef]) => {\n            await this.loadConfiguration(middlewareContainer\x2C moduleRef\x2C moduleName);\n            await this.resolver.resolveInstances(moduleRef\x2C moduleName);\n        };\n        await Promise.all(moduleEntries.map(loadMiddlewareConfiguration));\n    }\n    async loadConfiguration(middlewareContainer\x2C moduleRef\x2C moduleKey) {\n        const { instance } = moduleRef;\n        if (!instance.configure) {\n            return;\n        }\n        const middlewareBuilder = new MiddlewareBuilder(this.routesMapper\x2C this.httpAdapter\x2C this.routeInfoPathExtractor);\n        try {\n            await instance.configure(middlewareBuilder);\n        }\n        catch (err) {\n            if (!this.appOptions.preview) {\n                throw err;\n            }\n            const warningMessage = `Warning! "${moduleRef.name}" module exposes a "configure" method that throws an exception in the preview mode` +\n                ` (possibly due to missing dependencies). Note: you can ignore this message\x2C just be aware that some of those conditional middlewares will not be reflected in your graph.`;\n            this.logger.warn(warningMessage);\n        }\n        if (!(middlewareBuilder instanceof MiddlewareBuilder)) {\n            return;\n        }\n        const config = middlewareBuilder.build();\n        middlewareContainer.insertConfig(config\x2C moduleKey);\n    }\n    async registerMiddleware(middlewareContainer\x2C applicationRef) {\n        const configs = middlewareContainer.getConfigurations();\n        const registerAllConfigs = async (moduleKey\x2C middlewareConfig) => {\n            for (const config of middlewareConfig) {\n                await this.registerMiddlewareConfig(middlewareContainer\x2C config\x2C moduleKey\x2C applicationRef);\n            }\n        };\n        const entriesSortedByDistance = [...configs.entries()].sort(([moduleA]\x2C [moduleB]) => {\n            const moduleARef = this.container.getModuleByKey(moduleA);\n            const moduleBRef = this.container.getModuleByKey(moduleB);\n            const isModuleAGlobal = moduleARef.distance === Number.MAX_VALUE;\n            const isModuleBGlobal = moduleBRef.distance === Number.MAX_VALUE;\n            if (isModuleAGlobal && isModuleBGlobal) {\n                return 0;\n            }\n            if (isModuleAGlobal) {\n                return -1;\n            }\n            if (isModuleBGlobal) {\n                return 1;\n            }\n            return moduleARef.distance - moduleBRef.distance;\n        });\n        for (const [moduleRef\x2C moduleConfigurations] of entriesSortedByDistance) {\n            await registerAllConfigs(moduleRef\x2C [...moduleConfigurations]);\n        }\n    }\n    async registerMiddlewareConfig(middlewareContainer\x2C config\x2C moduleKey\x2C applicationRef) {\n        const { forRoutes } = config;\n        for (const routeInfo of forRoutes) {\n            await this.registerRouteMiddleware(middlewareContainer\x2C routeInfo\x2C config\x2C moduleKey\x2C applicationRef);\n        }\n    }\n    async registerRouteMiddleware(middlewareContainer\x2C routeInfo\x2C config\x2C moduleKey\x2C applicationRef) {\n        const middlewareCollection = [].concat(config.middleware);\n        const moduleRef = this.container.getModuleByKey(moduleKey);\n        for (const metatype of middlewareCollection) {\n            const collection = middlewareContainer.getMiddlewareCollection(moduleKey);\n            const instanceWrapper = collection.get(metatype);\n            if (isUndefined(instanceWrapper)) {\n                throw new RuntimeException();\n            }\n            if (instanceWrapper.isTransient) {\n                return;\n            }\n            this.graphInspector.insertClassNode(moduleRef\x2C instanceWrapper\x2C 'middleware');\n            const middlewareDefinition = {\n                type: 'middleware'\x2C\n                methodName: 'use'\x2C\n                className: instanceWrapper.name\x2C\n                classNodeId: instanceWrapper.id\x2C\n                metadata: {\n                    key: routeInfo.path\x2C\n                    path: routeInfo.path\x2C\n                    requestMethod: RequestMethod[routeInfo.method] ??\n                        'ALL'\x2C\n                    version: routeInfo.version\x2C\n                }\x2C\n            };\n            this.graphInspector.insertEntrypointDefinition(middlewareDefinition\x2C instanceWrapper.id);\n            await this.bindHandler(instanceWrapper\x2C applicationRef\x2C routeInfo\x2C moduleRef\x2C collection);\n        }\n    }\n    async bindHandler(wrapper\x2C applicationRef\x2C routeInfo\x2C moduleRef\x2C collection) {\n        const { instance\x2C metatype } = wrapper;\n        if (isUndefined(instance?.use)) {\n            throw new InvalidMiddlewareException(metatype.name);\n        }\n        const isStatic = wrapper.isDependencyTreeStatic();\n        if (isStatic) {\n            const proxy = await this.createProxy(instance);\n            return this.registerHandler(applicationRef\x2C routeInfo\x2C proxy);\n        }\n        const isTreeDurable = wrapper.isDependencyTreeDurable();\n        await this.registerHandler(applicationRef\x2C routeInfo\x2C async (req\x2C res\x2C next) => {\n            try {\n                const contextId = this.getContextId(req\x2C isTreeDurable);\n                const contextInstance = await this.injector.loadPerContext(instance\x2C moduleRef\x2C collection\x2C contextId);\n                const proxy = await this.createProxy(contextInstance\x2C contextId);\n                return proxy(req\x2C res\x2C next);\n            }\n            catch (err) {\n                let exceptionsHandler = this.exceptionFiltersCache.get(instance.use);\n                if (!exceptionsHandler) {\n                    exceptionsHandler = this.routerExceptionFilter.create(instance\x2C instance.use\x2C undefined);\n                    this.exceptionFiltersCache.set(instance.use\x2C exceptionsHandler);\n                }\n                const host = new ExecutionContextHost([req\x2C res\x2C next]);\n                exceptionsHandler.next(err\x2C host);\n            }\n        });\n    }\n    async createProxy(instance\x2C contextId = STATIC_CONTEXT) {\n        const exceptionsHandler = this.routerExceptionFilter.create(instance\x2C instance.use\x2C undefined\x2C contextId);\n        const middleware = instance.use.bind(instance);\n        return this.routerProxy.createProxy(middleware\x2C exceptionsHandler);\n    }\n    async registerHandler(applicationRef\x2C routeInfo\x2C proxy) {\n        const { method } = routeInfo;\n        const paths = this.routeInfoPathExtractor.extractPathsFrom(routeInfo);\n        const isMethodAll = isRequestMethodAll(method);\n        const requestMethod = RequestMethod[method];\n        const router = await applicationRef.createMiddlewareFactory(method);\n        const middlewareFunction = isMethodAll\n            ? proxy\n            : (req\x2C res\x2C next) => {\n                const actualRequestMethod = applicationRef.getRequestMethod?.(req);\n                if (actualRequestMethod === requestMethod ||\n                    (actualRequestMethod === RequestMethod[RequestMethod.HEAD] &&\n                        requestMethod === RequestMethod[RequestMethod.GET])) {\n                    return proxy(req\x2C res\x2C next);\n                }\n                return next();\n            };\n        const pathsToApplyMiddleware = [];\n        paths.some(path => path.match(/^\\/?$/))\n            ? pathsToApplyMiddleware.push('/')\n            : pathsToApplyMiddleware.push(...paths);\n        pathsToApplyMiddleware.forEach(path => router(path\x2C middlewareFunction));\n    }\n    getContextId(request\x2C isTreeDurable) {\n        const contextId = ContextIdFactory.getByRequest(request);\n        if (!request[REQUEST_CONTEXT_ID]) {\n            Object.defineProperty(request\x2C REQUEST_CONTEXT_ID\x2C {\n                value: contextId\x2C\n                enumerable: false\x2C\n                writable: false\x2C\n                configurable: false\x2C\n            });\n            const requestProviderValue = isTreeDurable\n                ? contextId.payload\n                : Object.assign(request\x2C contextId.payload);\n            this.container.registerRequestProvider(requestProviderValue\x2C contextId);\n        }\n        return contextId;\n    }\n}\n
