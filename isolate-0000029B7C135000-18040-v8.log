code-creation,Script,9,1416546,0x1e04eefc570,157, file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/inspector/graph-inspector.js:1:1,0x26855885e28,~
script-source,245,file:///C:/Users/taisi/OneDrive/%D0%A0%D0%B0%D0%B1%D0%BE%D1%87%D0%B8%D0%B9%20%D1%81%D1%82%D0%BE%D0%BB/CraftWork/node_modules/@nestjs/core/inspector/graph-inspector.js,import { UnknownDependenciesException } from '../errors/exceptions/unknown-dependencies.exception.js';\nimport { DeterministicUuidRegistry } from './deterministic-uuid-registry.js';\nimport { PartialGraphHost } from './partial-graph.host.js';\nexport class GraphInspector {\n    container;\n    graph;\n    enhancersMetadataCache = new Array();\n    constructor(container) {\n        this.container = container;\n        this.graph = container.serializedGraph;\n    }\n    inspectModules(modules = this.container.getModules()) {\n        for (const moduleRef of modules.values()) {\n            this.insertModuleNode(moduleRef);\n            this.insertClassNodes(moduleRef);\n            this.insertModuleToModuleEdges(moduleRef);\n        }\n        this.enhancersMetadataCache.forEach(entry => this.insertEnhancerEdge(entry));\n        DeterministicUuidRegistry.clear();\n    }\n    registerPartial(error) {\n        this.graph.status = 'partial';\n        if (error instanceof UnknownDependenciesException) {\n            this.graph.metadata = {\n                cause: {\n                    type: 'unknown-dependencies'\x2C\n                    context: error.context\x2C\n                    moduleId: error.moduleRef?.id\x2C\n                    nodeId: error.metadata?.id\x2C\n                }\x2C\n            };\n        }\n        else {\n            this.graph.metadata = {\n                cause: {\n                    type: 'unknown'\x2C\n                    error\x2C\n                }\x2C\n            };\n        }\n        PartialGraphHost.register(this.graph);\n    }\n    inspectInstanceWrapper(source\x2C moduleRef) {\n        const ctorMetadata = source.getCtorMetadata();\n        ctorMetadata?.forEach((target\x2C index) => this.insertClassToClassEdge(source\x2C target\x2C moduleRef\x2C index\x2C 'constructor'));\n        const propertiesMetadata = source.getPropertiesMetadata();\n        propertiesMetadata?.forEach(({ key\x2C wrapper: target }) => this.insertClassToClassEdge(source\x2C target\x2C moduleRef\x2C key\x2C 'property'));\n    }\n    insertEnhancerMetadataCache(entry) {\n        this.enhancersMetadataCache.push(entry);\n    }\n    insertOrphanedEnhancer(entry) {\n        this.graph.insertOrphanedEnhancer({\n            ...entry\x2C\n            ref: entry.ref?.constructor?.name ?? 'Object'\x2C\n        });\n    }\n    insertAttachedEnhancer(wrapper) {\n        const existingNode = this.graph.getNodeById(wrapper.id);\n        existingNode.metadata.global = true;\n        this.graph.insertAttachedEnhancer(existingNode.id);\n    }\n    insertEntrypointDefinition(definition\x2C parentId) {\n        definition = {\n            ...definition\x2C\n            id: `${definition.classNodeId}_${definition.methodName}`\x2C\n        };\n        this.graph.insertEntrypoint(definition\x2C parentId);\n    }\n    insertClassNode(moduleRef\x2C wrapper\x2C type) {\n        this.graph.insertNode({\n            id: wrapper.id\x2C\n            label: wrapper.name\x2C\n            parent: moduleRef.id\x2C\n            metadata: {\n                type\x2C\n                internal: wrapper.metatype === moduleRef.metatype\x2C\n                sourceModuleName: moduleRef.name\x2C\n                durable: wrapper.isDependencyTreeDurable()\x2C\n                static: wrapper.isDependencyTreeStatic()\x2C\n                scope: wrapper.scope\x2C\n                transient: wrapper.isTransient\x2C\n                exported: moduleRef.exports.has(wrapper.token)\x2C\n                token: wrapper.token\x2C\n                subtype: wrapper.subtype\x2C\n                initTime: wrapper.initTime\x2C\n            }\x2C\n        });\n    }\n    insertModuleNode(moduleRef) {\n        const dynamicMetadata = this.container.getDynamicMetadataByToken(moduleRef.token);\n        const node = {\n            id: moduleRef.id\x2C\n            label: moduleRef.name\x2C\n            metadata: {\n                type: 'module'\x2C\n                global: moduleRef.isGlobal\x2C\n                dynamic: !!dynamicMetadata\x2C\n                internal: moduleRef.name === 'InternalCoreModule'\x2C\n            }\x2C\n        };\n        this.graph.insertNode(node);\n    }\n    insertModuleToModuleEdges(moduleRef) {\n        for (const targetModuleRef of moduleRef.imports) {\n            this.graph.insertEdge({\n                source: moduleRef.id\x2C\n                target: targetModuleRef.id\x2C\n                metadata: {\n                    type: 'module-to-module'\x2C\n                    sourceModuleName: moduleRef.name\x2C\n                    targetModuleName: targetModuleRef.name\x2C\n                }\x2C\n            });\n        }\n    }\n    insertEnhancerEdge(entry) {\n        const moduleRef = this.container.getModuleByKey(entry.moduleToken);\n        const sourceInstanceWrapper = moduleRef.controllers.get(entry.classRef) ??\n            moduleRef.providers.get(entry.classRef);\n        const existingSourceNode = this.graph.getNodeById(sourceInstanceWrapper.id);\n        const enhancers = existingSourceNode.metadata.enhancers ?? [];\n        if (entry.enhancerInstanceWrapper) {\n            this.insertClassToClassEdge(sourceInstanceWrapper\x2C entry.enhancerInstanceWrapper\x2C moduleRef\x2C undefined\x2C 'decorator');\n            enhancers.push({\n                id: entry.enhancerInstanceWrapper.id\x2C\n                methodKey: entry.methodKey\x2C\n                subtype: entry.subtype\x2C\n            });\n        }\n        else {\n            const name = entry.enhancerRef.constructor?.name ??\n                entry.enhancerRef.name;\n            enhancers.push({\n                name\x2C\n                methodKey: entry.methodKey\x2C\n                subtype: entry.subtype\x2C\n            });\n        }\n        existingSourceNode.metadata.enhancers = enhancers;\n    }\n    insertClassToClassEdge(source\x2C target\x2C moduleRef\x2C keyOrIndex\x2C injectionType) {\n        this.graph.insertEdge({\n            source: source.id\x2C\n            target: target.id\x2C\n            metadata: {\n                type: 'class-to-class'\x2C\n                sourceModuleName: moduleRef.name\x2C\n                sourceClassName: source.name\x2C\n                targetClassName: target.name\x2C\n                sourceClassToken: source.token\x2C\n                targetClassToken: target.token\x2C\n                targetModuleName: target.host?.name\x2C\n                keyOrIndex\x2C\n                injectionType\x2C\n            }\x2C\n        });\n    }\n    insertClassNodes(moduleRef) {\n        moduleRef.providers.forEach(value => this.insertClassNode(moduleRef\x2C value\x2C 'provider'));\n        moduleRef.injectables.forEach(value => this.insertClassNode(moduleRef\x2C value\x2C 'injectable'));\n        moduleRef.controllers.forEach(value => this.insertClassNode(moduleRef\x2C value\x2C 'controller'));\n    }\n}\n
