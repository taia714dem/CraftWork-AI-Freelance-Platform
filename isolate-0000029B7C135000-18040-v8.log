script-source,1854,node:internal/assert/myers_diff,'use strict';\x0d\n\x0d\nconst {\x0d\n  Array\x2C\x0d\n  ArrayPrototypeFill\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeSlice\x2C\x0d\n  StringPrototypeEndsWith\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst colors = require('internal/util/colors');\x0d\n\x0d\nconst kNopLinesToCollapse = 5;\x0d\n\x0d\nfunction areLinesEqual(actual\x2C expected\x2C checkCommaDisparity) {\x0d\n  if (actual === expected) {\x0d\n    return true;\x0d\n  }\x0d\n  if (checkCommaDisparity) {\x0d\n    return `${actual}\x2C` === expected || actual === `${expected}\x2C`;\x0d\n  }\x0d\n  return false;\x0d\n}\x0d\n\x0d\nfunction myersDiff(actual\x2C expected\x2C checkCommaDisparity = false) {\x0d\n  const actualLength = actual.length;\x0d\n  const expectedLength = expected.length;\x0d\n  const max = actualLength + expectedLength;\x0d\n  const v = ArrayPrototypeFill(Array(2 * max + 1)\x2C 0);\x0d\n\x0d\n  const trace = [];\x0d\n\x0d\n  for (let diffLevel = 0; diffLevel <= max; diffLevel++) {\x0d\n    const newTrace = ArrayPrototypeSlice(v);\x0d\n    ArrayPrototypePush(trace\x2C newTrace);\x0d\n\x0d\n    for (let diagonalIndex = -diffLevel; diagonalIndex <= diffLevel; diagonalIndex += 2) {\x0d\n      let x;\x0d\n      if (diagonalIndex === -diffLevel ||\x0d\n        (diagonalIndex !== diffLevel && v[diagonalIndex - 1 + max] < v[diagonalIndex + 1 + max])) {\x0d\n        x = v[diagonalIndex + 1 + max];\x0d\n      } else {\x0d\n        x = v[diagonalIndex - 1 + max] + 1;\x0d\n      }\x0d\n\x0d\n      let y = x - diagonalIndex;\x0d\n\x0d\n      while (x < actualLength && y < expectedLength && areLinesEqual(actual[x]\x2C expected[y]\x2C checkCommaDisparity)) {\x0d\n        x++;\x0d\n        y++;\x0d\n      }\x0d\n\x0d\n      v[diagonalIndex + max] = x;\x0d\n\x0d\n      if (x >= actualLength && y >= expectedLength) {\x0d\n        return backtrack(trace\x2C actual\x2C expected\x2C checkCommaDisparity);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction backtrack(trace\x2C actual\x2C expected\x2C checkCommaDisparity) {\x0d\n  const actualLength = actual.length;\x0d\n  const expectedLength = expected.length;\x0d\n  const max = actualLength + expectedLength;\x0d\n\x0d\n  let x = actualLength;\x0d\n  let y = expectedLength;\x0d\n  const result = [];\x0d\n\x0d\n  for (let diffLevel = trace.length - 1; diffLevel >= 0; diffLevel--) {\x0d\n    const v = trace[diffLevel];\x0d\n    const diagonalIndex = x - y;\x0d\n    let prevDiagonalIndex;\x0d\n\x0d\n    if (diagonalIndex === -diffLevel ||\x0d\n      (diagonalIndex !== diffLevel && v[diagonalIndex - 1 + max] < v[diagonalIndex + 1 + max])) {\x0d\n      prevDiagonalIndex = diagonalIndex + 1;\x0d\n    } else {\x0d\n      prevDiagonalIndex = diagonalIndex - 1;\x0d\n    }\x0d\n\x0d\n    const prevX = v[prevDiagonalIndex + max];\x0d\n    const prevY = prevX - prevDiagonalIndex;\x0d\n\x0d\n    while (x > prevX && y > prevY) {\x0d\n      const value = !checkCommaDisparity ||\x0d\n        StringPrototypeEndsWith(actual[x - 1]\x2C '\x2C') ? actual[x - 1] : expected[y - 1];\x0d\n      ArrayPrototypePush(result\x2C { __proto__: null\x2C type: 'nop'\x2C value });\x0d\n      x--;\x0d\n      y--;\x0d\n    }\x0d\n\x0d\n    if (diffLevel > 0) {\x0d\n      if (x > prevX) {\x0d\n        ArrayPrototypePush(result\x2C { __proto__: null\x2C type: 'insert'\x2C value: actual[x - 1] });\x0d\n        x--;\x0d\n      } else {\x0d\n        ArrayPrototypePush(result\x2C { __proto__: null\x2C type: 'delete'\x2C value: expected[y - 1] });\x0d\n        y--;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\nfunction printSimpleMyersDiff(diff) {\x0d\n  let message = '';\x0d\n\x0d\n  for (let diffIdx = diff.length - 1; diffIdx >= 0; diffIdx--) {\x0d\n    const { type\x2C value } = diff[diffIdx];\x0d\n    if (type === 'insert') {\x0d\n      message += `${colors.green}${value}${colors.white}`;\x0d\n    } else if (type === 'delete') {\x0d\n      message += `${colors.red}${value}${colors.white}`;\x0d\n    } else {\x0d\n      message += `${colors.white}${value}${colors.white}`;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return `\\n${message}`;\x0d\n}\x0d\n\x0d\nfunction printMyersDiff(diff\x2C simple = false) {\x0d\n  let message = '';\x0d\n  let skipped = false;\x0d\n  let nopCount = 0;\x0d\n\x0d\n  for (let diffIdx = diff.length - 1; diffIdx >= 0; diffIdx--) {\x0d\n    const { type\x2C value } = diff[diffIdx];\x0d\n    const previousType = (diffIdx < (diff.length - 1)) ? diff[diffIdx + 1].type : null;\x0d\n    const typeChanged = previousType && (type !== previousType);\x0d\n\x0d\n    if (typeChanged && previousType === 'nop') {\x0d\n      // Avoid grouping if only one line would have been grouped otherwise\x0d\n      if (nopCount === kNopLinesToCollapse + 1) {\x0d\n        message += `${colors.white}  ${diff[diffIdx + 1].value}\\n`;\x0d\n      } else if (nopCount === kNopLinesToCollapse + 2) {\x0d\n        message += `${colors.white}  ${diff[diffIdx + 2].value}\\n`;\x0d\n        message += `${colors.white}  ${diff[diffIdx + 1].value}\\n`;\x0d\n      } if (nopCount >= (kNopLinesToCollapse + 3)) {\x0d\n        message += `${colors.blue}...${colors.white}\\n`;\x0d\n        message += `${colors.white}  ${diff[diffIdx + 1].value}\\n`;\x0d\n        skipped = true;\x0d\n      }\x0d\n      nopCount = 0;\x0d\n    }\x0d\n\x0d\n    if (type === 'insert') {\x0d\n      message += `${colors.green}+${colors.white} ${value}\\n`;\x0d\n    } else if (type === 'delete') {\x0d\n      message += `${colors.red}-${colors.white} ${value}\\n`;\x0d\n    } else if (type === 'nop') {\x0d\n      if (nopCount < kNopLinesToCollapse) {\x0d\n        message += `${colors.white}  ${value}\\n`;\x0d\n      }\x0d\n      nopCount++;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  message = message.trimEnd();\x0d\n\x0d\n  return { message: `\\n${message}`\x2C skipped };\x0d\n}\x0d\n\x0d\nmodule.exports = { myersDiff\x2C printMyersDiff\x2C printSimpleMyersDiff };\x0d\n
