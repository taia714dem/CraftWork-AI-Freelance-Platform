sPrototypeOf\x2C\x0d\n  ObjectPrototypeToString\x2C\x0d\n  ReflectApply\x2C\x0d\n  ReflectHas\x2C\x0d\n  ReflectOwnKeys\x2C\x0d\n  RegExpPrototypeExec\x2C\x0d\n  SafeArrayIterator\x2C\x0d\n  SafeMap\x2C\x0d\n  SafeSet\x2C\x0d\n  SafeWeakSet\x2C\x0d\n  SetPrototypeGetSize\x2C\x0d\n  String\x2C\x0d\n  StringPrototypeIndexOf\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeSplit\x2C\x0d\n  SymbolIterator\x2C\x0d\n  TypedArrayPrototypeGetLength\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_AMBIGUOUS_ARGUMENT\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_RETURN_VALUE\x2C\x0d\n    ERR_MISSING_ARGS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst AssertionError = require('internal/assert/assertion_error');\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst {\x0d\n  isArrayBuffer\x2C\x0d\n  isDataView\x2C\x0d\n  isKeyObject\x2C\x0d\n  isPromise\x2C\x0d\n  isRegExp\x2C\x0d\n  isMap\x2C\x0d\n  isSet\x2C\x0d\n  isDate\x2C\x0d\n  isWeakSet\x2C\x0d\n  isWeakMap\x2C\x0d\n  isSharedArrayBuffer\x2C\x0d\n  isAnyArrayBuffer\x2C\x0d\n} = require('internal/util/types');\x0d\nconst { isError\x2C deprecate\x2C emitExperimentalWarning } = require('internal/util');\x0d\nconst { innerOk } = require('internal/assert/utils');\x0d\n\x0d\nconst CallTracker = require('internal/assert/calltracker');\x0d\nconst {\x0d\n  validateFunction\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nlet isDeepEqual;\x0d\nlet isDeepStrictEqual;\x0d\n\x0d\nfunction lazyLoadComparison() {\x0d\n  const comparison = require('internal/util/comparisons');\x0d\n  isDeepEqual = comparison.isDeepEqual;\x0d\n  isDeepStrictEqual = comparison.isDeepStrictEqual;\x0d\n}\x0d\n\x0d\nlet warned = false;\x0d\n\x0d\n// The assert module provides functions that throw\x0d\n// AssertionError's when particular conditions are not met. The\x0d\n// assert module must conform to the following interface.\x0d\n\x0d\nconst assert = module.exports = ok;\x0d\n\x0d\nconst NO_EXCEPTION_SENTINEL = {};\x0d\n\x0d\n// All of the following functions must throw an AssertionError\x0d\n// when a corresponding condition is not met\x2C with a message that\x0d\n// may be undefined if not provided. All assertion methods provide\x0d\n// both the actual and expected values to the assertion error for\x0d\n// display purposes.\x0d\n\x0d\nfunction innerFail(obj) {\x0d\n  if (obj.message instanceof Error) throw obj.message;\x0d\n\x0d\n  throw new AssertionError(obj);\x0d\n}\x0d\n\x0d\n/**\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @param {string} [operator]\x0d\n * @param {Function} [stackStartFn]\x0d\n */\x0d\nfunction fail(actual\x2C expected\x2C message\x2C operator\x2C stackStartFn) {\x0d\n  const argsLen = arguments.length;\x0d\n\x0d\n  let internalMessage = false;\x0d\n  if (actual == null && argsLen <= 1) {\x0d\n    internalMessage = true;\x0d\n    message = 'Failed';\x0d\n  } else if (argsLen === 1) {\x0d\n    message = actual;\x0d\n    actual = undefined;\x0d\n  } else {\x0d\n    if (warned === false) {\x0d\n      warned = true;\x0d\n      process.emitWarning(\x0d\n        'assert.fail() with more than one argument is deprecated. ' +\x0d\n          'Please use assert.strictEqual() instead or only pass a message.'\x2C\x0d\n        'DeprecationWarning'\x2C\x0d\n        'DEP0094'\x2C\x0d\n      );\x0d\n    }\x0d\n    if (argsLen === 2)\x0d\n      operator = '!=';\x0d\n  }\x0d\n\x0d\n  if (message instanceof Error) throw message;\x0d\n\x0d\n  const errArgs = {\x0d\n    actual\x2C\x0d\n    expected\x2C\x0d\n    operator: operator === undefined ? 'fail' : operator\x2C\x0d\n    stackStartFn: stackStartFn || fail\x2C\x0d\n    message\x2C\x0d\n  };\x0d\n  const err = new AssertionError(errArgs);\x0d\n  if (internalMessage) {\x0d\n    err.generatedMessage = true;\x0d\n  }\x0d\n  throw err;\x0d\n}\x0d\n\x0d\nassert.fail = fail;\x0d\n\x0d\n// The AssertionError is defined in internal/error.\x0d\nassert.AssertionError = AssertionError;\x0d\n\x0d\n/**\x0d\n * Pure assertion tests whether a value is truthy\x2C as determined\x0d\n * by !!value.\x0d\n * @param {...any} args\x0d\n * @returns {void}\x0d\n */\x0d\nfunction ok(...args) {\x0d\n  innerOk(ok\x2C args.length\x2C ...args);\x0d\n}\x0d\nassert.ok = ok;\x0d\n\x0d\n/**\x0d\n * The equality assertion tests shallow\x2C coercive equality with ==.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\n/* eslint-disable no-restricted-properties */\x0d\nassert.equal = function equal(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  // eslint-disable-next-line eqeqeq\x0d\n  if (actual != expected && (!NumberIsNaN(actual) || !NumberIsNaN(expected))) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: '=='\x2C\x0d\n      stackStartFn: equal\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The non-equality assertion tests for whether two objects are not\x0d\n * equal with !=.\x0d\n * @param {any} actual\x0d\n * @param {any} expected\x0d\n * @param {string | Error} [message]\x0d\n * @returns {void}\x0d\n */\x0d\nassert.notEqual = function notEqual(actual\x2C expected\x2C message) {\x0d\n  if (arguments.length < 2) {\x0d\n    throw new ERR_MISSING_ARGS('actual'\x2C 'expected');\x0d\n  }\x0d\n  // eslint-disable-next-line eqeqeq\x0d\n  if (actual == expected || (NumberIsNaN(actual) && NumberIsNaN(expected))) {\x0d\n    innerFail({\x0d\n      actual\x2C\x0d\n      expected\x2C\x0d\n      message\x2C\x0d\n      operator: '!='\x2C\x0d\n      stackStartFn: notEqual\x2C\x0d\n    });\x0d\n  }\x0d\n};\x0d\n\x0d\n/**\x0d\n * The deep equivalence assertion tests a