script-source,2285,C:\\Users\\taisi\\OneDrive\\\u0420\u0430\u0431\u043e\u0447\u0438\u0439 \u0441\u0442\u043e\u043b\\CraftWork\\node_modules\\debug\\src\\common.js,\n/**\n * This is the common logic for both the Node.js and web browser\n * implementations of `debug()`.\n */\n\nfunction setup(env) {\n\x09createDebug.debug = createDebug;\n\x09createDebug.default = createDebug;\n\x09createDebug.coerce = coerce;\n\x09createDebug.disable = disable;\n\x09createDebug.enable = enable;\n\x09createDebug.enabled = enabled;\n\x09createDebug.humanize = require('ms');\n\x09createDebug.destroy = destroy;\n\n\x09Object.keys(env).forEach(key => {\n\x09\x09createDebug[key] = env[key];\n\x09});\n\n\x09/**\n\x09* The currently active debug mode names\x2C and names to skip.\n\x09*/\n\n\x09createDebug.names = [];\n\x09createDebug.skips = [];\n\n\x09/**\n\x09* Map of special "%n" handling functions\x2C for the debug "format" argument.\n\x09*\n\x09* Valid key names are a single\x2C lower or upper-case letter\x2C i.e. "n" and "N".\n\x09*/\n\x09createDebug.formatters = {};\n\n\x09/**\n\x09* Selects a color for a debug namespace\n\x09* @param {String} namespace The namespace string for the debug instance to be colored\n\x09* @return {Number|String} An ANSI color code for the given namespace\n\x09* @api private\n\x09*/\n\x09function selectColor(namespace) {\n\x09\x09let hash = 0;\n\n\x09\x09for (let i = 0; i < namespace.length; i++) {\n\x09\x09\x09hash = ((hash << 5) - hash) + namespace.charCodeAt(i);\n\x09\x09\x09hash |= 0; // Convert to 32bit integer\n\x09\x09}\n\n\x09\x09return createDebug.colors[Math.abs(hash) % createDebug.colors.length];\n\x09}\n\x09createDebug.selectColor = selectColor;\n\n\x09/**\n\x09* Create a debugger with the given `namespace`.\n\x09*\n\x09* @param {String} namespace\n\x09* @return {Function}\n\x09* @api public\n\x09*/\n\x09function createDebug(namespace) {\n\x09\x09let prevTime;\n\x09\x09let enableOverride = null;\n\x09\x09let namespacesCache;\n\x09\x09let enabledCache;\n\n\x09\x09function debug(...args) {\n\x09\x09\x09// Disabled?\n\x09\x09\x09if (!debug.enabled) {\n\x09\x09\x09\x09return;\n\x09\x09\x09}\n\n\x09\x09\x09const self = debug;\n\n\x09\x09\x09// Set `diff` timestamp\n\x09\x09\x09const curr = Number(new Date());\n\x09\x09\x09const ms = curr - (prevTime || curr);\n\x09\x09\x09self.diff = ms;\n\x09\x09\x09self.prev = prevTime;\n\x09\x09\x09self.curr = curr;\n\x09\x09\x09prevTime = curr;\n\n\x09\x09\x09args[0] = createDebug.coerce(args[0]);\n\n\x09\x09\x09if (typeof args[0] !== 'string') {\n\x09\x09\x09\x09// Anything else let's inspect with %O\n\x09\x09\x09\x09args.unshift('%O');\n\x09\x09\x09}\n\n\x09\x09\x09// Apply any `formatters` transformations\n\x09\x09\x09let index = 0;\n\x09\x09\x09args[0] = args[0].replace(/%([a-zA-Z%])/g\x2C (match\x2C format) => {\n\x09\x09\x09\x09// If we encounter an escaped % then don't increase the array index\n\x09\x09\x09\x09if (match === '%%') {\n\x09\x09\x09\x09\x09return '%';\n\x09\x09\x09\x09}\n\x09\x09\x09\x09index++;\n\x09\x09\x09\x09const formatter = createDebug.formatters[format];\n\x09\x09\x09\x09if (typeof formatter === 'function') {\n\x09\x09\x09\x09\x09const val = args[index];\n\x09\x09\x09\x09\x09match = formatter.call(self\x2C val);\n\n\x09\x09\x09\x09\x09// Now we need to remove `args[index]` since it's inlined in the `format`\n\x09\x09\x09\x09\x09args.splice(index\x2C 1);\n\x09\x09\x09\x09\x09index--;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09return match;\n\x09\x09\x09});\n\n\x09\x09\x09// Apply env-specific formatting (colors\x2C etc.)\n\x09\x09\x09createDebug.formatArgs.call(self\x2C args);\n\n\x09\x09\x09const logFn = self.log || createDebug.log;\n\x09\x09\x09logFn.apply(self\x2C args);\n\x09\x09}\n\n\x09\x09debug.namespace = namespace;\n\x09\x09debug.useColors = createDebug.useColors();\n\x09\x09debug.color = createDebug.selectColor(namespace);\n\x09\x09debug.extend = extend;\n\x09\x09debug.destroy = createDebug.destroy; // XXX Temporary. Will be removed in the next major release.\n\n\x09\x09Object.defineProperty(debug\x2C 'enabled'\x2C {\n\x09\x09\x09enumerable: true\x2C\n\x09\x09\x09configurable: false\x2C\n\x09\x09\x09get: () => {\n\x09\x09\x09\x09if (enableOverride !== null) {\n\x09\x09\x09\x09\x09return enableOverride;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09if (namespacesCache !== createDebug.namespaces) {\n\x09\x09\x09\x09\x09namespacesCache = createDebug.namespaces;\n\x09\x09\x09\x09\x09enabledCache = createDebug.enabled(namespace);\n\x09\x09\x09\x09}\n\n\x09\x09\x09\x09return enabledCache;\n\x09\x09\x09}\x2C\n\x09\x09\x09set: v => {\n\x09\x09\x09\x09enableOverride = v;\n\x09\x09\x09}\n\x09\x09});\n\n\x09\x09// Env-specific initialization logic for debug instances\n\x09\x09if (typeof createDebug.init === 'function') {\n\x09\x09\x09createDebug.init(debug);\n\x09\x09}\n\n\x09\x09return debug;\n\x09}\n\n\x09function extend(namespace\x2C delimiter) {\n\x09\x09const newDebug = createDebug(this.namespace + (typeof delimiter === 'undefined' ? ':' : delimiter) + namespace);\n\x09\x09newDebug.log = this.log;\n\x09\x09return newDebug;\n\x09}\n\n\x09/**\n\x09* Enables a debug mode by namespaces. This can include modes\n\x09* separated by a colon and wildcards.\n\x09*\n\x09* @param {String} namespaces\n\x09* @api public\n\x09*/\n\x09function enable(namespaces) {\n\x09\x09createDebug.save(namespaces);\n\x09\x09createDebug.namespaces = namespaces;\n\n\x09\x09createDebug.names = [];\n\x09\x09createDebug.skips = [];\n\n\x09\x09const split = (typeof namespaces === 'string' ? namespaces : '')\n\x09\x09\x09.trim()\n\x09\x09\x09.replace(/\\s+/g\x2C '\x2C')\n\x09\x09\x09.split('\x2C')\n\x09\x09\x09.filter(Boolean);\n\n\x09\x09for (const ns of split) {\n\x09\x09\x09if (ns[0] === '-') {\n\x09\x09\x09\x09createDebug.skips.push(ns.slice(1));\n\x09\x09\x09} else {\n\x09\x09\x09\x09createDebug.names.push(ns);\n\x09\x09\x09}\n\x09\x09}\n\x09}\n\n\x09/**\n\x09 * Checks if the given string matches a namespace template\x2C honoring\n\x09 * asterisks as wildcards.\n\x09 *\n\x09 * @param {String} search\n\x09 * @param {String} template\n\x09 * @return {Boolean}\n\x09 */\n\x09function matchesTemplate(search\x2C template) {\n\x09\x09let searchIndex = 0;\n\x09\x09let templateIndex = 0;\n\x09\x09let starIndex = -1;\n\x09\x09let matchIndex = 0;\n\n\x09\x09while (searchIndex < search.length) {\n\x09\x09\x09if (templateIndex < template.length && (template[templateIndex] === search[searchIndex] || template[templateIndex] === '*')) {\n\x09\x09\x09\x09// Match character or proceed with wildcard\n\x09\x09\x09\x09if (template[templateIndex] === '*') {\n\x09\x09\x09\x09\x09starIndex = templateIndex;\n\x09\x09\x09\x09\x09matchIndex = searchIndex;\n\x09\x09\x09\x09\x09templateIndex++; // Skip the '*'\n\x09\x09\x09\x09} else {\n\x09\x09\x09\x09\x09searchIndex++;\n\x09\x09\x09\x09\x09templateIndex++;\n\x09\x09\x09\x09}\n\x09\x09\x09} else if (starIndex !== -1) { // eslint-disable-line no-negated-condition\n\x09\x09\x09\x09// Backtrack to the last '*' and try to match more characters\n\x09\x09\x09\x09templateIndex = starIndex + 1;\n\x09\x09\x09\x09matchIndex++;\n\x09\x09\x09\x09searchIndex = matchIndex;\n\x09\x09\x09} else {\n\x09\x09\x09\x09return false; // No match\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09// Handle trailing '*' in template\n\x09\x09while (templateIndex < template.length && template[templateIndex] === '*') {\n\x09\x09\x09templateIndex++;\n\x09\x09}\n\n\x09\x09return templateIndex === template.length;\n\x09}\n\n\x09/**\n\x09* Disable debug output.\n\x09*\n\x09* @return {String} namespaces\n\x09* @api public\n\x09*/\n\x09function disable() {\n\x09\x09const namespaces = [\n\x09\x09\x09...createDebug.names\x2C\n\x09\x09\x09...createDebug.skips.map(namespace => '-' + namespace)\n\x09\x09].join('\x2C');\n\x09\x09createDebug.enable('');\n\x09\x09return namespaces;\n\x09}\n\n\x09/**\n\x09* Returns true if the given mode name is enabled\x2C false otherwise.\n\x09*\n\x09* @param {String} name\n\x09* @return {Boolean}\n\x09* @api public\n\x09*/\n\x09function enabled(name) {\n\x09\x09for (const skip of createDebug.skips) {\n\x09\x09\x09if (matchesTemplate(name\x2C skip)) {\n\x09\x09\x09\x09return false;\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09for (const ns of createDebug.names) {\n\x09\x09\x09if (matchesTemplate(name\x2C ns)) {\n\x09\x09\x09\x09return true;\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09return false;\n\x09}\n\n\x09/**\n\x09* Coerce `val`.\n\x09*\n\x09* @param {Mixed} val\n\x09* @return {Mixed}\n\x09* @api private\n\x09*/\n\x09function coerce(val) {\n\x09\x09if (val instanceof Error) {\n\x09\x09\x09return val.stack || val.message;\n\x09\x09}\n\x09\x09return val;\n\x09}\n\n\x09/**\n\x09* XXX DO NOT USE. This is a temporary stub function.\n\x09* XXX It WILL be removed in the next major release.\n\x09*/\n\x09function destroy() {\n\x09\x09console.warn('Instance method `debug.destroy()` is deprecated and no longer does anything. It will be removed in the next major version of `debug`.');\n\x09}\n\n\x09createDebug.enable(createDebug.load());\n\n\x09return createDebug;\n}\n\nmodule.exports = setup;\n
